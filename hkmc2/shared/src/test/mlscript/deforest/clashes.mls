fun f1(a1) = if a1 is A(x1) then x1
fun f2(a2) = if a2 is A(x2) then x2 + 1
fun p(x, clashedCtor) =
  if true then A(x)
  else clashedCtor
let clashed = A(3)
f1(p(1, clashed)) + f2(p(2, clashed))
