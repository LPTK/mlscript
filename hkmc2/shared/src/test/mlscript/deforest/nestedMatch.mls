// this misalign prevents fusion (consumer destructures 2 elements per step, producer emits 1)
:deforest
:expect 10
fun prod(x) = if x is
  0 then Nil
  n then n :: prod(n - 1)
fun cons(ls) = if ls is
  h1 :: h2 :: t then h1 + h2 + cons(t)
  _ then 0
cons(prod(4))
