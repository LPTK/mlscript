:expect Cons(1, Cons(2, Cons(3, Cons(4, Cons(5, Cons(6, Nil))))))
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then idList(ys)
fun concat(lss) = if lss is
  hh :: tt then append(hh, concat(tt))
  Nil then Nil
concat of id of
  (1 :: 2 :: Nil) ::
  (3 :: 4 :: Nil) ::
  (5 :: 6 :: Nil) :: Nil
