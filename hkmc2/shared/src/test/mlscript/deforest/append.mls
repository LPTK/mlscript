fun idList(l) = if l is
  h :: t then h :: idList(t)
  Nil then Nil
fun append(xs, ys) = if xs is
  h :: t then h :: append(t, ys)
  Nil then idList(ys)
fun appendThree(xs, ys, zs) =
  append(append(xs, ys), zs)
appendThree of
  id(1 :: 2 :: Nil)
  id(3 :: 4 :: Nil)
  id(5 :: 6 :: Nil)
