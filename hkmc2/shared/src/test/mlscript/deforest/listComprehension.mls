  h1 :: t1 then lscomp2(ls2, h1, t1)
  Nil then Nil
fun lscomp2(ls2, h1, t1) = if ls2 is
  h2 :: t2 then Pair(h1, h2) :: lscomp2(t2, h1, t1)
  Nil then lscomp1(t1, ls2)
