  h :: t then h + f1(t)
  Nil then 2
fun f2(ls2) = if ls2 is
  h :: t then h + f2(t)
  Nil then 3
fun f3(ls3) = if ls3 is
  h :: t then h + f3(t)
  Nil then 4
fun f4(ls4) = if ls4 is
  h :: t then h + f4(t)
  Nil then 5
