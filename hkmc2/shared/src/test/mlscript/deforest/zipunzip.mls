fun zip(xs_zip, ys_zip) = if
  xs_zip is x :: xt and ys_zip is y :: yt then Pair(x, y) :: zip(xt, yt)
  else Nil
fun unzip(ls_unzip) = if ls_unzip is
  Pair(a, b) :: t and unzip(t) is Pair(atail, btail) then Pair(a :: atail, b :: btail)
  Nil then Pair(Nil, Nil)
fun map(f, ls_map) = if ls_map is
  h :: t then f(h) :: map(f, t)
  Nil then Nil
fun makeZippedList(n) = if n > 0 then Cons(Pair(n, n + 1), makeZippedList(n - 1)) else Nil
fun testZipMapBothUnzip(n) = if unzip(id(makeZippedList(n))) is
  Pair(xs, ys) then zip(
    map(x => x + 1, xs),
    map(x => x * x, ys)
  )
testZipMapBothUnzip(4)
