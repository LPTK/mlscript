// we don't actually want to fuse it, because the logic of
// the creation of the list may be expensive
:deforest
:expect 12
fun enumFrom(a) =
  if a > 0 then expensive(a) :: enumFrom(a - 1)
  else Nil
fun sum(x) = if x is
  h :: t then h + sum(t)
  Nil then 0
fun consume(f, ls) = f(ls) + f(ls)
consume(sum, enumFrom(3))
