:js


data class (::) Cons(h, t)
data object Nil



data class Many(x)
data class Once(x)

fun expensive(x) = x



// we don't want to fuse `p = enumFrom(3)`,
// because the `expensive` computation would be duplicated
// btw, should `p` be considered as being in the correct position here?
:deforest
fun sum(x) = if x is
  h :: t then h + sum(t)
  Nil then 0
fun enumFrom(a) =
  if a > 0 then expensive(a) :: enumFrom(a - 1)
  else Nil
fun main() =
  let p = enumFrom(3)
  let f = () => sum(p)
  f() + f()
