//│ deforest > 	Ref(x,None)
//│ deforest > 	Select(Ref(x,None),Ident(h))
//│ deforest > 	Select(Ref(x,None),Ident(t))
//│ deforest > Ref(member:Nil,Some(object:Nil)) ->
//│ deforest > 	Ref(x,None)
//│ deforest > <<< fusing <<<



// `Many` cannot be fused because:
// - it's not one-shot
// - it has a clash
:deforest
:expect 13
fun consumer(f, g, p) = f(p) + g(p)
consumer of
  case Many(_) then 3
  case Many(Once(v)) then v
  Many(Once(10))
