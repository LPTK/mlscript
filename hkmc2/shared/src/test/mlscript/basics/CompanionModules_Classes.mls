mut val state = 10
//│ state = 10

// * The order of evaluation of modules matters;
// * they should not be moved to their companion classes (the opposite should happen)
:sjs
class Foo() with // the class definition is moved to the location of its companion
  fun foo = state
set state += 1
module Foo with
  print(Foo().foo)
