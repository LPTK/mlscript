:js


class C(val x)

let c = C(1)
//│ c = C(1)

:re
set c.x = 2
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'x' of object '[object Object]'

c
//│ = C(1)


class Foo(val x)(val y)

let f = Foo(1)(2)
//│ f = Foo(1)

f.y
//│ = 2

:re
set f.y = 3
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'y' of object '[object Object]'

f.y
//│ = 2


class Foo with
  fun foo() = 1
  fun bar = 2


let f = new mut Foo
//│ f = Foo

set f.foo = () => 3
f.foo()
//│ = 3

:re
set f.bar = 3
//│ ═══[RUNTIME ERROR] TypeError: Cannot set property bar of [object Object] which has only a getter

f.bar
//│ = 2


let f = new Foo
//│ f = Foo

:re
set f.foo = () => 3
//│ ═══[RUNTIME ERROR] TypeError: Cannot add property foo, object is not extensible

f.foo()
//│ = 1

:re
set f.bar = 3
//│ ═══[RUNTIME ERROR] TypeError: Cannot set property bar of [object Object] which has only a getter

f.bar
//│ = 2


// * TODO: later, we might want to distinguish freezing from sealing;
// * `new` would freeze and `new mut` would solely seal; `new open` would do neither.

