:.
:js

let x = 1
let y = 2
let z = 3
//│ x = 1
//│ y = 2
//│ z = 3

// A throwing body restores the whole group.
:sjs
:soir
:re
set { x = 10, y = 20, z = 30 } in throw 42
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let savedCount, old, old1, scrut, old2, scrut1;
//│ set old = x⁰;
//│ set savedCount = 1;
//│ try
//│   set x⁰ = 10;
//│   set old1 = y⁰;
//│   set savedCount = 2;
//│   set y⁰ = 20;
//│   set old2 = z⁰;
//│   set savedCount = 3;
//│   set z⁰ = 30;
//│   throw 42
//│ finally
//│   set scrut1 = >=⁰(savedCount, 3);
//│   match scrut1
//│     true =>
//│       set z⁰ = old2;
//│       end
//│   set scrut = >=⁰(savedCount, 2);
//│   match scrut
//│     true =>
//│       set y⁰ = old1;
//│       end
//│   set x⁰ = old;
//│   end;
//│   return undefined
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let savedCount, old, old1, scrut, old2, scrut1;
//│ old = x;
//│ savedCount = 1;
//│ try {
//│   x = 10;
//│   old1 = y;
//│   savedCount = 2;
//│   y = 20;
//│   old2 = z;
//│   savedCount = 3;
//│   z = 30;
//│   throw 42
//│ } finally {
//│   scrut1 = savedCount >= 3;
//│   if (scrut1 === true) {
//│     z = old2;
//│   }
//│   scrut = savedCount >= 2;
//│   if (scrut === true) { y = old1; }
//│   x = old;
//│ }
//│ return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] 42

:expect [1, 2, 3]
[x, y, z]
//│ = [1, 2, 3]

// A throwing initializer restores earlier writes and skips unvisited bindings.
:re
set
  x = 10
  y = throw 42
  z = 30
in 0
//│ ═══[RUNTIME ERROR] 42

:expect [1, 2, 3]
[x, y, z]
//│ = [1, 2, 3]

// Activate the backup before evaluating the RHS, which can itself mutate the target.
:re
set
  x = 10
  y =
    set y = 99
    throw 42
  z = 30
in 0
//│ ═══[RUNTIME ERROR] 42

:expect [1, 2, 3]
[x, y, z]
//│ = [1, 2, 3]

// The first initializer is protected too.
:re
set
  x =
    set x = 99
    throw 42
  y = 20
in 0
//│ ═══[RUNTIME ERROR] 42

:expect [1, 2, 3]
[x, y, z]
//│ = [1, 2, 3]

// Repeated targets unwind in reverse order even when a later RHS throws.
:re
set { x += 3, x *= 2, y = throw 42 } in 0
//│ ═══[RUNTIME ERROR] 42

:expect [1, 2, 3]
[x, y, z]
//│ = [1, 2, 3]

// Returning from the body also runs cleanup.
fun earlyReturn() =
  set { x = 10, y = x + 1 } in return x + y
  0

:expect [21, 1, 2]
[earlyReturn(), x, y]
//│ = [21, 1, 2]

// A failure while saving a later target still restores earlier assignments.
let xs = mut [7]
//│ xs = [7]

:re
set { x = 10, xs.[throw 43] = 8 } in 0
//│ ═══[RUNTIME ERROR] 43

:expect [1, [7]]
[x, xs]
//│ = [1, [7]]

// A throwing host setter must not prevent restoration of earlier targets.
val box: dyn = Object.defineProperty(mut {}, "value", (
  "get": () => 4,
  "set": (v) => if v is 4 then throw 44 else ()
))
//│ box = {}

:re
set { x = 10, y = 20, box.value = 30 } in 0
//│ ═══[RUNTIME ERROR] 44

:expect [1, 2]
[x, y]
//│ = [1, 2]

// Exceptions outside binding groups also keep the values used by finally alive.
:re
fun restoreOnThrow() =
  let saved = x
  try
    set x = 99
    throw 45
  finally set x = saved
restoreOnThrow()
//│ ═══[RUNTIME ERROR] 45

:expect 1
x
//│ = 1

// Known data fields share one protected region, including on exceptional exits.
class Fields(mut val left, mut val right)
let fields = new mut Fields(1, 2)
//│ fields = Fields(1, 2)

:sjs
:re
set { fields.left = 10, fields.right = 20 } in throw 46
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let savedCount7, old15, old16, scrut12;
//│ old15 = fields.left;
//│ savedCount7 = 1;
//│ try {
//│   fields.left = 10;
//│   old16 = fields.right;
//│   savedCount7 = 2;
//│   fields.right = 20;
//│   throw 46
//│ } finally {
//│   scrut12 = savedCount7 >= 2;
//│   if (scrut12 === true) { fields.right = old16; }
//│   fields.left = old15;
//│ }
//│ return runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] 46

:expect [1, 2]
[fields.left, fields.right]
//│ = [1, 2]

// A known data field still needs protection when evaluating its receiver can throw.
let failReceiver = false
fun receiver() = if failReceiver then throw 47 else fields
//│ failReceiver = false

:re
set { x = 10, receiver().right = 20 } in set failReceiver = true
//│ ═══[RUNTIME ERROR] 47

:expect [1, 20]
[x, fields.right]
//│ = [1, 20]
