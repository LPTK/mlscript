:js

import "../../mlscript-compile/StrOps.mls"


StrOps.{~}
//│ = fun concat2

StrOps.{~}("a", "b")
//│ = "ab"

:e
StrOps.{~}("a", "b", "c")
//│ ╔══[COMPILATION ERROR] Expected 2 arguments, got 3
//│ ║  l.+1: 	StrOps.{~}("a", "b", "c")
//│ ╙──      	          ^^^^^^^^^^^^^^^
//│ = "ab"

StrOps.{"a" ~ "b"}
//│ = "ab"

StrOps.{"a" ~ from(123)}
//│ = "a123"


// Symbolic members can also be selected directly.
:expect fun concat2
StrOps.~
//│ = fun concat2

:expect "ab"
StrOps.~("a", "b")
//│ = "ab"


