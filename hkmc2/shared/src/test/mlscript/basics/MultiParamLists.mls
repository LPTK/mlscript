//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42

fun f(n1: Int)(n2: Int)(n3: Int): Int = 10 * (10 * n1 + n2) + n3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2, f$worker;
//│ f2 = function f(n1) {
//│   return (n2) => {
//│     return (n3) => {
//│       return f$worker(n1, n2, n3)
//│     }
//│   }
//│ };
//│ f$worker = function f$worker(n1, n2, n3) {
//│   let tmp3, tmp4, tmp5;
//│   tmp3 = 10 * n1;
//│   tmp4 = tmp3 + n2;
//│   tmp5 = 10 * tmp4;
//│   return tmp5 + n3
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(4)(2)(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp3, tmp4, tmp5, tmp6, tmp7, tmp8;
//│ tmp3 = 4;
//│ tmp4 = 2;
//│ tmp5 = 0;
//│ tmp6 = 10 * tmp3;
//│ tmp7 = tmp6 + tmp4;
//│ tmp8 = 10 * tmp7;
//│ return tmp8 + tmp5
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 420

fun f(n1: Int)(n2: Int)(n3: Int)(n4: Int): Int = 10 * (10 * (10 * n1 + n2) + n3) + n4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
