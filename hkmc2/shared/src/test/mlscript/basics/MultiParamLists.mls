fun f(n1: Int)(n2: Int)(n3: Int): Int = 10 * (10 * n1 + n2) + n3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f2, f$worker;
//│ f2 = function f(n1) {
//│   return (n2) => {
//│     return (n3) => {
//│       return f$worker(n1, n2, n3)
//│     }
//│   }
//│ };
//│ f$worker = function f$worker(n1, n2, n3) {
//│   let tmp, tmp1, tmp2, castScrut;
//│   tmp = 10 * n1;
//│   tmp1 = tmp + n2;
//│   tmp2 = 10 * tmp1;
//│   castScrut = tmp2 + n3;
//│   if (globalThis.Number.isInteger(castScrut)) {
//│     return castScrut
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Int'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(4)(2)(0)
