:js

// The `in` body sees every binding, in declaration order.
:expect 3
let
  x = 1
  y = 2
in x + y
//│ = 3

:expect 6
let
  x = 1
  y = x + 1
in
  let z = x + y
  z * 2
//│ = 6

// Grouped declarations without `in` remain visible in the enclosing block.
:expect 3
let
  groupedX = 1
  groupedY = groupedX + 1
groupedX + groupedY
//│ = 3
//│ groupedX = 1
//│ groupedY = 2

// A scoped group shadows outer bindings without changing them.
:expect [3, 10]
let shadowed = 10
let inner = let { shadowed = 1, y = shadowed + 1 } in shadowed + y
[inner, shadowed]
//│ = [3, 10]
//│ inner = 3
//│ shadowed = 10

// Groups also work in function bodies and argument positions.
:expect 5
let f(n) = let { x = n, y = x + 1 } in x + y
f(2)
//│ = 5
//│ f = fun f

:expect 7
(n => n)(let { x = 3, y = 4 } in x + y)
//│ = 7

// Per-binding `in` clauses are unsupported by ordinary block parsing.
:pe
:e
:re
let
  x = 1 in print(x)
  y = 2
in y
//│ ╔══[PARSE ERROR] Unexpected 'in' keyword here
//│ ║  l.55: 	  x = 1 in print(x)
//│ ╙──      	        ^^
//│ ╔══[COMPILATION ERROR] Name not found: y
//│ ║  l.57: 	in y
//│ ╙──      	   ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Initializer blocks and function bindings use the ordinary binding grammar.
:expect 6
let
  x =
    let n = 2
    n + 1
  twice(n) = n * 2
in twice(x)
//│ = 6

// `set` groups update all targets in order and restore them after an `in` body.
let sx = 1
let sy = 2
//│ sx = 1
//│ sy = 2

:sr
:soir
:expect [33, 1, 2]
let result = set
  sx = 10
  sy = sx + 13
in sx + sy
[result, sx, sy]
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   let result⁰,
//│   result⁰ = {
//│     let old⁰,
//│     let old¹,
//│     let active⁰,
//│     active⁰ = false,
//│     old⁰ = sx⁰,
//│     try {
//│       sx⁰ := 10,
//│       old¹ = sy⁰,
//│       active⁰ := true,
//│       sy⁰ := +(sx⁰, 13)‹app⁰›,
//│       +(sx⁰, sy⁰)‹app¹›
//│     } finally {
//│       if {
//│         active⁰ is true do sy⁰ := old¹;
//│         else ()
//│       },
//│       sx⁰ := old⁰
//│     }
//│   },
//│   [ result⁰, sx⁰, sy⁰ ]
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let old, old1, active, tmp;
//│ set active = false;
//│ set old = sx⁰;
//│ try
//│   set sx⁰ = 10;
//│   set old1 = sy⁰;
//│   set active = true;
//│   set sy⁰ = 23;
//│   set tmp = 33;
//│   end
//│ finally
//│   match active
//│     true =>
//│       set sy⁰ = old1;
//│       end
//│   set sx⁰ = old;
//│   end;
//│   set result⁰ = tmp;
//│ return [tmp, old, sy⁰]
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [33, 1, 2]
//│ result = 33

:expect [5, 6]
set
  sx = 5
  sy = sx + 1
[sx, sy]
//│ = [5, 6]

// Compound assignments also restore in reverse order, including repeated targets.
:sjs
:expect [16, 5]
let result = set { sx += 3, sx *= 2 } in sx
[result, sx]
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let result1, old2, old3, active1, tmp1, tmp2, tmp3;
//│ active1 = false;
//│ old2 = sx;
//│ try {
//│   tmp2 = sx + 3;
//│   sx = tmp2;
//│   old3 = tmp2;
//│   active1 = true;
//│   tmp3 = tmp2 * 2;
//│   sx = tmp3;
//│   tmp1 = tmp3;
//│ } finally {
//│   if (active1 === true) {
//│     sx = old3;
//│   }
//│   sx = old2;
//│ }
//│ result1 = tmp1;
//│ return globalThis.Object.freeze([ tmp1, old2 ])
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [16, 5]
//│ result = 16

:expect [13, 5, 6]
let result = set
  sx = 6
  sy = 7
in
  sx + sy
[result, sx, sy]
//│ = [13, 5, 6]
//│ result = 13

:e
let
  hidden = 1
in print(hidden)
hidden
//│ ╔══[COMPILATION ERROR] Name not found: hidden
//│ ║  l.187: 	hidden
//│ ╙──       	^^^^^^
//│ > 1
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
let
  invalid = later
  later = 1
in invalid
//│ ╔══[COMPILATION ERROR] Name not found: later
//│ ║  l.196: 	  invalid = later
//│ ╙──       	            ^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Per-binding bodies without an outer `in` are also unsupported.
:pe
:e
let nested = let
  x = 1 in x
nested
//│ ╔══[PARSE ERROR] Unexpected 'in' keyword here
//│ ║  l.208: 	  x = 1 in x
//│ ╙──       	        ^^
//│ ╔══[COMPILATION ERROR] Expected a body for let bindings in expression position
//│ ║  l.208: 	  x = 1 in x
//│ ╙──       	  ^^^^^
//│ nested = ()

:expect 3
let { declaredX, declaredY }
declaredX = 1
declaredY = 2
declaredX + declaredY
//│ = 3
//│ declaredX = 1
//│ declaredY = 2

// Empty groups are no-ops and still evaluate the enclosing body.
:expect 3
let {} in 3
//│ = 3

:expect 4
set {} in 4
//│ = 4

// An indented `in` is an entry in the block, not the group's continuation.
:e
let
  x = 1
  in x
//│ ╔══[COMPILATION ERROR] Unsupported let binding shape
//│ ║  l.240: 	  in x
//│ ╙──       	     ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ x = 1

// A compound binding reads the preceding binding of the same name.
let
  x = 1
  x += 1
//│ x = 2

:expect 2
x
//│ = 2

// Interleaved binding groups extend the context of subsequent branches.
:expect 2
if
  let
    branchX = 1
    branchX += 1
  branchX is 2 then branchX
  else 0
//│ = 2
