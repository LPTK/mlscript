:js


let r = {a: 0}
//│ r = {a: 0}

set
  r.a = 1
  r.foo = 1

:expect 0
r.a
//│ = 0

:re
r.foo
//│ ═══[RUNTIME ERROR] Error: Access to required field 'foo' yielded 'undefined'


let r = mut {a: 1}
//│ r = {a: 1}

set
  r.a = 1
  r.foo = 1

:expect 1
r.a
//│ = 1

:expect 1
r.foo
//│ = 1


let r = mut {}
//│ r = {}

set r.foo = 1

:expect 1
r.foo
//│ = 1


