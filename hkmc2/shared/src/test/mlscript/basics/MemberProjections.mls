:js


module M with
  data class Foo(x) with
    fun m() = this.x + 1
    fun n(y) = this.x + y


let foo = M.Foo(123)
//│ foo = Foo(123)


foo.m()
//│ = 124

foo.n(1)
//│ = 124


foo M.Foo::m()
//│ = 124

foo M.Foo::n(2)
//│ = 125

M.Foo::n(foo, 2)
//│ = 125

M.Foo ::n(foo, 2)
//│ = 125

M.Foo ::n (foo, 2)
//│ = 125

:e
M.Foo:: n(foo, 2)
//│ ╔══[COMPILATION ERROR] Name not found: ::
//│ ║  l.37: 	M.Foo:: n(foo, 2)
//│ ╙──      	     ^^
//│ ╔══[COMPILATION ERROR] Name not found: n
//│ ║  l.37: 	M.Foo:: n(foo, 2)
//│ ╙──      	        ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


