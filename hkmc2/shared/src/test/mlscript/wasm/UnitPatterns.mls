:.

// A pattern can be the first use of the runtime singleton in this module.
fun isUnit(value) = if value is () then 1 else 0
isUnit(0)
//│ Wasm result:
//│ = 0

let originalUnit = ()
isUnit(originalUnit) * 10 + isUnit(0)
//│ Wasm result:
//│ = 10

// Distinguish the runtime singleton from an unrelated object with the same name.
object Unit
fun shadowed(value) = if value is () then 1 else 0
shadowed(()) * 10 + shadowed(Unit)
//│ Wasm result:
//│ = 10

:fixme // Wasm strict equality currently accepts only Int31 values.
if () === originalUnit then 1
//│ Wasm result:
//│ ═══[RUNTIME ERROR] RuntimeError: unreachable

// A later block must still import the original runtime singleton type.
if originalUnit is () and not (Unit is ()) then 1
//│ Wasm result:
//│ = 1

// An implicit unit result must reuse the same singleton, too.
let unrelated = 42
//│ Wasm result:
//│ = {}

if originalUnit is () and not (Unit is ()) then unrelated
//│ Wasm result:
//│ = 42
