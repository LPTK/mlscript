
:global
:js

// Load the actual compiled files, including their dependency loaders and WAT.
import "../../mlscript-compile/wasm/modules/Answer.mjs"
import "../../mlscript-compile/wasm/modules/Functions.mjs"
import "../../mlscript-compile/wasm/modules/Numbers.mjs"
import "../../mlscript-compile/wasm/modules/Strings.mjs"
import "../../mlscript-compile/wasm/modules/PrivateImport.mjs"
import "../../mlscript-compile/wasm/modules/TransitiveImport.mjs"
import "../../mlscript-compile/wasm/modules/Classes.mjs"
import "../../mlscript-compile/wasm/modules/Virtual.mjs"
import "../../mlscript-compile/wasm/modules/ObjectValue.mjs"
import "../../mlscript-compile/wasm/modules/ObjectImport.mjs"
import "../../mlscript-compile/wasm/modules/Units.mjs"
import "../../mlscript-compile/wasm/modules/Value.mjs"
import "../../mlscript-compile/wasm/modules/entry.mjs"
import "../../mlscript-compile/wasm/modules/FileNames.mjs"
import "../../mlscript-compile/wasm/modules/Exceptions.mjs"
import "../../mlscript-compile/wasm/Box.mjs"

:expect 42
Answer()
//│ = 42

:expect 42
Functions.answer()
//│ = 42

:expect 42
Functions.increment()
//│ = 42

:expect 42
Functions.recursive()
//│ = 42

:expect 40
Numbers.value
//│ = 40

:expect 42
Numbers.answer()
//│ = 42

:expect "importer"
Strings.own
//│ = "importer"

// Strings still uses the dependency's literal memory after its own module loads.
:expect "dependency"
Strings.word()
//│ = "dependency"

:expect 42
PrivateImport()
//│ = 42

:expect 42
TransitiveImport()
//│ = 42

:expect 42
Classes.field()
//│ = 42

:expect 42
Classes.inherited()
//│ = 42

:expect 42
Classes.nominal()
//│ = 42

:expect "object"
typeof(Classes.aliased())
//│ = "object"

:expect "object"
typeof(Box(42))
//│ = "object"

:expect 42
Virtual()
//│ = 42

:expect "object"
typeof(ObjectValue)
//│ = "object"

:expect 42
ObjectImport()
//│ = 42

// Compare identity at the host boundary, not just the printed Unit representation.
:expect true
Units.own() === Units.foreign()
//│ = true

:expect 42
Value
//│ = 42

:expect 42
entry()
//│ = 42

:expect 42
FileNames.sameName()
//│ = 42

:expect 42
FileNames.escapedPath()
//│ = 42

:re
Exceptions()
//│ ═══[RUNTIME ERROR] 42
