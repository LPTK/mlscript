// All comments in this file assume that an intrinsic `cast[T](val)` function exists to perform a
// downcast to `T` for `val`. MLscript currently does not have a surface-language syntax or 
// function for casting between types.

:global
:wasm

// In this example, the function call is equivalent to `useBox(cast[Box](id(new Box(42))))`.
// This is reflected by `(local.set $tmp2 (ref.cast (ref $Box) (local.get $tmp1)))` in the `:wat`
// output.
:wat
class Box(val v: Int)
fun id(a) = a
fun useBox(b: Box): Int = b.v
useBox(id(new Box(42)))
//│ Wat:
//│ (module
//│   (type $TypeInfoBase (sub (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Object (sub (struct (field $$typeinfo (mut (ref $TypeInfoBase))))))
//│   (type $Box (sub $Object (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $v (mut (ref null i31))))))
//│   (type $Box_typeinfo (sub $TypeInfoBase (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Box_init (func (param $this (ref $Box)) (param $v (ref null i31)) (result (ref $Box))))
//│   (type $Box_ctor (func (param $v (ref null i31)) (result (ref $Box))))
//│   (type $id (func (param $a (ref null any)) (result (ref null any))))
//│   (type $useBox (func (param $b (ref $Box)) (result (ref null i31))))
//│   (type $entry (func (result (ref i31))))
//│   (global $Box_typeinfo (export "Box_typeinfo") (ref $Box_typeinfo) (struct.new $Box_typeinfo
//│     (i32.const 1)
//│     (ref.null $TypeInfoBase)))
//│   (func $Box_init (type $Box_init) (param $this (ref $Box)) (param $v (ref null i31)) (result (ref $Box))
//│     (block (result (ref $Box))
//│       (struct.set $Box $v
//│         (local.get $this)
//│         (local.get $v))
//│       (return
//│         (ref.cast (ref $Box)
//│           (local.get $this)))))
//│   (func $Box_ctor (export "Box") (type $Box_ctor) (param $v (ref null i31)) (result (ref $Box))
//│     (local $this (ref $Box))
//│     (block (result (ref $Box))
//│       (local.set $this
//│         (struct.new $Box
//│           (global.get $Box_typeinfo)
//│           (ref.null i31)))
//│       (drop
//│         (call $Box_init
//│           (local.get $this)
//│           (local.get $v)))
//│       (return
//│         (local.get $this))))
//│   (func $id (export "id") (type $id) (param $a (ref null any)) (result (ref null any))
//│     (return
//│       (local.get $a)))
//│   (func $useBox (export "useBox") (type $useBox) (param $b (ref $Box)) (result (ref null i31))
//│     (return
//│       (ref.cast (ref i31)
//│         (struct.get $Box $v
//│           (local.get $b)))))
//│   (func $entry (export "entry") (type $entry) (result (ref i31))
//│     (local $tmp (ref $Box))
//│     (local $tmp1 (ref $Box))
//│     (block (result (ref i31))
//│       (local.set $tmp
//│         (call $Box_ctor
//│           (ref.i31
//│             (i32.const 42))))
//│       (local.set $tmp1
//│         (local.get $tmp))
//│       (return
//│         (ref.cast (ref i31)
//│           (struct.get $Box $v
//│             (local.get $tmp1))))))
//│   (elem $Box_init declare func $Box_init)
//│   (elem $Box_ctor declare func $Box_ctor)
//│   (elem $id declare func $id)
//│   (elem $useBox declare func $useBox)
//│   (elem $entry declare func $entry))
//│ Wasm result:
//│ = 42


// Similarly, the constructor call to `Wrap` is `new Wrap(cast[Box](id(new Box(7))))`, which the
// WAT backend also reflects with a `ref.cast` instruction.
class Wrap(val b: Box)
fun readV(b: Box) = b.v
let w = new Wrap(id(new Box(7)))
readV(w.Wrap#b)
//│ Wasm result:
//│ = 7


// `inc(cast[Int](id(41)))`
fun inc(n: Int) = n + 1
inc(id(41))
//│ Wasm result:
//│ = 42


// `set x = cast[Int](id(7))`
fun setter(x: Int) =
  set x = id(7)
  x
setter(1)
//│ Wasm result:
//│ = 7


// A return coercion is not restricted to paths - it also wraps an instantiate...
fun mkObj(n: Int): Object = new Box(42)
mkObj(0)
//│ Wasm result:
//│ = {}


// ...and a call, whose result is then narrowed for the `Box`-typed parameter of `useBox`.
fun anyBox(n: Int): Object = new Box(7)
fun narrowBox(n: Int): Box = anyBox(n)
useBox(narrowBox(0))
//│ Wasm result:
//│ = 7


// Guards the re-placement of a return coercion across a merged dispatcher: only `sccF` narrows
// (`sccG` widens, free), so entering at `sccF` can exit through `sccG`'s arm, and its coercion has to
// be re-placed on its own stub - else `useBox` receives a value that was never narrowed to `Box`.
// Unlike JS, Wasm does not erase casts, so a missing narrowing is observable here.
fun sccF(n: Int): Box = sccG(n)
fun sccG(n: Int): Object = if n <= 0 then new Box(42) else sccF(n - 1)
useBox(sccF(3))
//│ Wasm result:
//│ = 42


// Under `:checkCasts`, the narrowing becomes a runtime type test instead of a bare `ref.cast`. The
// class must be defined in this block: one from an earlier block has no `typeinfo` global registered,
// so no test can be emitted for it.
:checkCasts
class Crate(val v: Int)
fun useCrate(c: Crate): Int = c.v
useCrate(id(new Crate(42)))
//│ Wasm result:
//│ = 42


// The failing test throws, rather than trapping as `ref.cast` would.
:checkCasts
:re
class Crate2(val v: Int)
class NotACrate(val w: Int)
fun useCrate2(c: Crate2): Int = c.v
useCrate2(id(new NotACrate(1)))
//│ Wasm result:
//│ ═══[RUNTIME ERROR] Cannot narrow a value to type 'Crate2'


// A primitive target takes no runtime test: `Int32` is unboxed, so there is nothing to test against. The
// cast comes from `id`'s unannotated result, which stays untyped by design.
:checkCasts
wasm.ref.i31(id(wasm.i32.const(7)))
//│ Wasm result:
//│ = 7
