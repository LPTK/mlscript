
:global
:wasm

// An unknown value (`?`) — here the result of the unannotated identity function
// `id` — flowing into a class-annotated parameter is narrowed with a `Cast` at
// the call site. The `:fwat` output shows it emitted as a `ref.cast`: the `id`
// result (`anyref`) is bound to a `(ref $Box)` temp (`$tmp2`) before it reaches
// `useBox`.
:wat
class Box(val v: Int)
fun id(a) = a
fun useBox(b: Box) = b.v
useBox(id(new Box(42)))
//│ Wat:
//│ (module
//│   (type $TypeInfoBase (sub (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Object (sub (struct (field $$typeinfo (mut (ref $TypeInfoBase))))))
//│   (type $Box (sub $Object (struct (field $$typeinfo (mut (ref $TypeInfoBase))) (field $v (mut (ref null any))))))
//│   (type $Box_typeinfo (sub $TypeInfoBase (struct (field $$tag i32) (field $$parent (ref null $TypeInfoBase)))))
//│   (type $Box_init (func (param $this (ref $Box)) (param $v (ref null i31)) (result (ref $Box))))
//│   (type $Box_ctor (func (param $v (ref null i31)) (result (ref $Box))))
//│   (type $id (func (param $a (ref null any)) (result (ref null any))))
//│   (type $useBox (func (param $b (ref $Box)) (result (ref null any))))
//│   (type $entry (func (result (ref null any))))
//│   (global $Box_typeinfo (export "Box_typeinfo") (ref $Box_typeinfo) (struct.new $Box_typeinfo
//│     (i32.const 1)
//│     (ref.null $TypeInfoBase)))
//│   (func $Box_init (type $Box_init) (param $this (ref $Box)) (param $v (ref null i31)) (result (ref $Box))
//│     (block (result (ref $Box))
//│       (struct.set $Box $v
//│         (local.get $this)
//│         (local.get $v))
//│       (return
//│         (ref.cast (ref $Box)
//│           (local.get $this)))))
//│   (func $Box_ctor (export "Box") (type $Box_ctor) (param $v (ref null i31)) (result (ref $Box))
//│     (local $this (ref $Box))
//│     (block (result (ref $Box))
//│       (local.set $this
//│         (struct.new $Box
//│           (global.get $Box_typeinfo)
//│           (ref.null any)))
//│       (drop
//│         (call $Box_init
//│           (local.get $this)
//│           (local.get $v)))
//│       (return
//│         (local.get $this))))
//│   (func $id (export "id") (type $id) (param $a (ref null any)) (result (ref null any))
//│     (return
//│       (local.get $a)))
//│   (func $useBox (export "useBox") (type $useBox) (param $b (ref $Box)) (result (ref null any))
//│     (return
//│       (struct.get $Box $v
//│         (local.get $b))))
//│   (func $entry (export "entry") (type $entry) (result (ref null any))
//│     (local $tmp (ref null i31))
//│     (local $tmp1 (ref null any))
//│     (local $tmp2 (ref $Box))
//│     (block (result (ref null any))
//│       (local.set $tmp
//│         (ref.i31
//│           (i32.const 42)))
//│       (local.set $tmp1
//│         (call $Box_ctor
//│           (local.get $tmp)))
//│       (local.set $tmp2
//│         (ref.cast (ref $Box)
//│           (local.get $tmp1)))
//│       (return
//│         (struct.get $Box $v
//│           (local.get $tmp2)))))
//│   (elem $Box_init declare func $Box_init)
//│   (elem $Box_ctor declare func $Box_ctor)
//│   (elem $id declare func $id)
//│   (elem $useBox declare func $useBox)
//│   (elem $entry declare func $entry))
//│ Wasm result:
//│ = 42


// The same narrowing applies to a constructor argument whose declared field type
// is a class: `id(new Box(7))` is narrowed to `Box` for `Wrap`'s `b` parameter.
class Box(val v: Int)
class Wrap(val b: Box)
fun id(a) = a
fun readV(b: Box) = b.v
let w = new Wrap(id(new Box(7)))
readV(w.Wrap#b)
//│ Wasm result:
//│ = 7


// Narrowing into a primitive `Int` parameter is also a downcast (`anyref` ->
// `i31`).
fun id(a) = a
fun inc(n: Int) = n + 1
inc(id(41))
//│ Wasm result:
//│ = 42


// Reassigning an annotated parameter narrows the right-hand side at the
// assignment.
fun id(a) = a
fun setter(x: Int) =
  set x = id(7)
  x
setter(1)
//│ Wasm result:
//│ = 7


// Narrowing a value to a provably-unrelated primitive type — an annotated `Str`
// result flowing into an `Int` parameter — is a compile-time error; the value
// flows on uncast.
:ge
fun getStr(): Str = "s"
fun needInt(n: Int) = n
needInt(getStr())
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Str' to unrelated type 'Int'
//│ ║  l.121: 	needInt(getStr())
//│ ╙──       	        ^^^^^^^^
//│ Wasm result:
//│ = "s"
