// `undefined` is an unspecified value whose read-back is undefined behavior, so the Wasm backend materializes it in
// a slot of class type as a placeholder instance of the class, held in an immutable global. This lets parameters,
// results, fields, and locals of class type be non-nullable references, which field reads need not cast.
:noInline
:wat
:expect 42
class Bar(val x: Int32)
class Foo(val bar: Bar)
private fun absent(): Bar = undefined
private fun wrap(bar: Bar): Foo = Foo(bar)
private fun read(foo: Foo): Int32 = foo.bar.x
private fun run(flag: Bool): Int32 =
  let missing = absent()
  if flag do set missing = undefined
  let unspecified = wrap(missing)
  let other = wrap(undefined)
  read(wrap(Bar(const(42))))
run(true)
