// Assigning `undefined` to a field of class type also stores the placeholder.
:noInline
:expect 42
class Cell(mut val content: Bar)
private fun reset(cell: Cell) = set cell.content = undefined
private fun refill(): Int32 =
  let cell = Cell(Bar(const(1)))
  reset(cell)
  set cell.content = Bar(const(42))
  cell.content.x
refill()
//│ Wasm result:
//│ = 42


// Wasm only considers a non-nullable local set after an assignment in the same block or an enclosing one, not
// after a conditional that assigns it in every branch. Such a local starts out holding the placeholder.
:noInline
:wat
:expect 42
private fun pick(flag: Bool, a: Bar, b: Bar): Int32 =
  let chosen = if flag then a else b
  let x = chosen.x
  i32.add(x, chosen.x)
pick(true, Bar(const(21)), Bar(const(0)))
