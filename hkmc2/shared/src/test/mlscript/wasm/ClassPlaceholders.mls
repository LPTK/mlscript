// The placeholder of an abstract class is an instance of the abstract class itself, so it only needs placeholders
// for the abstract class's own fields: `Cons` has a placeholder, although its field refers back to its parent.
:noInline
:wat
:expect 1
abstract class List
class Cons(val head: Int32, val tail: List) extends List
class Nil() extends List
private fun absentCons(): Cons = undefined
private fun headOf(cons: Cons): Int32 = cons.head
let unspecified = absentCons()
headOf(Cons(const(1), Nil()))
