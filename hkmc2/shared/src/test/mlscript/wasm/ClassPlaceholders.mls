// A class whose fields of class type lead back to it has no finite placeholder: its slots stay nullable and hold
// `undefined` as a null reference. A class with a field of such a class only needs a null reference for that field.
:noInline
:wat
:expect 1
class Node(val value: Int32, val next: Node)
class Holder(val node: Node)
private fun valueOf(node: Node): Int32 = node.value
private fun absentHolder(): Holder = undefined
let unspecified = absentHolder()
valueOf(Node(const(1), undefined))
