// :sjs
// data class Foo(mut val x)



class Foo with
  fun foo() = 1
  fun bar = 2


let f = new mut Foo
//│ f = Foo

set f.foo = () => 3
f.foo()
//│ = 3

set f.bar = 3
f.bar
//│ = 2


let f = new Foo
//│ f = Foo

set f.foo = () => 3
f.foo()
//│ = 1

set f.bar = 3
f.bar
//│ = 2



