:todo
:effectHandlers
:lift
let x = 1
handle h = Object with
  fun test()(k) =
    print("SUSPENDING")
    let res = k(42)
    print("DONE")
    res
set x += 1 in
  print("init")
  print(h.test())
  print(x)
  print("end")
x
