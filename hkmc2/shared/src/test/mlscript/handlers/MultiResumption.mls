:js
:effectHandlers
:lift

class Logger with
  fun info(s: Str): ()

:re
handle h = Logger with
  fun info(s)(k) =
    print(s)
    k()
    k()
h.info("a")
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'info')


handle h = Logger with
  fun info(s)(k) =
    print(s)
    k()
    k()
123
//│ = 123
