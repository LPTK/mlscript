:js
:effectHandlers

class Logger with
  fun info(s: Str): ()

:re
handle h = Logger with
  fun info(s)(k) =
    print(s)
    k()
    k()
h.info("a")
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'last' of object '[object Object]'


handle h = Logger with
  fun info(s)(k) =
    print(s)
    k()
    k()
123
