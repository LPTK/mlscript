class Debugger() with
  fun break(payload)

module Test with
  fun test(j)(using dbg: Debugger) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main()(using Debugger) =
    test(12) + test(34)

let res =
  handle h = Debugger with
    fun break(payload)(resume) = resume
  using Debugger = h
  Runtime.try(() => Test.main())
