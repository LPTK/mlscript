:re
fun lambda_test(f) =
  f()
  200
lambda_test(() =>
  raiseUnhandledEffect()
  100)
//│ ═══[RUNTIME ERROR] Error: Unhandled effect FatalEffect
//│ 	at lambda (Debugging.mls:106:3)
//│ 	at lambda_test (Debugging.mls:103:3)


import "../../mlscript-compile/Runtime.mls"

:silent
let res = Runtime.try(f)

res.reified.contTrace.next.getLocals
//│ = [LocalVarInfo("i", 0), LocalVarInfo("j", 100), LocalVarInfo("k", 2000)]

Runtime.debugEff(res.reified)
//│ > Debug EffectSig:
//│ > handler:  FatalEffect
//│ > handlerFun:  null
//│ > resumed:  false
//│ > <lastHandler is self>
//│ > FunctionContFrame(pc=4, last) -> (null)
//│ > 

:expect Infinity
res.resumeWith(42)
//│ > 42
//│ = Infinity



class Debugger() with
  fun break(payload)

module Test with
  fun test(j)(using dbg: Debugger) =
    let i = 0
    let k = 2000
    if i == 0 do
      set i = dbg.break("whoops")
    j / i
  fun main()(using Debugger) =
    test(12) + test(34)

fun get(using Debugger) = 1

:rt
:lot
let res =
  handle h = Debugger with
    fun break(payload)(resume) = resume
  using Debugger = h
  Runtime.try(() => Test.main())
