// FIFO
handle h = ThreadEffect with
  fun fork(thread)(k) =
    this.tasks.push(thread)
    k(())
  fun yld()(k) =
    this.tasks.push(() => k(()))
    enterHandleBlock(this, () => this.tasks.shift()())
  fun start(main)(k) =
    this.tasks.push(() => main(this))
    while this.tasks.length != 0 do
      enterHandleBlock(this, () => this.tasks.shift()())
    k(())
in
  h.start(main)
