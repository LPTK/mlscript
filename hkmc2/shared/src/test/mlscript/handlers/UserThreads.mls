abstract class ThreadEffect with
  val tasks = mut []
  fun start(thread: () -> ()): ()
  fun fork(thread: () -> ()): ()
  fun yld(): ()

class Lock(val locked) with
  fun lock(th: ThreadEffect) =
    while locked do
      th.yld()
    set locked = true
  fun unlock() =
    set locked = false

fun f(h, x) =
  print("f " + x)
  h.yld()
  print("f " + x)
  h.yld()
  print("f " + x)

fun main(h) =
  print("main start")
  h.fork(() => f(h, 0))
  h.fork(() => f(h, 1))
  h.fork(() => f(h, 2))
  print("main end")


