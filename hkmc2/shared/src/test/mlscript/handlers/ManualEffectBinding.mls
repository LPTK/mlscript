:js
:effectHandlers
:lift

abstract class Effect with
  fun perform(): ()

let h1 = null
handle h = Effect with
  fun perform()(k) =
    print("perform")
    k()
    print("perform-end")
set h1 = h
//│ h1 = undefined

:re
h1.perform()
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading 'perform')

enterHandleBlock(h1, () => h1.perform())
