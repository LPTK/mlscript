:js
:effectHandlers

abstract class Effect with
  fun perform(): ()

let h1 = null
handle h = Effect with
  fun perform()(k) =
    print("perform")
    k()
    print("perform-end")
set h1 = h
//│ h1 = Handler$h$

:re
h1.perform()
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'last' of object '[object Object]'

enterHandleBlock(h1, () => h1.perform())
