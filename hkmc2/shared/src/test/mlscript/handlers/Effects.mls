    g()
  else
    fun g() = 3
    g()
handle h = Eff with
  fun perform()(k) = k(())
foo(h)
//│ = 3

:expect 123
fun foo(h) =
  h.perform()
  fun A() = 1
  let a = if true then
    class A() with
      fun f() = 2
    A().f()
  else
    class A() with
      fun f() = 3
    A().f()
  let b = if false then
    class A() with
      fun f() = 2
    A().f()
  else
    class A() with
      fun f() = 3
    A().f()
  A() * 100 + a * 10 + b
handle h = Eff with
  fun perform()(k) = k(())
foo(h) 
//│ = 123

