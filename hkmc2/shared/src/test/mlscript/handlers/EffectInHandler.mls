handle h1 = PrintEffect with
  fun p(x)(k) =
    print(x)
    k(())
  fun aux(x)(k) = k(())
handle h2 = PrintEffect with
  fun p(x)(k) =
    print(x)
    k(())
  fun aux(x)(k) =
    h1.p(x)
    k(())
    h1.p(x)
h1.p(4)
h2.aux(3)
h1.p(4)
