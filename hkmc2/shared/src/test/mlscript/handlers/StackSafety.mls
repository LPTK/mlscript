:js
:effectHandlers
:lift
:noTailRec


// preserve tail calls
// MUST see "return hi(tmp1)" in the output
:stackSafe 6
:expect 0
:sjs
fun hi(n) =
  if n === 0 then 0
  else hi(n - 1)
hi(0)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let hi, tmp, $_stack$_safe$_body$_;
//│ runtime.resetEffects();
//│ hi = function hi(n) {
//│   runtime.stackDepth = runtime.stackDepth + 1;
//│   runtime.checkDepth();
//│   if (runtime.curEffect === null) {
//│     let scrut, tmp1;
//│     scrut = n === 0;
//│     if (scrut === true) {
//│       return 0
//│     }
//│     tmp1 = n - 1;
//│     return hi(tmp1);
//│   }
//│   return runtime.unwind(hi, -1, "StackSafety.mls:12:1", null, null, 1, 1, n, 0);
//│ };
//│ $_stack$_safe$_body$_ = (undefined, function () {
//│   return hi(0)
//│ });
//│ tmp = runtime.runStackSafe(6, $_stack$_safe$_body$_);
//│ if (runtime.curEffect === null) { tmp } else { tmp = runtime.topLevelEffect(false); tmp }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

