using Str = "ok"
//│ instance$Ident(Str) = "ok"

fun bar = M.foo()
module M with
  fun foo()(using s: Str) = s

:expect "ok"
bar
//│ = "ok"

fun bar = M.getN.foo()
module M with
  fun getN: module N = N
module N with
  fun foo()(using Str) = 1

:expect 1
bar
//│ = 1


