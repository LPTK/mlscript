:.

// Calling a method of a generic instance preserves the shape passed through
// its generic wrapper: the instance's site is inside the wrapper, so the
// wrapper's binding is retained. The two calls keep distinct instantiations.
:expect [1, 2]
class First(val first: Int)
class Second(val second: Int)
class Box[T](val value: T) with
  fun get(): T = value
private fun wrap[B](x: B) = Box(x).get()
[wrap(First(1)).first, wrap(Second(2)).second]
//│ = [1, 2]

// The corresponding by-name method preserves the wrapper's argument shape.
:expect [3, 4]
class First(val first: Int)
class Second(val second: Int)
class Box[T](val value: T) with
  fun get: T = value
private fun wrap[B](x: B) = Box(x).get
[wrap(First(3)).first, wrap(Second(4)).second]
//│ = [3, 4]

// Spreading a generic tuple preserves the element's shape through the
// wrapper's type parameter: the tuple's field retains an instance whose site
// is inside the wrapper.
:expect 5
class Item(val value: Int)
private fun tuple[A](x: A): [A] = [x]
private fun wrap[B](x: B) = [...tuple(x)]
wrap(Item(5)).0.value
//│ = 5
