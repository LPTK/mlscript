declare fun Seq[A](...xs: Array[A]): Seq[A]
declare class Seq[out A] {
  fun map[B](f: A -> B): Seq[B]
}

(x: Seq[{k: {k: Int}}]) => x.map(_.k).map(_.k)
//│ = fun


