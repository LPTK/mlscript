fun Seq[A](...xs: A) = new Seq(xs)
class Seq[out A] {
  
  // constructor(val ...xs: A) // TODO: support
  constructor(val elements: Array[A])
  
  fun map[B](f: A -> B): Seq[B] = new Seq of elements.map of pass1 of f
  
  override fun toString() = "Seq(" + elements.map(pass1 of renderAsStr).join(", ") + ")"
}


let xs = Seq(1, 2, 3)
//│ xs = Seq(1, 2, 3)

xs.map(_ + 1).map(_ * 2).map(_ - 1)
//│ = Seq(3, 5, 7)

let xs = Seq of
  (key: "A", value: 1)
  (key: "B", value: 2)
  (key: "A", value: 3)
  (key: "B", value: 4)
//│ xs = Seq({key: "A", value: 1}, {key: "B", value: 2}, {key: "A", value: 3}, {key: "B", value: 4})

