fun Seq[A](...xs: A): Seq[A] = new Seq(xs)
class Seq[out A] {
  constructor(val elements: Array[A])
  fun map[B](f: A -> B) = new Seq \ elements.map \ pass1 \ f
}

let xs = Seq(1, 2, 3)
//│ xs = Seq { elements: [1, 2, 3] }

:fixme
