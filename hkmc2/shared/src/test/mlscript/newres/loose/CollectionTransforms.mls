// * Borked annotation: should be `...xs: Array[A]` instead of `...xs: A`
fun Seq[A](...xs: A) = new Seq(xs)
class Seq[out A] {
  constructor(val elements: Array[A])
  fun map[B](f: A -> B): Seq[B] = new Seq of elements.map of pass1 of f
}

let xs = Seq(1, 2, 3)
//│ xs = Seq { elements: [1, 2, 3] }

xs.map(_ + 1).map(_ * 2)
//│ = Seq { elements: [4, 6, 8] }

let xs = Seq of
  (key: "A", value: 1)
  (key: "B", value: 2)
//│ xs = Seq { elements: [{key: "A", value: 1}, {key: "B", value: 2}] }

