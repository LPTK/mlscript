// An element annotation supplies the structure needed by the same constraint.
:expect "array"
fun head[B](xs: Array[B]): B = xs.0
fun knownHead[A](xs: Array[A]) = head(xs)
knownHead([(key: "array")]).key
//│ = "array"

// Nominal argument inference has the same obligation for user-defined classes.
:e
class Box[out B](val value: B)
fun unbox[B](box: Box[B]): B = box.value
fun erasedBox[A](box: A) = unbox(box)
erasedBox(new Box((key: "nominal"))).key
