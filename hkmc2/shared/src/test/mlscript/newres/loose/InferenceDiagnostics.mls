// Forwarding the failed inference through another generic result must retain
// both the failed decomposition and the original whole-value annotation.
:e
fun identity[C](x: C): C = x
fun head[B](xs: Array[B]): B = xs.0
fun forwarded[A](xs: A) = identity(head(xs))
forwarded([(key: "forwarded")]).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.246: 	forwarded([(key: "forwarded")]).key
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'key' of a value with unknown shape.
//│ ╟── Cannot infer the type arguments of 'Array' without a known 'Array' type.
//│ ║  l.244: 	fun head[B](xs: Array[B]): B = xs.0
//│ ║         	                ^^^^^^^^
//│ ╟── The available type information comes from this annotation.
//│ ║  l.245: 	fun forwarded[A](xs: A) = identity(head(xs))
//│ ║         	                     ^
//│ ╟── Type parameter 'A' does not specify the structure of its values.
//│ ║  l.245: 	fun forwarded[A](xs: A) = identity(head(xs))
//│ ╙──       	              ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Nested components retain each required structure without inventing a member
// requirement on the original type parameter.
:e
fun nested[B](xs: Array[Array[B]]): B = xs.0.0
fun erasedNested[A](xs: A) = nested(xs)
erasedNested([[(key: "nested")]]).key
