// Inferring a callback result requires its function signature.
:e
fun invoke[B](f: Int -> B): B = f(1)
fun erasedInvoke[A](f: A) = invoke(f)
erasedInvoke(x => (key: "function")).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.109: 	erasedInvoke(x => (key: "function")).key
