// Distinct callback annotations can observe the same inferred argument through
// a shared type view. Each diagnostic must retain its own parameter occurrence,
// including when the missing enclosing structure is a user-defined class.
class Box[out T](val value: T)
class Visitor[out T](val box: Box[T]) {
  fun first[R](f: T -> R): R = f(box.value)
  fun second[R](f: T -> R): R = f(box.value)
}
fun erasedVisitor[A](box: A) = new Visitor(box)
let visitor = erasedVisitor(new Box((key: "callback")))
//│ visitor = Visitor(Box({key: "callback"}))

:e
visitor.first(x => x.key)
visitor.second(x => x.key)
