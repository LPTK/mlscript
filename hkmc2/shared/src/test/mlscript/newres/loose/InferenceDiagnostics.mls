// Inferring an element from an opaque whole value must identify the missing
// array structure, including for ordinary parameters rather than rest tuples.
:e
fun head[B](xs: Array[B]): B = xs.0
fun erasedHead[A](xs: A) = head(xs)
erasedHead([(key: "array")]).key
