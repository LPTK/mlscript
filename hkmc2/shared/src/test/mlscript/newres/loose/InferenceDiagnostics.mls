// Forwarding the failed inference through another generic result must retain
// both the failed decomposition and the original whole-value annotation.
:e
fun identity[C](x: C): C = x
fun head[B](xs: Array[B]): B = xs.0
fun forwarded[A](xs: A) = identity(head(xs))
forwarded([(key: "forwarded")]).key
