// Structural fields also need the record interface of the enclosing value.
:e
fun field[B](x: {value: B}): B = x.value
fun erasedField[A](x: A) = field(x)
erasedField((value: (key: "record"))).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.57: 	erasedField((value: (key: "record"))).key
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'key' of a value with unknown shape.
//│ ╟── Cannot infer the type of field 'value' without a known record type.
//│ ║  l.55: 	fun field[B](x: {value: B}): B = x.value
//│ ║        	                 ^^^^^^^^
//│ ╟── The available type information comes from this annotation.
//│ ║  l.56: 	fun erasedField[A](x: A) = field(x)
//│ ║        	                      ^
//│ ╟── Type parameter 'A' does not specify the structure of its values.
//│ ║  l.56: 	fun erasedField[A](x: A) = field(x)
//│ ╙──      	                ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:expect "record"
fun field[B](x: {value: B}): B = x.value
fun knownField[A](x: {value: A}) = field(x)
knownField((value: (key: "record"))).key
//│ = "record"

// A tuple element is distinct from the tuple's whole-value type parameter.
:e
fun first[B](xs: [B]): B = xs.0
fun erasedFirst[A](xs: A) = first(xs)
