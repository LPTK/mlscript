// A recursive expected structure must terminate with the original source
// witness even though each projection could add another diagnostic step.
:e
type Link[T] = {item: T, next: Link[T]}
fun item[T](link: Link[T]): T = link.item
fun erasedLink[A](link: A) = item(link).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.291: 	fun erasedLink[A](link: A) = item(link).key
//│ ║         	                             ^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'key' of a value with unknown shape.
//│ ╟── Cannot infer the type of field 'item' without a known record type.
//│ ║  l.289: 	type Link[T] = {item: T, next: Link[T]}
//│ ║         	                ^^^^^^^
//│ ╟── The available type information comes from this annotation.
//│ ║  l.291: 	fun erasedLink[A](link: A) = item(link).key
//│ ║         	                        ^
//│ ╟── Type parameter 'A' does not specify the structure of its values.
//│ ║  l.291: 	fun erasedLink[A](link: A) = item(link).key
//│ ╙──       	               ^

// Calling an inferred component must also keep the failed operation separate
// from the annotation of the whole value used for inference.
:e
fun head[B](xs: Array[B]): B = xs.0
fun erasedHead[A](xs: A) = head(xs)
erasedHead([() => 1])()
//│ ╔══[COMPILATION ERROR] Resolution error in application
