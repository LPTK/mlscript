// A recursive expected structure must terminate with the original source
// witness even though each projection could add another diagnostic step.
:e
type Link[T] = {item: T, next: Link[T]}
fun item[T](link: Link[T]): T = link.item
fun erasedLink[A](link: A) = item(link).key
