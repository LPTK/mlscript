:expect "function"
fun invoke[B](f: Int -> B): B = f(1)
fun knownInvoke[A](f: Int -> A) = invoke(f)
knownInvoke(x => (key: "function")).key
//│ = "function"

// Aliases and multiple nominal arguments use the same inference path.
:e
class Pair[out K, out V](val left: K, val right: V)
type IntPair[V] = Pair[Int, V]
fun right[V](pair: IntPair[V]): V = pair.right
fun erasedPair[A](pair: A) = right(pair)
erasedPair(new Pair(1, (key: "alias"))).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.137: 	erasedPair(new Pair(1, (key: "alias"))).key
//│ ║         	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'key' of a value with unknown shape.
//│ ╟── Cannot infer the type arguments of 'Pair' without a known 'Pair' type.
//│ ║  l.134: 	type IntPair[V] = Pair[Int, V]
//│ ║         	                  ^^^^^^^^^^^^
//│ ╟── The available type information comes from this annotation.
//│ ║  l.136: 	fun erasedPair[A](pair: A) = right(pair)
//│ ║         	                        ^
//│ ╟── Type parameter 'A' does not specify the structure of its values.
//│ ║  l.136: 	fun erasedPair[A](pair: A) = right(pair)
//│ ╙──       	               ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:expect "alias"
fun knownPair[A](pair: IntPair[A]) = right(pair)
knownPair(new Pair(1, (key: "alias"))).key
//│ = "alias"

// Any and abstract declarations also lack the structure needed for inference.
// Their bounds must carry an explanation instead of disappearing entirely.
:e
fun head[B](xs: Array[B]): B = xs.0
fun erasedAny(xs: Any) = head(xs)
erasedAny([(key: "any")]).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
