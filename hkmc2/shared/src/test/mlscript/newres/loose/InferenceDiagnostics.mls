// Inferring an element from an opaque whole value must identify the missing
// array structure, including for ordinary parameters rather than rest tuples.
:e
fun head[B](xs: Array[B]): B = xs.0
fun erasedHead[A](xs: A) = head(xs)
erasedHead([(key: "array")]).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.9: 	erasedHead([(key: "array")]).key
//│ ║       	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'key' of a value with unknown shape.
//│ ╟── Cannot infer the type arguments of 'Array' without a known 'Array' type.
//│ ║  l.7: 	fun head[B](xs: Array[B]): B = xs.0
//│ ║       	                ^^^^^^^^
//│ ╟── The available type information comes from this annotation.
//│ ║  l.8: 	fun erasedHead[A](xs: A) = head(xs)
//│ ║       	                      ^
//│ ╟── Type parameter 'A' does not specify the structure of its values.
//│ ║  l.8: 	fun erasedHead[A](xs: A) = head(xs)
//│ ╙──     	               ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An element annotation supplies the structure needed by the same constraint.
:expect "array"
fun head[B](xs: Array[B]): B = xs.0
fun knownHead[A](xs: Array[A]) = head(xs)
knownHead([(key: "array")]).key
//│ = "array"

// Nominal argument inference has the same obligation for user-defined classes.
:e
class Box[out B](val value: B)
fun unbox[B](box: Box[B]): B = box.value
fun erasedBox[A](box: A) = unbox(box)
erasedBox(new Box((key: "nominal"))).key
//│ ╔══[COMPILATION ERROR] Resolution error in selection
