:.

// Non-strict worksheet blocks retain local inference for public definitions.
:expect 1
fun select(x) = x.a
select({a: 1})
//│ = 1

:expect 2
fun returned() = x => x.a
returned()({a: 2})
//│ = 2

// Type parameters remain opaque independently of visibility and exposure checks.
:e
fun generic[A](x: A) = x.a
generic({a: 1})
