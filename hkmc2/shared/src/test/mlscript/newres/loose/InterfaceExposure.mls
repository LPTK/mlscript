// Abstract checking must not contaminate results at concrete calling activations.
:expect [3, 4]
fun identity[A](x: A): A = x
[identity(Item(3)).a, identity[Item](Item(4)).a]
//│ = [3, 4]

// A private generic body is checked even without local instantiations.
:e
