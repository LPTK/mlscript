:..


:sr
class Foo(val a)(val b) {
  val c = a + b
}
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   class Foo⁰(val a⁰)(val b⁰) {
//│     val a¹ ‹flow:a⁰› = a⁰,
//│     val b¹ ‹flow:b⁰› = b⁰,
//│     val c⁰ ‹flow:c⁰› = +(⟨Foo.⟩a¹^Foo⁰, ⟨Foo.⟩b¹^Foo⁰)‹app⁰›
//│   }
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sr
let f = new Foo
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   let f⁰, f⁰ = new Foo
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ f = fun f

let mk = f(1)
//│ mk = fun

:sr
mk(2)
//│ ————————————————| Resolved |————————————————————————————————————————————————————————————————————————
//│   mk⁰(2)‹app¹›
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Foo(1)

