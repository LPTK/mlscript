//│ Blk:
//│   res = Sel{targets=[ObjectMember(member:Bar)]}:
//│     prefix = Ref{sym=member:Foo⁰} of member:Foo⁰
//│     nme = Ident of "Bar"

// :de
:elt
Foo.Bar.id
//│ —————————————| Elaborated tree |————————————————————————————————————————————————————————————————————
