val x = mut []
let n = 20000
let i = 0
while i < n do
  x.push of () => i
  set i += 1
fun sumOf(x, idx, acc) =
  if idx == 0 then acc
  else 
    sumOf(x, idx - 1, acc + x![idx]())
sumOf(x, n - 1, 0)
