// Check that spreads are compiled correctly

fun f(x, ...z) =
  if x < 0 then 0
  else g(x, 0, x, x)
fun g(x, y, ...z) =
  if x < 0 then 0
  else f(x - 1, 0, ...[x, x, x])
f(100)
//│ = 0

fun f(n, x, y, z) =
  if n > 0 then @tailcall f(n - 1, ...[1, 2], 3) else y
