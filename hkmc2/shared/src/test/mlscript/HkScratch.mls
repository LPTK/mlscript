open scope { locally }


:sir
:soir
// :dopt
let x = 1
x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; +⁰(x⁰, 2)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; +⁰(x⁰, 2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3
//│ x = 1

// :dopt
:soir
x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


:sir
:soir
+1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ +⁰(1)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ +⁰(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sir
:soir
fun main =
  let x = 1
  x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { let x; set x = 1; return +⁰(x, 2) }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { let x; set x = 1; return +⁰(x, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
:soir
// :dopt
fun main =
  let
    x = 1
    y = x
  y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { let x, y; set x = 1; set y = x; return y }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { let x; set x = 1; return x }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// FIXME: why is `x` treated as exported? -> Seems this parses as `let x = 1, let y = x in y`
:soir
// :dopt
let
  x = 1
  y = x
  in y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹; set x¹ = 1; x¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1


:soir
// :dopt
let x = if maybe then 1 else 1
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², scrut, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 1;
//│     end
//│ set x² = tmp;
//│ Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

:soir
// :dopt
let x = if maybe then 1 else 1
in print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     Predef⁰.print⁰(tmp)
//│   else
//│     set tmp = 1;
//│     Predef⁰.print⁰(tmp)
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1

