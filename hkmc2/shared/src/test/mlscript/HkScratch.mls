// :dopt
:soir
let {x,y}
x = y
y = x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁵, y⁰; set x⁵ = y⁰; set y⁰ = undefined; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined

:dopt
:soir
let {x,y,z}
x = y
y = z
z = x
//│ ⬤ Simplif. iter. 1
//│ Assigned x⁶ := Vector(Ref(y,None))
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁶, y¹, z⁰; set x⁶ = y¹; set y¹ = z⁰; set z⁰ = undefined; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined
//│ z = undefined

:dopt
:soir
let {x,y,z}
x = y
y = x
z = y
//│ ⬤ Simplif. iter. 1
//│ Assigned x⁷ := Vector(Ref(y,None))
//│ Assigned y² := Vector(Ref(y,None), Ref(x,None))
