let x = 1
x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; +⁰(x⁰, 2)
//│ ⬤ Simplif. iter. 1
//│ Assigned x⁰ := Vector(Lit(IntLit(1)))
//│ !! Change triggered { x⁰ ~> 1 } at BlockSimplifier.scala:451
//│ ▶ VP:
//│ >  let x⁰; set x⁰ = 1; +⁰(1, 2)
//│ ⬤ Simplif. iter. 2
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = 1; +⁰(1, 2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 3
//│ x = 1

