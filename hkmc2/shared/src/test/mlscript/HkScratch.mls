//│       true =>
//│         do Predef⁰.print⁰(x);
//│         set tmp = -⁰(x, 1);
//│         set x = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁶;
//│ define main⁶ as fun main⁷() {
//│   let x;
//│   set x = 2;
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = >⁰(x, 0);
//│     match scrut
//│       true =>
