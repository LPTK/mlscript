:sir
:soir
fun main =
  let x = 1
  x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { let x; set x = 1; return +⁰(x, 2) }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { return +⁰(1, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
:soir
// :dopt
fun main =
  let
    x = 1
    y = x
  y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { let x, y; set x = 1; set y = x; return y }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { return 1 }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// FIXME: why is `x` treated as exported? -> Seems this parses as `let x = 1, let y = x in y`
:soir
// :dopt
let
  x = 1
  y = x
  in y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹; set x¹ = 1; 1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1


