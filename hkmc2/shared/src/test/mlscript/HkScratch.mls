//│       true =>
//│         do Predef⁰.print⁰(x);
//│         set tmp = -⁰(x, 1);
//│         set x = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
