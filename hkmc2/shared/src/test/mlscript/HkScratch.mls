fun main =
  let
    x = 1
    y = x
    z = y
  y + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁴;
//│ define main⁴ as fun main⁵() { let x, y, z; set x = 1; set y = x; set z = y; return +⁰(y, 2) };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁴; define main⁴ as fun main⁵() { return +⁰(1, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sir
:soir
// :dopt
fun main =
  let x = 2
  while x > 0 do
    print(x)
    set x -= 1
main
