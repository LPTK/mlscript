//│ >    true =>
//│ >      set y⁰ = 1;
//│ >      set tmp = 1;
//│ >      end
//│ >    else
//│ >      set z⁰ = 2;
//│ >      set tmp = 2;
//│ >      end
//│ >  set x⁵ = tmp;
//│ >  Predef⁰.print⁰(tmp)
//│ ⬤ Simplif. iter. 2
//│ !! Change triggered { rm y⁰ = 1 } at BlockSimplifier.scala:238
//│ !! Change triggered { rm z⁰ = 2 } at BlockSimplifier.scala:238
//│ ▶ DCE:
//│ >  let x⁵, scrut, tmp;
//│ >  set scrut = Predef⁰.maybe⁰;
//│ >  match scrut
//│ >    true =>
//│ >      set tmp = 1;
//│ >      end
//│ >    else
//│ >      set tmp = 2;
//│ >      end
//│ >  set x⁵ = tmp;
//│ >  Predef⁰.print⁰(tmp)
//│ ?? tmp:tmp⁰ Some(Vector(Lit(IntLit(1)), Lit(IntLit(2)))) true false
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ ?? tmp:tmp⁰ Some(Vector(Lit(IntLit(1)), Lit(IntLit(2)))) true false
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
