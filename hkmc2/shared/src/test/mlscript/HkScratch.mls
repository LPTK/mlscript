//│ };
//│ main⁷()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 1


// :dopt
:soir
let {x,y}
x = y
y = x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹, y⁰; set x¹ = y⁰; set y⁰ = x¹; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined

:dopt
:soir
let {x,y,z}
x = y
y = z
z = x
//│ ⬤ Simplif. iter. 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², y¹, z⁰; set x² = y¹; set y¹ = z⁰; set z⁰ = x²; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined
//│ z = undefined

:dopt
:soir
let {x,y,z}
x = y
y = x
z = y
//│ ⬤ Simplif. iter. 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x³, y², z¹; set x³ = y²; set y² = x³; set z¹ = y²; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined
//│ z = undefined



