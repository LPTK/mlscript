:sir
:soir
() =>
  let f
  if maybe is
    false then 0
    true then
      scope.locally of (
        let x = hide(0)
        f = foo(x)
      )
  print of
    "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello", "Hello"
  f(2)
