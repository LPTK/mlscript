:soir
// :dopt
let x = if maybe
  then
    let y = 1
    y
  else
    let z = 1
    z
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁴, scrut, y⁰, z⁰, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set y⁰ = 1;
//│     set tmp = y⁰;
//│     end
//│   else
//│     set z⁰ = 1;
//│     set tmp = z⁰;
//│     end
//│ set x⁴ = tmp;
//│ Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

