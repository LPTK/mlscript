//│ let Foo⁰; define Foo⁰ as class Foo¹ { constructor Foo² }; return Foo²()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Foo()


@inline
fun test() =
  class Foo()
  Foo()

:sir
:soir
:olot
test()
