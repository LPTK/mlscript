//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set x³ = tmp;
//│ Predef⁰.print⁰(x³)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1




