:sir
:soir
fun main =
  let x = 1
  x + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { let x; set x = 1; return +⁰(x, 2) }; end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁰; define main⁰ as fun main¹() { return +⁰(1, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
:soir
:dopt
fun main =
  let
    x = 1
    y = x
  y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { let x, y; set x = 1; set y = x; return y }; end
//│ ⬤ Simplif. iter. 1
//│ Assigned x¹ := Vector(Lit(IntLit(1)))
//│ !! Change triggered { x¹ ~> 1 } at BlockSimplifier.scala:451
//│ Assigned y⁰ := Vector(Lit(IntLit(1)), Ref(x,None))
//│ !! Change triggered { y⁰ ~> 1 } at BlockSimplifier.scala:451
//│ ▶ VP:
//│ >  let main²; define main² as fun main³() { let x, y; set x = 1; set y = 1; return 1 }; end
//│ ⬤ Simplif. iter. 2
//│ !! Change triggered { rm x¹ = 1 } at BlockSimplifier.scala:209
//│ !! Change triggered { rm y⁰ = 1 } at BlockSimplifier.scala:209
//│ ▶ DCE:
//│ >  let main²; define main² as fun main³() { return 1 }; end
//│ ⬤ Simplif. iter. 3
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main²; define main² as fun main³() { return 1 }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:soir
:dopt
let x = if maybe then 1 else 1
print(x)
//│ ⬤ Simplif. iter. 1
//│ Assigned tmp:tmp⁰ := Vector(Lit(IntLit(1)), Lit(IntLit(1)))
//│ !! Change triggered { tmp:tmp⁰ ~> 1 } at BlockSimplifier.scala:451
//│ Assigned x² := Vector(Lit(IntLit(1)), Lit(IntLit(1)), Ref(tmp:tmp,None))
//│ !! Change triggered { x² ~> 1 } at BlockSimplifier.scala:451
//│ ▶ VP:
//│ >  let x², scrut, tmp;
//│ >  set scrut = Predef⁰.maybe⁰;
//│ >  match scrut
//│ >    true =>
//│ >      set tmp = 1;
//│ >      end
//│ >    else
//│ >      set tmp = 1;
//│ >      end
//│ >  set x² = 1;
//│ >  Predef⁰.print⁰(1)
//│ ⬤ Simplif. iter. 2
//│ !! Change triggered { rm tmp:tmp⁰ = 1 } at BlockSimplifier.scala:209
//│ !! Change triggered { rm tmp:tmp⁰ = 1 } at BlockSimplifier.scala:209
//│ ▶ DCE:
//│ >  let x², scrut; set scrut = Predef⁰.maybe⁰; set x² = 1; Predef⁰.print⁰(1)
//│ ⬤ Simplif. iter. 3
//│ !! Change triggered { rm tmp:scrut⁰ = Select(member:Predef¹‹module:Predef⁰›, Ident(maybe)) } at BlockSimplifier.scala:209
//│ ▶ DCE:
//│ >  let x²; do Predef⁰.maybe⁰; set x² = 1; Predef⁰.print⁰(1)
//│ ⬤ Simplif. iter. 4
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x²; do Predef⁰.maybe⁰; set x² = 1; Predef⁰.print⁰(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

