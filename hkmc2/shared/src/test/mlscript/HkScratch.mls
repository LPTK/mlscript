:soir
// :dopt
let x = if maybe then 1 else 2
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², scrut, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set x² = tmp;
//│ Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

:soir
