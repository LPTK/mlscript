//│ let x⁷, y², z¹; set x⁷ = y²; set y² = undefined; set z¹ = undefined; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = undefined
//│ y = undefined
//│ z = undefined



