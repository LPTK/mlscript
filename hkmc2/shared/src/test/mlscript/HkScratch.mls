:sir
:soir
fun main =
  let
    x = 1
    y = x
    z = y
  y + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁴;
//│ define main⁴ as fun main⁵() { let x, y, z; set x = 1; set y = x; set z = y; return +⁰(y, 2) };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁴; define main⁴ as fun main⁵() { return +⁰(1, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sir
:soir
// :dopt
fun main =
  let x = 2
  while x > 0 do
    print(x)
    set x -= 1
main
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁶;
//│ define main⁶ as fun main⁷() {
//│   let x;
//│   set x = 2;
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = >⁰(x, 0);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰(x);
//│         set tmp = -⁰(x, 1);
//│         set x = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁶;
//│ define main⁶ as fun main⁷() {
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = >⁰(tmp, 0);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰(tmp);
//│         set tmp = -⁰(tmp, 1);
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

