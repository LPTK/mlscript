:soir
// :dopt
let x = if maybe
  then
    let y = 1
    y
  else
    let z = 1
    z
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁴; do Predef⁰.maybe⁰; set x⁴ = 1; Predef⁰.print⁰(1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

:soir
:dopt
let x = if maybe
  then
    let y = 1
    y
  else
    let z = 2
    z
print(x)
//│ ⬤ Simplif. iter. 1
//│ Assignments of y⁰: Vector(Lit(IntLit(1)))
//│ !! Change triggered { y⁰ ~> 1 } at BlockSimplifier.scala:499
//│ Assignments of z⁰: Vector(Lit(IntLit(2)))
//│ !! Change triggered { z⁰ ~> 2 } at BlockSimplifier.scala:499
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ Assignments of x⁵: Vector(Ref(tmp:tmp,None))
//│ !! Change triggered { x⁵ ~> tmp:tmp⁰ } at BlockSimplifier.scala:499
//│ ▶ VP:
//│ >  let x⁵, scrut, y⁰, z⁰, tmp;
//│ >  set scrut = Predef⁰.maybe⁰;
//│ >  match scrut
//│ >    true =>
//│ >      set y⁰ = 1;
//│ >      set tmp = 1;
//│ >      end
//│ >    else
//│ >      set z⁰ = 2;
//│ >      set tmp = 2;
//│ >      end
//│ >  set x⁵ = tmp;
//│ >  Predef⁰.print⁰(tmp)
//│ ⬤ Simplif. iter. 2
//│ !! Change triggered { rm y⁰ = 1 } at BlockSimplifier.scala:209
//│ !! Change triggered { rm z⁰ = 2 } at BlockSimplifier.scala:209
//│ ▶ DCE:
//│ >  let x⁵, scrut, tmp;
//│ >  set scrut = Predef⁰.maybe⁰;
//│ >  match scrut
//│ >    true =>
//│ >      set tmp = 1;
//│ >      end
//│ >    else
//│ >      set tmp = 2;
//│ >      end
//│ >  set x⁵ = tmp;
//│ >  Predef⁰.print⁰(tmp)
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ ⬤ Simplif. iter. 3
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ Assignments of tmp:tmp⁰: Vector(Lit(IntLit(1)), Lit(IntLit(2)))
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁵, scrut, tmp;
//│ set scrut = Predef⁰.maybe⁰;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set x⁵ = tmp;
//│ Predef⁰.print⁰(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1



:sir
:soir
fun main =
  let
    x = 1
    y = x
    z = y
  y + 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁴;
//│ define main⁴ as fun main⁵() { let x, y, z; set x = 1; set y = x; set z = y; return +⁰(y, 2) };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁴; define main⁴ as fun main⁵() { return +⁰(1, 2) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sir
:soir
// :dopt
fun main =
  let x = 2
  while x > 0 do
    print(x)
    set x -= 1
main
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let main⁶;
//│ define main⁶ as fun main⁷() {
//│   let x;
//│   set x = 2;
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = >⁰(x, 0);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰(x);
//│         set tmp = -⁰(x, 1);
//│         set x = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ /!\ Warning: object identity between equal objects was not preserved by BlockSimplifier
//│ /!\ Offending subblock: Assign:
//│   lhs = x⁶
//│   rhs = Ref:
//│     l = tmp:tmp¹
//│   rest = Continue of label:lbl⁰
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let main⁶;
//│ define main⁶ as fun main⁷() {
//│   let x;
//│   set x = 2;
//│   loop lbl:
//│     let scrut, tmp;
//│     set scrut = >⁰(x, 0);
//│     match scrut
//│       true =>
//│         do Predef⁰.print⁰(x);
//│         set tmp = -⁰(x, 1);
//│         set x = tmp;
//│         continue lbl
//│       else
//│         end
//│     end
//│   return runtime⁰.Unit⁰
//│ };
//│ main⁷()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 1

// :exit
// ====================================================================================================


