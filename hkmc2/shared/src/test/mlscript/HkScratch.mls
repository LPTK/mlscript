:soir
fun foo(x)(y) = x + y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let foo⁰; @inline define foo⁰ as fun foo¹(x)(y) { return +⁰(x, y) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


:sir
:soir
let f
if true then
  let x = hide(0)
  f = foo(x)
f(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f⁰, scrut, x⁰, tmp;
//│ set scrut = true;
//│ match scrut
//│   true =>
//│     begin
//│       set x⁰ = Predef⁰.hide⁰(0);
//│       set f⁰ = foo¹(x⁰);
//│       set tmp = runtime⁰.Unit⁰;
//│       end;
//│     return f⁰(2)
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰, x⁰;
//│ match true
//│   true =>
//│     set x⁰ = Predef⁰.hide⁰(0);
//│     set f⁰ = foo¹(x⁰);
//│     return +⁰(x⁰, 2)
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2
//│ f = fun


:sir
:soir
fun bar =
  let f
  let i = 2
  while i > 0 do
    set i -= 1
    let x = hide(i)
    f = foo(x)
  else throw 0
  f(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
