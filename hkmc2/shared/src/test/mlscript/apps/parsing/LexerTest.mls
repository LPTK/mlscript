//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `if` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `x` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `<=` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "1" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `then` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "1" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `else` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `x` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `*` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `factorial` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `(` at 1:1-1:1
//│ > identifier `x` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `-` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "1" at 1:1-1:1
//│ > identifier `)` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `let` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `bool_of_string` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `=` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `function` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `|` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "true" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `->` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > boolean "true" at 1:1-1:1
