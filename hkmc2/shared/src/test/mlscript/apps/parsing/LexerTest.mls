:js

import "../../../mlscript-compile/apps/parsing/Lexer.mls"
import "../../../mlscript-compile/apps/parsing/Token.mls"
import "../../../mlscript-compile/Stack.mls"
import "../../../mlscript-compile/Iter.mls"

fun lines(...strs) = strs.join("\n")

open Lexer { lex }
open Stack

fun printLexed(text) = print of
  lex(text, false)
    Iter.fromStack()
    Iter.mapping of Token.display
    Iter.joined of "\n"

printLexed of "0 1  0xDEADCAFE 0b1101 0o755     3.1415926535"
//│ > integer "0" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "1" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "0xDEADCAFE" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "0b1101" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "0o755" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > decimal "3.1415926535" at 1:1-1:1

// Good strings.
printLexed of """
"hello, world"
"\x48\x65\x6C\x6C\x6F\x2C\x20\x77\x6F\x72\x6C\x64"
"\u0048\u0065\u006C\u006C\u006F\u002C\u0020\u0077\u006F\u0072\u006C\u0064"
"\u{48}\u{65}\u{6C}\u{6C}\u{6F}\u{2C}\u{20}\u{77}\u{6F}\u{72}\u{6C}\u{64}"
"\u{1F600}" // 😀
"\u{1F601}" // 😁
"\u{1F602}" // 😂
"\u{1F603}" // 😃
"\u{1F604}" // 😄
"\n\r\t\b"
"""
//│ > space at 1:1-1:1
//│ > string "hello, world" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "Hello, world" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "Hello, world" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "Hello, world" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "😀" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "😁" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "😂" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "😃" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "😄" at 1:1-1:1
//│ > space at 1:1-1:1
//│ > comment at 1:1-1:1
//│ > space at 1:1-1:1
//│ > string "\n\r\t\b" at 1:1-1:1
//│ > space at 1:1-1:1

// Ill-formed Strings
// ==================

printLexed of """
"hello, world.   """
//│ > space at 1:1-1:1
//│ > string "hello, world.   " at 1:1-1:1

printLexed of """
"hello, \world"""
//│ > space at 1:1-1:1
//│ > string "hello, world" at 1:1-1:1

printLexed of """let v' =
  let a, b = (1, 2) in a + b"""
//│ > identifier `let` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `v'` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `=` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `let` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `a` at 1:1-1:1
//│ > identifier `,` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `b` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `=` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `(` at 1:1-1:1
//│ > integer "1" at 1:1-1:1
//│ > identifier `,` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > integer "2" at 1:1-1:1
//│ > identifier `)` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `in` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `a` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `+` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `b` at 1:1-1:1

printLexed of lines of
  "let rec factorial x = // a simple factorial function"
  "  if x <= 1 then 1 else x * factorial (x - 1)"
  ""
  "let bool_of_string = function"
  "  | \"true\" -> true"
  "  | \"false\" -> false"
  "  | _ -> raise (Invalid_argument \"bool_of_string\")"
//│ > identifier `let` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `rec` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `factorial` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `x` at 1:1-1:1
//│ > space at 1:1-1:1
//│ > identifier `=` at 1:1-1:1
