:js

import "../../mlscript-compile/Stack.mls"

open Stack


let
  s1 = 1 :: 2 :: 3 :: Nil
  s2 = "a" :: "b" :: "c" :: Nil
  s3 = true :: false :: Nil
//│ s1 = Cons(1, Cons(2, Cons(3, Nil)))
//│ s2 = Cons("a", Cons("b", Cons("c", Nil)))
//│ s3 = Cons(true, Cons(false, Nil))


// *** Concat ***

// * Note that concatenation internally uses mutation, but it freezes the result

let s12 = s1 ::: s2
