:js
// :de
// :sjs
// :pt
// :elt

import "../../mlscript-compile/ListFingerTree.mls"

open ListFingerTree

let xs = ListFingerTree.mk(1,2,3)
//│ xs = Deep(3, [1], Empty, [2, 3])


let ys = concat(concat(xs, xs), xs)
//│ ys = Deep(9, [1], Deep(6, [Branch3(3, 2, 3, 1)], Empty, [Branch3(3, 2, 3, 1)]), [2, 3])

ys |> ith(-1)
//│ = None
ys |> ith(0)
//│ = Some(1)
ys |> ith(1)
//│ = Some(2)
ys |> ith(2)
//│ = Some(3)
ys |> ith(3)
//│ = Some(1)
ys |> ith(4)
//│ = Some(2)
ys |> ith(5)
//│ = Some(3)
ys |> ith(6)
//│ = Some(1)
ys |> ith(7)
//│ = Some(2)
ys |> ith(8)
//│ = Some(3)
ys |> ith(9)
//│ = None

let ys = (ys |> popFront).rest
//│ ys = Deep(8, [2, 3, 1], Single(Branch3(3, 2, 3, 1)), [2, 3])
let ys = (ys |> popBack).rest
//│ ys = Deep(7, [2, 3, 1], Single(Branch3(3, 2, 3, 1)), [2])
let ys = (ys |> popBack).rest
//│ ys = Deep(6, [2, 3, 1], Empty, [2, 3, 1])
let ys = (ys |> popBack).rest
//│ ys = Deep(5, [2, 3, 1], Empty, [2, 3])
let ys = (ys |> popFront).rest
//│ ys = Deep(4, [3, 1], Empty, [2, 3])
let ys = (ys |> popFront).rest
//│ ys = Deep(3, [1], Empty, [2, 3])
let ys = (ys |> popFront).rest
//│ ys = Deep(2, [2], Empty, [3])

let ys = concat(concat(xs, xs), xs)
//│ ys = Deep(9, [1], Deep(6, [Branch3(3, 2, 3, 1)], Empty, [Branch3(3, 2, 3, 1)]), [2, 3])

// TODO: implement & test slice
ys |> slice(4, 6)
//│ = Deep(2, [2], Empty, [3])

