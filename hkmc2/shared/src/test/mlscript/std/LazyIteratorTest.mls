let N = 100
//│ N = 100

:silent
:clock 38efae2
let res = buildLazy(N)
//+ runtime clock time (38efae2): 5.020277 ms

:clock 38efae2
res |> funnySum
//+ runtime clock time (38efae2): 6545.894299 ms
//│ = 0

:clock 38efae2
res |> funnySumEager
//+ runtime clock time (38efae2): 6927.663678 ms
//│ = 0

:silent
:clock 38efae2
let res = buildEager(N)
//+ runtime clock time (38efae2): 10.470947 ms

:silent
:clock 38efae2
let res = [...buildLazy(N)]
//+ runtime clock time (38efae2): 15.647328 ms

:clock 38efae2
res |> funnySum
//+ runtime clock time (38efae2): 20.344103 ms
//│ = 0

:clock 38efae2
res |> funnySumEager
//+ runtime clock time (38efae2): 1.368807 ms
//│ = 0

LazyIterator.mk(1,2,3).concat([11, 12, 13], ListFingerTree.mk(2, 4, 6, 8, 10))
//│ = [1, 2, 3, 11, 12, 13, 2, 4, 6, 8, 10]

let xs = [1, 2]
//│ xs = [1, 2]

:sjs
fun intersperse = case
  [a, ..rest] then
    [a + 1, ..intersperse(rest)]
  [] then []
//│ JS (unsanitized):
//│ let intersperse;
//│ intersperse = function intersperse() {
//│   let lambda;
//│   lambda = (undefined, function (caseScrut) {
//│     let rest2, first02, a2, rest3, tmp13, tmp14, tmp15;
//│     if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length >= 1) {
//│       first02 = caseScrut.at(0);
//│       rest2 = runtime.safeCall(runtime.Tuple.lazySlice(caseScrut, 1, 0));
//│       a2 = first02;
//│       rest3 = rest2;
//│       tmp13 = a2 + 1;
//│       tmp14 = intersperse();
//│       tmp15 = tmp14(rest3);
//│       return runtime.Tuple.lazyConcat(tmp13,
//│       runtime.Tuple.split, tmp15)
//│     } else if (runtime.Tuple.isArrayLike(caseScrut) && caseScrut.length === 0) {
//│       return []
//│     } else {
//│       throw new globalThis.Error("match error");
//│     }
//│   });
//│   return lambda
//│ };

