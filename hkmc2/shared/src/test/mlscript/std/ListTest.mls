// TODO should have lazy spread semantics
[0, ..xs]
//│ = [0, 1, 2, 3]

// TODO should have lazy spread semantics
if xs  is
  [a, ..ls] then [a, ls]
//│ = [1, [2, 3]]


fun build(i) =
  if i > 0 then [i, ..build(i - 1), -i] else []

let res = build(4)
//│ res = [4, 3, 2, 1, -1, -2, -3, -4]

res |> ith(3)
//│ = 1

fun funnySum(xs) = if xs is
  [a, ..ls, b] then a + funnySum(ls) - b
  [] then 0

res |> funnySum
//│ = 20


