fun go(stack, input) = if stack is
  [..rest, Expr as e1, "+", Expr as e2] then
    go([..rest, Op(e1, "+", e2)], input)
  [..rest, Ident as id] then
    go([..rest, Id(id)], input)
  do print("not Ident", stack)
  do print("not Ident??", stack is [..stack, Ident as id])
  do print("Str?", stack.at(-1), stack.at(-1) is Str)
  do print("Str??", stack is [..stack, Str as id])
  [Expr as res] and input is [] then
    Success: res
  _ and input is
    [tok, ..input] then
      go([..stack, tok], input)
    [] then
      Error: stack
