data class Triplet[A, B, C](first: A, second: B, third: C)

pattern ExactlyOneNone =
  | Triplet(None,    Some(_), Some(_))
  | Triplet(Some(_), None,    Some(_))
  | Triplet(Some(_), Some(_), None   )

fun exactlyOneNone(x) =
  if x is (@compile ExactlyOneNone) as output then output else "failed"

fun exactlyOneNone__naive(x) =
  if x is ExactlyOneNone(output) then output else "failed"

// For transform-free compiled patterns, we can now reuse the original
// scrutinee as the output instead of synthesizing a plain record.

exactlyOneNone of Triplet(None, Some(1), Some(2))
