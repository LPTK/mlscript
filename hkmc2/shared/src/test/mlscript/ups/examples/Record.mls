// This pattern is useful because it turns a pattern into a function that
// returns `Some` if the pattern matches, and `None` otherwise.
pattern MatchOrNone(pattern P) = ((P as x) => Some(x)) | (_ => None)

fun bmi(record) = if record is MatchOrNone(pattern RoundedBMI) as value then value

:e
// alternatively?
fun bmi'(record) = if record is MatchOrNone[RoundedBMI] as value then value
