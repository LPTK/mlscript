// Convert between different number systems
pattern NumberSystem = 
  (((:digits, radix: "x")) => parseInt(digits, 16)) |
  (((:digits, radix: "o")) => parseInt(digits, 8)) |
  (((:digits, radix: "b")) => parseInt(digits, 2))

:todo // This looks decent! Make this happen!
fun parseIntegerLiteral(value) = if
  value is "0" ~ (("x" | "o" | "b") as radix) ~ digits and
    (:radix, :digits) is NumberSystem as value then Some(value)
  else None
//│ ╔══[ERROR] Cannot use this reference without resolved definition as a pattern
//│ ║  l.158: 	  value is "0" ~ (("x" | "o" | "b") as radix) ~ digits and
//│ ╙──       	                                              ^

pattern IntegerLiteral =
  ("0" ~ (("x" | "o" | "b") as radix) ~ digits) => (:radix, :digits)

fun parseIntegerLiteral(value) = if
  value is IntegerLiteral as output then Some(output)
  else None

parseIntegerLiteral of "0x1234"
//│ = Some({radix: "x", digits: "1234"})

parseIntegerLiteral of "0b0000111100001111"
//│ = Some({radix: "b", digits: "0000111100001111"})

parseIntegerLiteral of "0o673264673"
//│ = Some({radix: "o", digits: "673264673"})

parseIntegerLiteral of "0k1234"
//│ = None
