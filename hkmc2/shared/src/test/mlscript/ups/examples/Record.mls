import "../../../mlscript-compile/Option.mls"

open Option { Some, None }

// Compute Body Mass Index (BMI) from weight (kg) and height (m)
pattern CalculateBMI = ((:weight, :height)) => weight / (height * height)

pattern Rounded = (Num as value) => Math.round(value)

:todo // This looks decent! Make this happen!
// Note: This needs refactoring the desugarer.
(weight: 70, height: 1.75) is CalculateBMI as Rounded(22)
//│ ╔══[ERROR] Unrecognized pattern (infix operator 'as')
//│ ║  l.16: 	(weight: 70, height: 1.75) is CalculateBMI as Rounded(22)
//│ ╙──      	                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = false

pattern RoundedBMI = CalculateBMI as Rounded

fun bmi(record) = if record is RoundedBMI as value then value

bmi of weight: 70, height: 1.75
//│ = 23

:re
bmi of weight: 70
