object ByName with
  // Call-by-name allows reducing any beta redex. The argument `n` may be any
  // term, not necessarily a value.
  pattern Redex = App(Abs(Var(x), m), Term as n) => subst(m, x, n)
  
  // Call-by-name evaluation contexts
  //
  // E ::= □
  //     | E t
  pattern Context(pattern Hole) =
    (
      (Hole as hole) => [hole, id]
    ) | (
      App(Context(Hole) as [lhs, remake], Term as rhs) =>
        [lhs, lhs' => App(remake(lhs'), rhs)]
    )

