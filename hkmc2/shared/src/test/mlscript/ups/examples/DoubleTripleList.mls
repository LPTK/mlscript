fun list(...elements) = elements Iter.toStack()

// The example of lists whose length is a multiple of two.

// Note that the parentheses are necessary.
pattern DoubleList = Nil | (Int :: Int :: DoubleList)

list(1, 2, 3, 4) is DoubleList
//│ = true

list(1, 2, 3) is DoubleList
//│ = false

Nil is DoubleList
//│ = true

fun isDoubleList(xs) = xs is @compile DoubleList

