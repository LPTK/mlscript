fun go(stack) =
  // print(stack)
  if stack is...
  ((Ident as name) :: rest)
    then go of Id(name) :: rest
  ((Expr as e1) :: "+" :: (Expr as e2) :: rest)
    then go of Op(e1, "+", e2) :: rest
  ((Expr as e1) :: "+" :: rest)
    then go of e1 :: "+" :: go of rest
  ("(" :: (Expr as e) :: ")" :: rest) then
    go of e :: rest
  ("(" :: rest) then
    go of "(" :: go of rest
  _ then
    stack
