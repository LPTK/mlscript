:js

open annotations { compile }

data class Pair[A, B](val first: A, val second: B)

pattern Null = null

[null is Null, 0 is Null, false is Null]
//│ = [true, false, false]

pattern Tree = Null | Pair(Tree, Tree)

fun (##) concat(a, b) = Pair(a, b)

0 ## 1
//│ = Pair(0, 1)

