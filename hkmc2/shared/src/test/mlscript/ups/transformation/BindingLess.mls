//│     at REPLServer.emit (node:domain:488:12)
//│     at [_onLine] [as _onLine] (node:internal/readline/interface:416:12)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: processIRBlock (JSBackendDiffMaker.scala:289)
//│ ═══[RUNTIME ERROR] Expected: 'false', got: 'undefined'

fun foo(p) = if p is (@compile IncFst) as q then q else p

:expect true
ps == foo(ps)
//│ = true

:expect false
pi == foo(pi)
//│ FAILURE: Unexpected runtime error
//│ FAILURE LOCATION: mkQuery (JSBackendDiffMaker.scala:250)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of undefined (reading '2')
