fun get_output_using_as'(value) = if value is
  (@compile BoolLike) as b then print("" + value + " is equivalent to " + b)
  else print("the input " + value + " is not a boolean")
//│ ╔══[ERROR] Name not found: BoolLike
//│ ║  l.32: 	  (@compile BoolLike) as b then print("" + value + " is equivalent to " + b)
//│ ╙──      	            ^^^^^^^^

get_output_using_as' of true
get_output_using_as' of false
get_output_using_as' of 0
get_output_using_as' of 1
get_output_using_as' of 2
//│ > the input true is not a boolean
//│ > the input false is not a boolean
//│ > the input 0 is not a boolean
//│ > the input 1 is not a boolean
//│ > the input 2 is not a boolean

fun get_output_through_param(value) = if value is
  BoolLike(b) then print("" + value + " is equivalent to " + b)
  else print("the input " + value + " is not a boolean")
//│ ╔══[ERROR] Name not found: BoolLike
//│ ║  l.50: 	  BoolLike(b) then print("" + value + " is equivalent to " + b)
