//│ ═══[RUNTIME ERROR] Expected: '[true, false, false, true]', got: 'undefined'

fun isTruthy(value) = value is @compile Truthy

fun isFalsy(value) = value is @compile Falsy

fun isTruthy'(value) = value is Truthy

fun isFalsy'(value) = value is Falsy

:global
:expect true

