:w
fun foo(x) =
  class C(y) with
    fun get = [x, y]
  module C with
    val empty = C(123)
  C.empty
foo(10).get
//│ ═══[WARNING] Modules are not yet lifted.
//│ = [10, 123]

:w
fun foo(x) =
  class C with
    fun get = x
  module C with
    val empty = new C
  C.empty
foo(10).get
//│ ═══[WARNING] Modules are not yet lifted.
//│ = 10
