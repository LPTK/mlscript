//│     define y⁰ as val y¹ = y;
//│     end
//│   }
//│   method getB⁰ = fun getB¹() {
//│     return +⁰(A¹.this.x⁰, B².this.y¹)
//│   }
//│ };
//│ @data
//│ define A⁰ as class A¹ {
