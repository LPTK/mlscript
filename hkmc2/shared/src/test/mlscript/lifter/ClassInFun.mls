:expect 10111
:sjs
fun f() =
  let x = 1
  let y = 10
  let z = 10
  let w = 1000
  class Good() with
    fun foo() =
      set z = 100
      x + y + z + w
  class Bad() with
    fun foo() =
      set w = 10000
  Bad().foo()
  Good()
