class Foo with
  fun foo =
    new with
      let state = 0
      fun test =
        set state += 1
        state

let f = new Foo
//│ f = Foo

let o = f.foo
//│ o = $anon

o.test
//│ = 1

:expect 2
o.test
//│ = 2

:expect 1
f.foo.test
//│ = 1


