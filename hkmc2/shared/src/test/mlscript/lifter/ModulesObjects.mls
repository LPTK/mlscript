:lift
:js


// * Lifting an object may require it to gain some mutable fields

fun foo(x, y) =
  object M with
    val test = 2
    fun foo() =
      set y = 2
      x + y + test
  M.foo()

:expect 14
foo(10, 0)
//│ = 14

// * This works the same with classes.
// * Note that we currently generate accessors, which is not ideal;
// * When the captures are not accessed from the outside, we should be able to drop these.
:sjs
fun foo(y) =
  class M with
    fun foo() =
      set y = 2
  (new M).foo()
foo(10)
//│ JS (unsanitized):
//│ let M3, foo1, M$;
//│ M$ = function M$(isMut, y$0) {
//│   let tmp;
//│   if (isMut === true) {
//│     tmp = new M3(y$0);
//│   } else {
//│     tmp = globalThis.Object.freeze(new M3(y$0));
//│   }
//│   return tmp
//│ };
//│ globalThis.Object.freeze(class M2 {
//│   static {
//│     M3 = this
//│   }
//│   constructor(y$0) {
//│     this.y$0 = y$0;
//│   }
//│   #y$0;
//│   get y$0() { return this.#y$0; }
//│   set y$0(value) { this.#y$0 = value; }
//│   foo() {
//│     this.y$0 = 2;
//│     return runtime.Unit
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ });
//│ foo1 = function foo(y) { let tmp; tmp = M$(false, y); return runtime.safeCall(tmp.foo()) };
//│ foo1(10)


// * `new mut` (or lack thereof) should be preserved by the lifter

fun foo(y) =
  class C with
    fun foo() =
      set y = 2
  [new C, new mut C]

let
  cc = foo(10)
  c0 = cc.0
  c1 = cc.1
//│ c0 = C
//│ c1 = C
//│ cc = [C, C]

:re
set c0.x = 1
c0.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'

set c1.x = 1
c1.x
//│ = 1


// * Objects should remain non-`new mut`

fun foo(y) =
  object O with
    fun foo() =
      set y = 2
  O

let o = foo(10)
//│ o = O

:re
set o.x = 1
o.x
//│ ═══[RUNTIME ERROR] Error: Access to required field 'x' yielded 'undefined'


:sjs
fun foo(x, y) =
  object M with
    fun foo2() =
      set y = 2
      x + y
  fun foo3 = M.foo2()
  foo3
//│ JS (unsanitized):
//│ let M5, foo31, foo4, foo3$, foo$capture3;
//│ foo3$ = function foo3$(M6, x, foo$capture4) {
//│   return M6.foo2()
//│ };
//│ foo31 = function foo3(M6, x, foo$capture4) {
//│   return () => {
//│     return foo3$(M6, x, foo$capture4)
//│   }
//│ };
//│ globalThis.Object.freeze(class M4 {
//│   static {
//│     M5 = this
//│   }
//│   constructor(x$1, foo$capture$0) {
//│     this.foo$capture$0 = foo$capture$0;
//│     this.x$1 = x$1;
//│   }
//│   #foo$capture$0;
//│   #x$1;
//│   get foo$capture$0() { return this.#foo$capture$0; }
//│   set foo$capture$0(value) { this.#foo$capture$0 = value; }
//│   get x$1() { return this.#x$1; }
//│   set x$1(value) { this.#x$1 = value; }
//│   foo2() {
//│     this.foo$capture$0.y0$ = 2;
//│     return this.x$1 + this.foo$capture$0.y0$
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ });
//│ globalThis.Object.freeze(class foo$capture2 {
//│   static {
//│     foo$capture3 = this
//│   }
//│   constructor(y0$) {
//│     this.y0$ = y0$;
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "foo$capture"]; 
//│ });
//│ foo4 = function foo(x, y) {
//│   let tmp2, M$1, capture;
//│   capture = new foo$capture3(y);
//│   M$1 = globalThis.Object.freeze(new M5(x, capture));
//│   tmp2 = foo3$(M$1, x, capture);
//│   return tmp2
//│ };

:expect 12
foo(10, 0)
//│ = 12


:sjs
data class A(x) with
  object M with
    fun getB() = x
  fun getA() = M.getB()
//│ JS (unsanitized):
//│ let M7, A1;
//│ globalThis.Object.freeze(class M6 {
//│   static {
//│     M7 = this
//│   }
//│   constructor(A$instance$0) {
//│     this.A$instance$0 = A$instance$0;
//│   }
//│   #A$instance$0;
//│   get A$instance$0() { return this.#A$instance$0; }
//│   set A$instance$0(value) { this.#A$instance$0 = value; }
//│   getB() {
//│     return this.A$instance$0.x
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"]; 
//│ });
//│ A1 = function A(x1) {
//│   return globalThis.Object.freeze(new A.class(x1));
//│ };
//│ globalThis.Object.freeze(class A {
//│   static {
//│     A1.class = this
//│   }
//│   constructor(x) {
//│     this.x = x;
//│     this.M$ = globalThis.Object.freeze(new M7(this));
//│   }
//│   getA() {
//│     return this.M$.getB()
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A", ["x"]]; 
//│ });

:expect 2
A(2).getA()
//│ = 2

// Classes and functions in modules //

