/// Top Level Modules ///

// newA should reference the class symbol
// newA_B should reference the BlockMemberSymbol
:lift
:sjs
module M with
  data class A(x) with
    class B() with
      fun get = x
      fun newA_B(y) = A(y)
    fun newA = A(42)
    fun newB = B()
  0 is A
M.A(2).newB.newA_B(3).newB.get
