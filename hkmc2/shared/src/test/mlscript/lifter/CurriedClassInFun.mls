:lift
:js


:expect 2
fun f(x) =
  class A()() with
    fun newA() = A()()
    fun foo() =
      set x += 1
      x
    fun getX() = x
  A()()
let a = f(0)
a.foo()
let b = a.newA()
b.foo()
a.getX()
//│ = 2
//│ a = A()
//│ b = A()


// * Notice how the capture parameter `f$cap` is inserted before the aux param `z` but after the main param `y`
:sir
fun f(x) =
  class A(val y)(val z) with
    fun newA() = new A(y + 1)(z + 1)
    fun foo() =
      set x += 1
      x
    fun getX() = x
  [new A(x + 1)(x + 2), new A(x + 1), new A, A, A(x + 1), A(x + 1)(x + 2)]
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let A⁰, f⁰, lambda⁰, lambda¹, lambda², Capture$f⁰, lambda$⁰, lambda$¹, A$⁰, lambda$²;
//│ define A$⁰ as fun A$¹(f$cap)(y)(z) {
//│   return new A¹(y)(f$cap)(z)
//│ };
//│ define lambda$¹ as fun lambda$³(f$cap, tmp)(z) {
//│   return lambda³(f$cap, tmp, z)
//│ };
//│ define lambda$² as fun lambda$⁴(f$cap, y)(z) {
//│   return lambda⁴(f$cap, y, z)
//│ };
//│ define lambda² as fun lambda⁴(f$cap, y, z) {
//│   return new A¹(y)(f$cap)(z)
//│ };
//│ define lambda$⁰ as fun lambda$⁵(f$cap)(y) {
//│   return lambda⁵(f$cap, y)
//│ };
//│ define A⁰ as class A¹(y) {
//│   private val f$cap⁰;
//│   val y⁰;
//│   val z⁰;
//│   constructor A²(f$cap)(z) {
//│     set f$cap⁰ = f$cap;
//│     define y⁰ as val y¹ = y;
//│     define z⁰ as val z¹ = z;
//│     end
//│   }
//│   method newA⁰ = fun newA¹() {
//│     let tmp, tmp1;
//│     set tmp = +⁰(A¹.this.y¹, 1);
//│     set tmp1 = +⁰(A¹.this.z¹, 1);
//│     return new A¹(tmp)(f$cap⁰)(tmp1)
//│   }
//│   method foo⁰ = fun foo¹() {
//│     let tmp;
//│     set tmp = +⁰(f$cap⁰.x$0⁰, 1);
//│     set f$cap⁰.x$0 = tmp;
//│     return f$cap⁰.x$0⁰
//│   }
//│   method getX⁰ = fun getX¹() {
//│     return f$cap⁰.x$0⁰
//│   }
//│ };
//│ define lambda⁰ as fun lambda³(f$cap, tmp, z) {
//│   return new A¹(tmp)(f$cap)(z)
//│ };
//│ define lambda¹ as fun lambda⁵(f$cap, y) {
//│   let lambda$here;
//│   set lambda$here = lambda$⁴(f$cap, y);
//│   return lambda$here
//│ };
//│ define Capture$f⁰ as class Capture$f² {
//│   constructor Capture$f¹(x$0) {
//│     define x$0¹ as val x$0⁰ = x$0;
//│     end
//│   }
//│ };
//│ define f⁰ as fun f¹(x) {
//│   let tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, tmp7, tmp8, f$cap, lambda$here, lambda$here1, A$here;
//│   set f$cap = new mut Capture$f²(x);
//│   set tmp = +⁰(f$cap.x$0⁰, 1);
//│   set tmp1 = +⁰(f$cap.x$0⁰, 2);
//│   set tmp2 = new A¹(tmp)(f$cap)(tmp1);
//│   set tmp3 = +⁰(f$cap.x$0⁰, 1);
//│   set tmp4 = +⁰(f$cap.x$0⁰, 1);
//│   set tmp5 = A$¹(f$cap)(tmp4);
//│   set tmp6 = +⁰(f$cap.x$0⁰, 1);
//│   set tmp7 = +⁰(f$cap.x$0⁰, 2);
//│   set tmp8 = new A¹(tmp6)(f$cap)(tmp7);
//│   set lambda$here = lambda$³(f$cap, tmp3);
//│   set lambda$here1 = lambda$⁵(f$cap);
//│   set A$here = A$¹(f$cap);
//│   return [tmp2, lambda$here, lambda$here1, A$here, tmp5, tmp8]
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

let res = f(0)
//│ res = [A(1), fun, fun, fun, fun, A(1)]


:expect [2, 2]
let a = res.0
a.foo()
let b = a.newA()
b.foo()
[a.getX(), b.getX()]
//│ = [2, 2]
//│ a = A(1)
//│ b = A(2)

let mkA1 = res.1
//│ mkA1 = fun

let a1 = mkA1(10)
//│ a1 = A(1)

let a2 = mkA1(20)
//│ a2 = A(1)

:expect [10, 20]
[a1.z, a2.z]
//│ = [10, 20]

let mkA2 = res.2
//│ mkA2 = fun

mkA2(10)(20) !> (_.z |> print)
//│ > 20
//│ = A(10)


res.3(10)(20).foo()
//│ = 3

let a1 = res.4(20)
//│ a1 = A(1)

a1.foo()
//│ = 4

:expect 20
a1.z
//│ = 20

let a2 = res.4(30)
//│ a2 = A(1)

a2.z
//│ = 30

:expect 20
a1.z
//│ = 20

a.getX()
//│ = 4
