// A member that leaves types unwritten is read through its implementation when the receiver has a written class
// type (see ../strictres/DeclaredReceiverMembers.mls). Wasm selects a field by its position in the class that
// resolution found, so the representations of the member's parameters and results must admit all the values
// that such references pass and read.

// The result of `measure` takes the representation of the instances that its body creates.
:noInline
private class Length(val amount)
private class Scale with
  fun measure() = Length(const(5))
private fun readScale(s: Scale) = s.measure().amount
readScale(new Scale)
//│ Wasm result:
//│ = 5

// The call in `recordTyped` passes an instance of `Seconds` to the parameter of `record`. Wasm cannot tell the
// two classes apart, as their layouts are the same: reading `amount` from that instance would yield its `duration`.
:e
:noInline
private class Meters(val amount)
private class Seconds(val duration)
private class Meter with
  mut val last = const(0)
  fun record(x) =
    set last = x.amount
    ()
private fun pick(flag) = if flag then Seconds(const(2)) else Meters(const(1))
private fun recordTyped(m: Meter) =
  m.record(pick(true))
  ()
private fun recordBoth() =
  let meter = new mut Meter
  meter.record(Meters(const(1)))
  recordTyped(meter)
  meter.last
recordBoth()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
