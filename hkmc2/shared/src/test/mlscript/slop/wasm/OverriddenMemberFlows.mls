private class Distance(val amount)
private class Labeled(val label, val duration)
private class DistanceSource with
  open fun make() = Distance(const(1))
  fun read() = make().amount
private class LabeledSource extends DistanceSource with
  override fun make() = Labeled("label", const(2))
private fun readLabeled() = new LabeledSource().read()
readLabeled()
