:.

// A block is discarded as a whole when erasure reports an error for it, or when lowering fails to coerce
// a value in it: none of its bindings is installed at runtime, including those that have no error.

val input32: Int32 = unsafe.undefined
//│ input32 = undefined


// Erasure rejects the last two definitions of this block.
:ge
let counter = 5
fun healthy() = 1
class Kept(val n: Int)
type Alias = Kept
module Group { fun read() = 2 }
private class Rejected(val value: Int32 | Int64)
private fun rejectedSignature(x: Int32 | Int64) = 1
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Int64' have no common representation
//│ ║  l.+6: 	private class Rejected(val value: Int32 | Int64)
//│ ╙──      	                                  ^^^^^^^^^^^^^
//│ ╔══[COMPILATION ERROR] Types 'Int32' and 'Int64' have no common representation
//│ ║  l.+7: 	private fun rejectedSignature(x: Int32 | Int64) = 1
//│ ╙──      	                                 ^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ counter = undefined

