// Opening a member under another name still depends on the original binding.
:ge
private fun throughAlias() =
  open Group.{ read as renamed }
  renamed()
//│ ╔══[COMPILATION ERROR] Binding 'Group' is unavailable because its defining block failed to compile.
//│ ║  l.+2: 	  open Group.{ read as renamed }
