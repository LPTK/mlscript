// A member of another class that has the name of a discarded class's member is unaffected.
:ge
class Gone(val weight: Int)
private fun failedGone(): Int32 = "wrong"
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Str' at an unrelated type 'Int32'
