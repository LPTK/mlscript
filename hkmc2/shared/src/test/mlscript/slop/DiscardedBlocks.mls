// A discarded assignment does not withdraw the variable introduced by an earlier program.
let saved = 6
//│ saved = 6

:ge
set saved = 99
private fun failed(): Int32 = "wrong"
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Str' at an unrelated type 'Int32'
//│ ║  l.+2: 	private fun failed(): Int32 = "wrong"
//│ ╙──      	                              ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:expect 6
saved
//│ = 6

// A fresh declaration with the same name has its own binding.
:expect 9
let counter = 8
counter + 1
//│ = 9
//│ counter = 8


// The bindings of earlier blocks that a discarded block uses stay available.
fun early() = 1
class Early(val n: Int)

:ge
fun usesEarly() = early() + new Early(1).n
private fun failedAfterUse(): Int32 = "wrong"
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'Str' at an unrelated type 'Int32'
//│ ║  l.+2: 	private fun failedAfterUse(): Int32 = "wrong"
//│ ╙──      	                                      ^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:expect 2
early() + new Early(1).n
//│ = 2

