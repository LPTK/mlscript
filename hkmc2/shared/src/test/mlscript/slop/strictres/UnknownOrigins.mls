// Missing member signatures survive further operations on their unknown results.
:e
class OriginBox with
  fun values() = [0]
  val number = 1
private fun useMethod(box: OriginBox) = [...box.values()].0.answer
private fun useField(box: OriginBox) = (box.number + 1).answer
