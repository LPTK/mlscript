// Recursive builtin flow reaches a fixed point without extending its witness on every pass.
:e
private fun increment(x, n: Int) =
  if n == 0 then x else increment(x + 1, n - 1)
private fun recursiveBuiltin(x: Any) = increment(x, 2).answer
