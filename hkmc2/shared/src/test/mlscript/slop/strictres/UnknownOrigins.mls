// Both ordinary and by-name async members locate the missing payload annotation.
:e
class Tasks with
  @annotations.async
  fun fetch() = {answer: 42}
  @annotations.async
  fun cached = {answer: 43}
private fun useFetch(x: Tasks) = x.fetch().then(y => y.answer)
private fun useCached(x: Tasks) = x.cached.then(y => y.answer)
@annotations.async
private fun fetchAgain(x: Tasks) = x.fetch()
@annotations.async
private fun cachedAgain(x: Tasks) = x.cached
private fun useFetchAgain(x: Tasks) = fetchAgain(x).then(y => y.answer)
private fun useCachedAgain(x: Tasks) = cachedAgain(x).then(y => y.answer)
