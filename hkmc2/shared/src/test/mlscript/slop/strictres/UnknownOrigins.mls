// Recursive tuple widening explains its deliberate loss of element precision.
:e
private fun growing(n: Int) =
  if n == 0 then [{answer: 0}] else [{answer: 1}, ...growing(n - 1)]
growing(2).at(1).answer
//│ ╔══[COMPILATION ERROR] Resolution error in selection
