// A pattern reads an overridden field like a selection does.
:e
private class Pair(val left, val right)
private class Tree with
  open val content = Pair(new First, new First)
  fun leftmost() = if content is Pair(l, _) then l.first()
private class SecondTree extends Tree with
  override val content = Pair(new Second, new Second)
new SecondTree().leftmost()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	  fun leftmost() = if content is Pair(l, _) then l.first()
//│ ║        	                                                 ^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+6: 	  override val content = Pair(new Second, new Second)
//│ ╙──      	                              ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The members of a generic class and of a class defined in a function are overridden like the others.
:expect "first"
private class Box[T](val content: T) with
  open fun get() = content
  fun read() = get()
private class Tagged[U](val tag: U) extends Box[U](tag) with
  override fun get() = tag
new Tagged(new First).read().first()
//│ = "first"

// In the body of `Sealed`, a value of the type parameter of an overriding class has no known interface.
:e
private class Sealed[T](val content: T) with
  open fun get() = new First
  fun read() = get().first()
private class Replaced[U](val tag: U) extends Sealed[U](tag) with
  override fun get() = tag
new Replaced(new Second).read()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	  fun read() = get().first()
//│ ║        	               ^^^^^^^^^^^
//│ ╟── Cannot resolve member 'first' of a value with unknown shape.
//│ ║  l.+4: 	private class Replaced[U](val tag: U) extends Sealed[U](tag) with
//│ ║        	                                   ^
//│ ╟── Type parameter 'U' does not specify a member interface.
//│ ║  l.+4: 	private class Replaced[U](val tag: U) extends Sealed[U](tag) with
//│ ╙──      	                       ^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

