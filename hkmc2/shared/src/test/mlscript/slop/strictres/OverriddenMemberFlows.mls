:expect "first"
private fun local() =
  class LocalMaker with
    open fun make() = new First
    fun read() = make()
  class LocalSecondMaker extends LocalMaker with
    override fun make() = new Second
  new LocalSecondMaker().read()
  new LocalMaker().read().first()
local()
//│ = "first"


// A reference whose receiver is an instance of the overridden member's own class reads no overriding member.
:expect "first"
private class ExactMaker with
  open fun make() = new First
  fun read() = make()
private class ExactSecondMaker extends ExactMaker with
  override fun make() = new Second
new ExactMaker().read().first()
//│ = "first"

:expect "first"
new Self().self().make().first()
//│ = "first"

// Neither does a reference whose receiver is an instance of a subclass that does not inherit the overriding member.
:expect "first"
private class Root with
  open fun make() = new First
  fun read() = make()
private class Left extends Root with
  override fun make() = new Second
private class Right extends Root
new Right().read().first()
//│ = "first"

// `Middle` inherits the member that `Bottom` overrides: an instance of `Middle` is not an instance of `Bottom`.
:expect "first"
private class Top with
  open fun make() = new First
private class Middle extends Top with
  fun read() = this.make()
private class Bottom extends Middle with
  override fun make() = new Second
new Middle().read().first()
//│ = "first"

:e
new Bottom().read().first()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
