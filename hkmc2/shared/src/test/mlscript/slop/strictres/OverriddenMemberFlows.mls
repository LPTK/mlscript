:.

// The receiver of a reference to an overridable member can be an instance of a subclass, where another member
// overrides the one that the reference selects. Such a reference also reads the overriding members: their results,
// the values of their fields, and their parameters, which receive the arguments of its calls.
// The body of a class is resolved once for all the instances that evaluate it, so the references it makes through
// `this` read the overriding members of every subclass (see also ../wasm/OverriddenMemberFlows.mls).

private class First with
  fun first() = "first"

private class Second with
  fun second() = "second"

private class Both with
  fun first() = "first of both"
  fun second() = "second of both"


// The call in `read` returns an instance of `Second` when the receiver is an instance of `SecondMaker`.
:e
private class Maker with
  open fun make() = new First
  fun read() = make().first()
private class SecondMaker extends Maker with
  override fun make() = new Second
new SecondMaker().read()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	  fun read() = make().first()
//│ ║        	               ^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+5: 	  override fun make() = new Second
//│ ╙──      	                        ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An explicit `this` selects the same member.
:e
private class ThisMaker with
  open fun make() = new First
  fun read() = this.make().first()
private class SecondThisMaker extends ThisMaker with
  override fun make() = new Second
new SecondThisMaker().read()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	  fun read() = this.make().first()
//│ ║        	               ^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+5: 	  override fun make() = new Second
//│ ╙──      	                        ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An overridden field is read the same way.
:e
