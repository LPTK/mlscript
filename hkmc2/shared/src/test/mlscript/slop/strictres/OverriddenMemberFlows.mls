// An instance that leaves its class through `this` is still an instance of any subclass.
:e
private class Self with
  open fun make() = new First
  fun self() = this
private class SecondSelf extends Self with
  override fun make() = new Second
new SecondSelf().self().make().first()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+6: 	new SecondSelf().self().make().first()
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+5: 	  override fun make() = new Second
//│ ╙──      	                        ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A method value that a reference selects stands for the overriding methods too.
:e
private class Factory with
  open fun make(x) = new First
  fun maker() = make
private class SecondFactory extends Factory with
  override fun make(x) = new Second
new SecondFactory().maker()(1).first()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
