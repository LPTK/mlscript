// The parameter of an overriding member also receives the arguments of the calls that select the overridden one.
:e
private class Taker with
  open fun take(x) = "base"
  fun run() = take(new First)
private class SecondTaker extends Taker with
  override fun take(x) = x.second()
new SecondTaker().take(new Second)
new SecondTaker().run()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	  override fun take(x) = x.second()
//│ ║        	                         ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+3: 	  fun run() = take(new First)
//│ ╙──      	                   ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The result of `read` takes a representation that the instances created by both members share.
:sir
:siret
private class Producer with
  open fun make() = new First
  fun read() = make()
private class SecondProducer extends Producer with
  override fun make() = new Second
private fun produce() = new SecondProducer().read()
produce()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @private
//│ define produce⁰ as fun produce¹(): Object⁰ {
//│   let tmp: SecondProducer⁰;
//│   set tmp = new SecondProducer⁰();
//│   return tmp.read⁰()
//│ };
//│ @private
//│ define Producer⁰ as class Producer¹ {
//│   method make⁰ = fun make¹(): Object⁰ {
//│     return new First⁰()
//│   }
//│   method read¹ = fun read⁰(): Object⁰ {
//│     return Producer¹.this.make¹()
//│   }
//│ };
//│ @private
//│ define SecondProducer¹ as class SecondProducer⁰ extends Producer¹ {
//│   method make² = fun make³(): Object⁰ { return new Second⁰() }
//│ };
//│ return produce¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = Second

// A written result type restricts the overriding members, which type checking will verify.
:expect "first"
private class TypedMaker with
  open fun make(): First = new First
  fun read() = make().first()
private class TypedSecondMaker extends TypedMaker with
  override fun make() = new First
new TypedSecondMaker().read()
//│ = "first"

// An abstract member has no value of its own: a reference to it reads its implementations.
:expect "first"
private abstract class AbstractMaker with
  fun make()
  fun read() = make().first()
private class ConcreteMaker extends AbstractMaker with
  fun make() = new First
new ConcreteMaker().read()
//│ = "first"

// An abstract method of a generic class is read through its declared interface, whose result is unknown.
// Its implementations still receive the arguments of its calls.
:e
private abstract class Folder[T] with
  fun step(x)
  fun run() = step(new First)
private class SecondFolder extends Folder[Int] with
  fun step(x) = x.second()
new SecondFolder().step(new Second)
new SecondFolder().run()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	  fun step(x) = x.second()
//│ ║        	                ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+3: 	  fun run() = step(new First)
//│ ╙──      	                   ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The member of an object and the member of a refined instance override the members of their class too.
:e
private class Greeter with
  open fun greet() = new First
  fun run() = greet().first()
private object Loud extends Greeter with
  override fun greet() = new Second
Loud.run()
