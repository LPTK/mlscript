// A class defined after a reference contributes its members to it.
:e
private fun early() = new LateMaker().read()
private class EarlyMaker with
  open fun make() = new First
  fun read() = make().first()
private class LateMaker extends EarlyMaker with
  override fun make() = new Second
early()
