//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.XX: 	  override fun make() = new Second
//│ ╙──      	                        ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The arguments of a call on an instance of the overridden member's class do not reach the overriding member.
:expect "second"
private class ExactTaker with
  open fun take(x) = "base"
private class ExactSecondTaker extends ExactTaker with
  override fun take(x) = x.second()
new ExactTaker().take(new First)
new ExactSecondTaker().take(new Second)
//│ = "second"

// A reference through `super` reads the inherited member only, whatever the class of the instance.
:expect "first"
private class Wrapper(val inner)
private class Source with
  open fun make() = new First
private class WrappingSource extends Source with
  override fun make() = Wrapper(super.make().first())
new WrappingSource().make().inner
//│ = "first"

// Each call of an overriding member returns its own argument.
:expect ["first", "second"]
private class Identity with
  open fun same(x) = x
  fun both() = [same(new First).first(), same(new Second).second()]
private class Renamed extends Identity with
  override fun same(y) = y
new Renamed().both()
//│ = ["first", "second"]

// A private member of a subclass overrides no member.
:expect "first"
private class Keeper with
  open fun make() = new First
  fun read() = make().first()
private class PrivateKeeper extends Keeper with
  private fun make() = new Second
new PrivateKeeper().read()
//│ = "first"


// An overriding mutable field holds the values assigned through the field it overrides.
:e
private class Cell with
  open mut val item = new First
  fun put(x) =
    set item = x
    ()
private class BothCell extends Cell with
  override mut val item = new Both
private fun useCell() =
  let cell = new mut BothCell
  cell.put(new Second)
  cell.item.first()
useCell()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+11: 	  cell.item.first()
//│ ║         	  ^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+10: 	  cell.put(new Second)
//│ ╙──       	           ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// A read through the overridden field returns the values assigned to the overriding one.
:e
private class Slot with
  open mut val item = new First
  fun get() = item
private class OtherSlot extends Slot with
  override mut val item = new First
private fun useSlot() =
  let slot = new mut OtherSlot
  set slot.item = new Second
  slot.get().first()
useSlot()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+9: 	  slot.get().first()
//│ ║        	  ^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+8: 	  set slot.item = new Second
//│ ╙──      	                  ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An assignment to an instance of the overridden field's class does not reach the overriding field.
:expect "first"
private class BaseCell with
  open mut val item = new First
private class DerivedCell extends BaseCell with
  override mut val item = new First
private fun useCells() =
  let base = new mut BaseCell
  let derived = new mut DerivedCell
  set base.item = new Second
  derived.item.first()
useCells()
//│ = "first"


// A call passes all its arguments to an overriding member that omits a `drop` parameter.
// The arity of the call is only checked against the member it selects.
:noInline
:expect 5
private class DropSuffix() with
  open fun pick(value, drop ignored) = value
  fun run() = pick(5, "ignored")
private class DroppedSuffix() extends DropSuffix() with
  override fun pick(renamed) = renamed
DroppedSuffix().run()
//│ = 5

:noInline
:expect 5
private class DropTyped() with
  open fun pick(value, drop ignored) = value
  fun run() = pick(5, "ignored")
private class DroppedTyped() extends DropTyped() with
  override fun pick(renamed: Int): Int = renamed
DroppedTyped().run()
//│ = 5

// A direct call of the overriding member is checked against its own parameters.
:e
DroppedSuffix().pick(5, "ignored")
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	DroppedSuffix().pick(5, "ignored")
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Function 'pick' expected 1 argument, but got 2
//│ ║  l.XX: 	  override fun pick(renamed) = renamed
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ = 5


// FIXME: The values of the selected member reach all its references, including those whose receiver is an
// instance of a class that overrides the member, where the selected member is not evaluated. An instance of
// `BothMaker` only makes instances of `Both`, but the selection below also finds `First`, which lacks `second`.
:fixme
private class DefaultMaker with
  open fun make() = new First
  fun read() = make()
private class BothMaker extends DefaultMaker with
  override fun make() = new Both
new BothMaker().read().second()
