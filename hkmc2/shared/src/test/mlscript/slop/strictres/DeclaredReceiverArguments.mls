:.

// A call through a receiver with a written class type selects the member that the class declares, and reads the
// written types of that member alone. The result of an unannotated member is unknown (see
// ../../newres/DeclaredTypes.mls, where inferring it is a TODO).
// TODO: The arguments of such a call do not reach the unannotated parameters of the member, nor those of the
// members that override it: these parameters only hold the arguments of the calls whose receiver has no written
// type. The blocks marked below are accepted or rejected for this reason (see also
// ../wasm/DeclaredReceiverArguments.mls).

private class First with
  fun first() = "first"

private class Second with
  fun second() = "second"


// The parameter receives no argument, so the selection in `take` finds no instance to select `second` from.
:fixme
:expect "second"
private class Lone with
  fun take(x) = x.second()
private fun runLone(t: Lone) = t.take(new Second)
runLone(new Lone)
//│ ╔══[COMPILATION ERROR] This selection of member 'second' has no resolved target
//│ ║  l.+2: 	  fun take(x) = x.second()
//│ ╙──      	                ^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
//│ ═══[RUNTIME ERROR] Expected: '"second"', got: 'undefined'

// The parameter only holds the argument of the first call. The call in `runTyped` passes an instance of `First`,
// which it converts to the representation of the parameter.
:breakme
:e
:re
:sir
:siret
private class Taker with
  fun take(x) = x.second()
private fun pick(flag) = if flag then new First else new Second
private fun runTyped(t: Taker) = t.take(pick(true))
new Taker().take(new Second)
runTyped(new Taker)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Taker⁰, tmp1: Second⁰, tmp2: Taker⁰;
//│ @private
//│ define pick⁰ as fun pick¹(flag: Bool⁰): Object⁰ {
//│   match flag
//│     true =>
//│       return new First⁰()
//│     else
//│       return new Second⁰()
//│   end
//│ };
//│ @private
//│ define runTyped⁰ as fun runTyped¹(t: Taker⁰): Unknown {
//│   let tmp3: Object⁰;
//│   set tmp3 = pick¹(true);
//│   return t.take⁰((tmp3 as! Second⁰))
//│ };
//│ @private
//│ define Taker¹ as class Taker⁰ {
//│   method take¹ = fun take⁰(x: Second⁰): Str⁰ {
//│     return x.second⁰()
//│   }
//│ };
//│ set tmp = new Taker⁰();
//│ set tmp1 = new Second⁰();
//│ do tmp.take⁰(tmp1);
//│ set tmp2 = new Taker⁰();
//│ return runTyped¹(tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: x.second is not a function

// The member that overrides the selected one does not receive the argument either.
:breakme
:e
:re
private class Base with
  open fun take(x) = "base"
private class Derived extends Base with
  override fun take(x) = x.second()
private fun pickOther(flag) = if flag then new First else new Second
private fun runBase(t: Base) = t.take(pickOther(true))
new Derived().take(new Second)
runBase(new Derived)
//│ ═══[RUNTIME ERROR] TypeError: x.second is not a function

// Lowering rejects an argument whose representation is unrelated to the parameter's, which hides the same omission.
:ge
private class Direct with
  fun take(x) = x.second()
private fun runDirect(t: Direct) = t.take(new First)
new Direct().take(new Second)
runDirect(new Direct)
//│ ╔══[COMPILATION ERROR] Cannot use a value of type 'First' at an unrelated type 'Second'
//│ ║  l.+3: 	private fun runDirect(t: Direct) = t.take(new First)
//│ ╙──      	                                          ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An assignment through such a receiver does reach the field that the class declares.
:e
private class Cell with
  mut val item = new Second
private fun fill(c: Cell) =
  set c.item = new First
  ()
private fun useCell() =
  let cell = new mut Cell
  fill(cell)
  cell.item.second()
useCell()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+9: 	  cell.item.second()
//│ ║        	  ^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+4: 	  set c.item = new First
//│ ╙──      	               ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
