  fun get(): Cell = wholeMemberCell
fun wholeCellReader(): WholeCellReader = new WholeCellReader
private fun wholeMemberArgument(x) = x.only
set wholeMemberCell = Cell(wholeMemberArgument)
wholeMemberArgument({only: 1})
