// They also reach the parameters of the members that override the selected one.
:e
private class Base with
  open fun take(x) = "base"
private class Derived extends Base with
  override fun take(x) = x.second()
private fun pickOther(flag) = if flag then new First else new Second
private fun runBase(t: Base) = t.take(pickOther(true))
new Derived().take(new Second)
runBase(new Derived)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	  override fun take(x) = x.second()
//│ ║        	                         ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+5: 	private fun pickOther(flag) = if flag then new First else new Second
//│ ╙──      	                                           ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// An assignment reaches the field that the class declares.
:e
private class Cell with
  mut val item = new Second
private fun fill(c: Cell) =
  set c.item = new First
  ()
private fun useCell() =
  let cell = new mut Cell
  fill(cell)
  cell.item.second()
useCell()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+9: 	  cell.item.second()
//│ ║        	  ^^^^^^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+4: 	  set c.item = new First
//│ ╙──      	               ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// The type arguments that the receiver's type supplies stand for the type parameters of its class in the written
// types of the implementation.
:expect "first"
private class Wrap[T](val value: T) with
  fun get() = value
private fun readWrap(w: Wrap[First]) = w.get().first()
readWrap(new Wrap(new First))
//│ = "first"

:expect ["first", "second"]
private fun readFirst(w: Wrap[First]) = w.get().first()
private fun readSecond(w: Wrap[Second]) = w.get().second()
[readFirst(new Wrap(new First)), readSecond(new Wrap(new Second))]
//│ = ["first", "second"]

:expect "first"
private fun through[A](w: Wrap[A]) = w.get()
through(new Wrap(new First)).first()
//│ = "first"

// A written parameter or result of the member keeps its type, next to the unwritten ones.
:expect "first"
private class Store[T](val seed: T) with
  fun put(x: T, y) = y
  fun echo(y): T = seed
private fun store(s: Store[First]) = [s.put(new First, new First).first(), s.echo(1).first()]
store(new Store(new First)).0
//│ = "first"

// The receiver's type argument hides the members of the subclasses of the argument.
:e
private class Parent
private class Child extends Parent with
  val extra = 42
private fun peek(w: Wrap[Parent]) = w.get().extra
peek(new Wrap(new Child))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	private fun peek(w: Wrap[Parent]) = w.get().extra
//│ ║        	                                    ^^^^^^^^^^^^^
//│ ╟── Value of type 'Parent' does not contain member 'extra'
//│ ║  l.+4: 	private fun peek(w: Wrap[Parent]) = w.get().extra
//│ ╙──      	                         ^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The values without a written type are read for all the instances of the generic class, whatever their own type
// arguments, and meet the arguments of the calls made through the receiver.
:expect "first"
private class Tagged[T](val tag: T, val item)
private fun readTagged(t: Tagged[Int]) = t.item.first()
readTagged(new Tagged(1, new First))
//│ = "first"

:e
private class Combiner with
  fun combine(z) = z.second()
private class Pairer[T](val tag: T, val item) with
  fun use(y) = y.combine(item)
private fun runPairer(p: Pairer[Int]) = p.use(new Combiner)
runPairer(new Pairer(1, new First))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  fun combine(z) = z.second()
//│ ║        	                   ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+6: 	runPairer(new Pairer(1, new First))
//│ ╙──      	                        ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.


// A projection states that its receiver is an instance of the class that it names, as a written type would,
// including where the type or the value of the receiver does not tell. It then reads the member of that class
// for all its instances, and its arguments reach the parameters of that member.
private class Plain

:expect "first"
private class Narrow(val content) extends Plain with
  fun unwrap() = content
private fun readNarrow(b: Plain) = b.Narrow#unwrap()
readNarrow(new Narrow(new First)).first()
//│ = "first"

:e
private class Strict extends Plain with
  fun accept(x) = x.second()
private fun pickStrict(flag) = if flag then new First else new Second
private fun runStrict(b: Plain) = b.Strict#accept(pickStrict(true))
new Strict().accept(new Second)
runStrict(new Strict)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	  fun accept(x) = x.second()
//│ ║        	                  ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+3: 	private fun pickStrict(flag) = if flag then new First else new Second
//│ ╙──      	                                            ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The receiver of this projection is a value of unknown shape.
:e
