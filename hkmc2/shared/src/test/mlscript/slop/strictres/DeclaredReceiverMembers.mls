// The result of a projection can reach its own receiver. All the receivers of the projection share one unknown
// type argument: with one per receiver, each result was a new receiver, and resolution did not terminate.
private class Unwrapping[T](val held: T) extends Plain with
  fun get() = held
private fun unwrapAll(x, n) = if n is 0 then x else unwrapAll(x.Unwrapping#get(), n - 1)
unwrapAll(new Unwrapping(new First), 1)
//│ = First

private class Annotated[T](val held: T) extends Plain with
  fun get(): T = held
private fun unwrapAnnotated(x, n) = if n is 0 then x else unwrapAnnotated(x.Annotated#get(), n - 1)
unwrapAnnotated(new Annotated(new First), 1)
//│ = First

// The projected class can be local to a function.
:e
private fun localProjection(seed) =
  class Sink with
    fun accept(x) = x.second()
  let run = (o: Plain) => o.Sink#accept(seed)
  new Sink().accept(new Second)
  run
localProjection(new First)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	    fun accept(x) = x.second()
//│ ║        	                    ^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+7: 	localProjection(new First)
//│ ╙──      	                ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
