:.

// A receiver with a written class type selects the members that the class declares. A member with a fully
// written interface is read through that interface alone (see ../../newres/DeclaredTypes.mls). A member that
// leaves types unwritten is read through its implementation, as for a receiver without a written type.
// Such a receiver can be any instance of its class or of a subclass: a reference reads the values of the member
// for all these instances, including those of the members that override it (see OverriddenMemberFlows.mls), and
// passes its arguments to all of them (see also ../wasm/DeclaredReceiverMembers.mls).

private class First with
  fun first() = "first"

private class Second with
  fun second() = "second"


// The result of a method, the value of a field, and the argument of a constructor.
:expect "first"
private class Maker with
  fun make() = new First
private fun readMaker(m: Maker) = m.make().first()
readMaker(new Maker)
//│ = "first"

:expect "first"
private class Holder with
  val item = new First
private fun readHolder(h: Holder) = h.item.first()
readHolder(new Holder)
//│ = "first"

:expect "first"
private class Box(val item)
private fun readBox(b: Box) = b.item.first()
readBox(Box(new First))
//│ = "first"

:expect "first"
private class Lazy with
  fun item = new First
private fun readLazy(l: Lazy) = l.item.first()
readLazy(new Lazy)
//│ = "first"

// The parameter of a lambda and an ascription select members the same way.
:expect "first"
private val reader = (m: Maker) => m.make()
reader(new Maker).first()
//│ = "first"
//│ reader = fun

:expect "first"
(Box(new First) as Box).item.first()
//│ = "first"

// The result takes the representation of the values that the member returns.
:sir
:siret
private fun made(m: Maker) = m.make()
made(new Maker)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Maker⁰;
//│ @private
//│ define made⁰ as fun made¹(m: Maker⁰): First⁰ {
//│   return m.make⁰()
//│ };
//│ set tmp = new Maker⁰();
//│ return made¹(tmp)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = First

// The receiver can be any instance of its class: a reference reads the arguments of all the constructor calls.
:e
private class Slot(val item)
private fun readSlot(s: Slot) = s.item.first()
readSlot(Slot(new First))
Slot(new Second)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	private fun readSlot(s: Slot) = s.item.first()
//│ ║        	                                ^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+4: 	Slot(new Second)
//│ ╙──      	     ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The receiver can also be an instance of a subclass, where another member overrides the selected one.
:e
private class OpenMaker with
  open fun make() = new First
private class SecondMaker extends OpenMaker with
  override fun make() = new Second
private fun readOpen(m: OpenMaker) = m.make().first()
readOpen(new SecondMaker)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+5: 	private fun readOpen(m: OpenMaker) = m.make().first()
//│ ║        	                                     ^^^^^^^^^^^^^^
//│ ╟── Instance of class 'Second' does not contain member 'first'
//│ ║  l.+4: 	  override fun make() = new Second
//│ ╙──      	                        ^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// Other compilation units can instantiate a public class, with arguments of any shape.
:e
class PublicBox(val item)
private fun readPublic(b: PublicBox) = b.item.first()
readPublic(PublicBox(new First))
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+2: 	private fun readPublic(b: PublicBox) = b.item.first()
//│ ║        	                                       ^^^^^^^^^^^^
//│ ╟── Cannot resolve member 'first' of a value with unknown shape.
//│ ╟── Parameter 'item' admits values of unknown shape.
//│ ║  l.+1: 	class PublicBox(val item)
//│ ║        	                ^^^^^^^^
//│ ╟── 'PublicBox' is exposed by this compilation unit.
//│ ║  l.+1: 	class PublicBox(val item)
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

// The class of the receiver can be defined in a function or in another class.
:expect "first"
private fun enclosing(seed) =
  class Local(val item)
  fun readLocal(l: Local) = l.item
  readLocal(Local(seed))
enclosing(new First).first()
//│ = "first"

:expect "first"
private class Library(val content) with
  class Entry with
    fun get() = content
  fun entry() = new Entry
  fun readEntry(e: Entry) = e.get()
private fun useLibrary() =
  let library = new Library(new First)
  library.readEntry(library.entry()).first()
useLibrary()
//│ = "first"

// A member of the receiver can be a class or an object, whose own members are read the same way.
:e
private class Outer with
  class Inner(val item) with
    fun use() = item.second()
private fun build(o: Outer) = new o.Inner(new First)
private fun buildDirectly(o) = new o.Inner(new Second)
buildDirectly(new Outer).use()
build(new Outer).use()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+3: 	    fun use() = item.second()
//│ ║        	                ^^^^^^^^^^^
//│ ╟── Instance of class 'First' does not contain member 'second'
//│ ║  l.+4: 	private fun build(o: Outer) = new o.Inner(new First)
//│ ╙──      	                                          ^^^^^^^^^
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.

:e
private class Host with
  object Helper with
    fun run(x) = x.second()
private fun viaHost(h: Host) = h.Helper.run(new First)
new Host().Helper.run(new Second)
viaHost(new Host)
//│ ╔══[COMPILATION ERROR] Resolution error in selection
