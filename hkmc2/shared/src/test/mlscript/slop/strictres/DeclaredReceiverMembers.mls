// A member can read itself through a receiver with a written type.
:expect "first"
private class Chain(val value, val next) with
  fun last() = if next is null then value else rest(next)
private fun rest(c: Chain) = c.last()
rest(new Chain(new First, new Chain(new First, null))).first()
//│ = "first"

:expect "first"
private class Link[T](val next, val value: T) with
  fun follow() = next
private fun lastLink(l: Link[First], n) = if n is 0 then l else lastLink(l.follow(), n - 1)
lastLink(new Link(new Link(null, new First), new First), 1).value.first()
//│ = "first"


// The arguments of a call reach the parameters of the selected member.
:expect "second"
private class Lone with
  fun take(x) = x.second()
private fun runLone(t: Lone) = t.take(new Second)
runLone(new Lone)
//│ = "second"

// They join the arguments of the calls whose receiver has no written type.
:e
:sir
:siret
private class Taker with
  fun take(x) = x.second()
private fun pick(flag) = if flag then new First else new Second
private fun runTyped(t: Taker) = t.take(pick(true))
new Taker().take(new Second)
runTyped(new Taker)
