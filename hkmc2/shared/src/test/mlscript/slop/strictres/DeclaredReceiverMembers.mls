// The projected class can be generic. The projection supplies no type arguments, so a member whose written type
// is a type parameter of the class has an unknown interface.
:expect "first"
private class Keeper[T](val held, val label: T) extends Plain with
  fun release() = held
private fun readKeeper(b: Plain) = b.Keeper#release()
readKeeper(new Keeper(new First, new Second)).first()
//│ = "first"

:e
private class Labeled[T](val label: T) extends Plain with
  fun describe() = label
private fun readLabeled(b: Plain) = b.Labeled#describe()
readLabeled(new Labeled(new First)).first()
//│ ╔══[COMPILATION ERROR] Resolution error in selection
//│ ║  l.+4: 	readLabeled(new Labeled(new First)).first()
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value with an empty interface does not contain member 'first'
//│ ║  l.+3: 	private fun readLabeled(b: Plain) = b.Labeled#describe()
//│ ║        	                                    ^^^^^^^^^^^^^^^^^^
//│ ╟── No member interface is known for this type.
//│ ║  l.+3: 	private fun readLabeled(b: Plain) = b.Labeled#describe()
//│ ╙──      	                                    ^^^^^^^^^^^^^^^^^^
