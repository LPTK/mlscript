// A member that writes some of its parameter types still receives the arguments for the others.
:e
private class Partial with
  fun mix(count: Int, x) = x.second()
private fun runPartial(p: Partial) = p.mix(1, new First)
new Partial().mix(2, new Second)
runPartial(new Partial)
