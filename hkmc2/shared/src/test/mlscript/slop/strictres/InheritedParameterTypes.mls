// The type parameters of an override correspond to those of its base by position.
// The override's B stands for the base's A, which types both `x` and the result.
:expect 7
private class PairBase with
  open fun first[A, B](x: A, y: B): A = x
private class SwappedNames extends PairBase with
  override fun first[B, A](x, y): B = x
new SwappedNames().first(Item(7), 0).n
//│ = 7


// A base type parameter without a counterpart in the override remains opaque in its body.
:e
private class TwoParameters with
  open fun pick[A, B](x: A, y: B): Int = 0
private class OneParameter extends TwoParameters with
  override fun pick[C](x, y) = y.only
new OneParameter().pick(1, {only: 2})
