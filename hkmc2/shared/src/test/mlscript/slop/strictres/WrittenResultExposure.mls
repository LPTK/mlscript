// The named class declares the method, and a private subclass returns the helper from its override.
:e
private fun overridden(x) = x.only
private class Base with
  open fun get() = (x => 0)
private class Sub extends Base with
  override fun get() = overridden
fun make(): Base = new Sub
overridden({only: 1})
