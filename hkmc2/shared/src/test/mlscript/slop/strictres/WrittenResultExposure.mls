// A constructor argument, which the unannotated field of its parameter stores.
:breakme
:e
private fun argument(x) = x.only
private class ArgumentCarrier(val f)
fun argumentCarrier(): ArgumentCarrier = ArgumentCarrier(argument)
argument({only: 1})
//│ = 1

:fixme
invoke(argumentCarrier().f)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'only')


// An inferred result exposes the returned instance itself, and with it the helper that its method returns.
:e
private fun storedInferred(x) = x.only
private class CarrierInferred with
  fun get() = storedInferred
fun carrierInferred() = new CarrierInferred
storedInferred({only: 8})
