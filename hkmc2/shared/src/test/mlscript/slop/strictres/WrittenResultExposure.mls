:.

// A written result type exposes the public operations of the class that it names. The values that these
// operations produce without an annotation of their own escape with them: a later block, or another
// compilation unit, can obtain such a value and pass it inputs that its defining block never observed.
// FIXME: Each block marked `:breakme` should reject its private helper, whose parameter admits unknown
// values, as the last block does for a factory with an inferred result. The call that follows each of them
// resolves in a later block, and fails at runtime.

fun invoke(f: Any -> Int) = f(null)


// The result of a method.
:breakme
:e
private fun stored(x) = x.only
private class Carrier with
  fun get() = stored
fun carrier(): Carrier = new Carrier
stored({only: 17})
//│ = 17

:fixme
invoke(carrier().get())
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'only')


// The named class declares the method, and a private subclass returns the helper from its override.
:breakme
:e
private fun overridden(x) = x.only
private class Base with
  open fun get() = (x => 0)
private class Sub extends Base with
  override fun get() = overridden
fun make(): Base = new Sub
overridden({only: 1})
//│ = 1

:fixme
invoke(make().get())
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'only')


// The value of a field.
:breakme
:e
private fun fieldValue(x) = x.only
private class FieldCarrier with
  val f = fieldValue
fun fieldCarrier(): FieldCarrier = new FieldCarrier
fieldValue({only: 1})
//│ = 1

:fixme
invoke(fieldCarrier().f)
//│ ═══[RUNTIME ERROR] TypeError: Cannot read properties of null (reading 'only')


// The result of a getter.
