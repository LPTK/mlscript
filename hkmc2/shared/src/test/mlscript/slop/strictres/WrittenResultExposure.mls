// A written field on an override bounds what clients can see of its contents.
:expect 4
private class Broad with
  open val field = 0
private class Inner with
  fun local(x) = x.only
private class Narrow extends Broad with
  override val field: Any = new Inner
fun broad(): Broad = new Narrow
new Inner().local({only: 4})
//│ = 4


// A write through an abstract field exposes the callback stored in the concrete object.
:e
private fun abstractCallback(x) = x.only
private abstract class AbstractStore with
  mut val stored
private class RealStore extends AbstractStore with
  override mut val stored = (x => 0)
private val instance = new mut RealStore
fun getStore(): AbstractStore = instance
set getStore().stored = abstractCallback
abstractCallback({only: 1})
