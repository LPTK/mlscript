// External storage has no MLscript initializer either.
:e
private fun externalCallback(x) = x.only
declare class ExternalStore with
  mut val stored
declare val externalStore: ExternalStore
fun getExternal(): ExternalStore = externalStore
private fun storeCallback() = { set externalStore.stored = externalCallback }
externalCallback({only: 2})
