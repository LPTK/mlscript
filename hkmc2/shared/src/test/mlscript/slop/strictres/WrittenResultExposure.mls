// A new implementation can arrive after the named base was exposed.
private class Library with
  open fun get() = (x => 0)
fun library(): Library = new Library

:e
private fun lateResult(x) = x.only
private class Late extends Library with
  override fun get() = lateResult
lateResult({only: 2})
