// The iterator of a generator hands out its values with an empty interface, whatever result the
// declaration writes, so no client can call the callback that an unannotated generator override returns.
private fun generated(x) = x.only
private class GeneratorSource with
  @generator open fun items(): Any -> Int = x => 0
private class GeneratorImpl extends GeneratorSource with
  @generator override fun items() = generated
fun generatorSource(): GeneratorSource = new GeneratorImpl
generated({only: 3})
//│ = 3

:e
generatorSource().items().next().value(null)
//│ ╔══[COMPILATION ERROR] Resolution error in application
//│ ║  l.+1: 	generatorSource().items().next().value(null)
//│ ║        	^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── Value with an empty interface cannot be called like a function.
//│ ╙── This type permits values of any type, so no member interface is guaranteed.
//│ ═══[RUNTIME ERROR] This code cannot be run as its compilation yielded an error.
