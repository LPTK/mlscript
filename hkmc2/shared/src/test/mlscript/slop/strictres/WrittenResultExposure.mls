// An inherited field type checks later writes as well as the initializer.
:e
private fun assigned(x) = x.only
private class CallbackStore with
  open mut val callback: Any -> Int = x => 0
private class LocalStore extends CallbackStore with
  override mut val callback = x => 1
private val localStore = new mut LocalStore
set localStore.callback = assigned
fun callbacks(): CallbackStore = localStore
