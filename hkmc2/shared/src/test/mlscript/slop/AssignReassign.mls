:.
:global
:js

// The source assignment stays a reassignment after flattening and optimization.
:lot
:olot
:expect 3
let assigned = 1
if assigned == 1 then
  set assigned = assigned + 2
assigned
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Scoped(syms = {tmp:scrut⁰, tmp:tmp⁰, tmp:tmp¹}):
//│     body = Assign:
//│       lhs = assigned⁰
//│       rhs = Lit of IntLit of 1
//│       rest = Assign:
//│         lhs = tmp:scrut⁰
//│         rhs = Call:
//│           fun = Select{sym=term:Predef⁰/equals⁰}:
//│             qual = MemberRef{disamb=module:Predef⁰}:
//│               bms = member:Predef¹
//│               disamb = module:Predef⁰
//│             name = Ident of "equals"
//│           argss = Ls of
//│             Ls of
//│               Arg:
//│                 value = SimpleRef of assigned⁰
//│               Arg:
//│                 value = Lit of IntLit of 1
//│         rest = Match:
//│           scrut = SimpleRef of tmp:scrut⁰
//│           arms = Ls of
//│             Tuple2:
//│               _1 = Lit of BoolLit of true
//│               _2 = Assign:
//│                 lhs = tmp:tmp⁰
//│                 rhs = Call:
//│                   fun = SimpleRef of builtin:+⁰
//│                   argss = Ls of
//│                     Ls of
//│                       Arg:
//│                         value = SimpleRef of assigned⁰
//│                       Arg:
//│                         value = Lit of IntLit of 2
//│                 rest = Assign:
//│                   lhs = assigned⁰
//│                   rhs = SimpleRef of tmp:tmp⁰
//│                   rest = Assign:
//│                     lhs = tmp:tmp¹
//│                     rhs = Select{sym=object:Unit⁰}:
//│                       qual = SimpleRef of runtime⁰
//│                       name = Ident of "Unit"
//│                     rest = Return of SimpleRef of assigned⁰
//│                     reassign = false
//│                   reassign = true
//│                 reassign = false
//│           dflt = S of Throw:
//│             exc = Instantiate:
//│               mut = false
//│               cls = Select{sym=class:Error⁰}:
//│                 qual = This of globalThis:globalThis⁰
//│                 name = Ident of "Error"
//│               argss = Ls of
//│                 Ls of
//│                   Arg:
//│                     value = Lit of StrLit of "match error"
//│           rest = End of "Rest moved to non-abortive branch(es)"
//│         reassign = false
//│       reassign = false
//│ ————————————| Optimized IR Tree |———————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Scoped(syms = {tmp:scrut⁰}):
//│     body = Assign:
//│       lhs = assigned⁰
//│       rhs = Lit of IntLit of 1
