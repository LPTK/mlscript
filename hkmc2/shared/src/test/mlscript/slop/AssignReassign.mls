//│ next = fun

// Tail-call parameters are reassigned; argument temporaries are initialized.
:olot
:expect 10
@annotations.noInline
fun sumDown(n: Int, acc: Int): Int =
  if n == 0 then acc else sumDown(n - 1, acc + n)
sumDown(4, 0)
