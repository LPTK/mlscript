// Naming a lambda must preserve whether its destination already has a value.
:lot
:olot
:expect 2
let next = () => 1
set next = () => 2
next()
//│ —————————————| Lowered IR Tree |————————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Scoped(syms = {member:lambda⁰, member:next⁰}):
//│     body = Define:
//│       defn = FunDefn:
//│         sym = member:next⁰
//│         dSym = term:next¹
//│         params = Ls of
//│           LoweredParamList: ‹empty›
//│         body = Return of Lit of IntLit of 1
//│       rest = Assign: \
//│       lhs = next²
//│       rhs = MemberRef{disamb=term:next¹}:
//│         bms = member:next⁰
//│         disamb = term:next¹
//│       rest = Define:
//│         defn = FunDefn:
//│           sym = member:lambda⁰
//│           dSym = term:lambda¹
//│           params = Ls of
//│             LoweredParamList: ‹empty›
//│           body = Return of Lit of IntLit of 2
//│         rest = Assign: \
//│         lhs = next²
//│         rhs = MemberRef{disamb=term:lambda¹}:
//│           bms = member:lambda⁰
//│           disamb = term:lambda¹
//│         rest = Return of Call:
//│           fun = SimpleRef of next²
//│           argss = Ls of
//│             Nil
//│         reassign = true
//│       reassign = false
//│ ————————————| Optimized IR Tree |———————————————————————————————————————————————————————————————————
//│ Program:
//│   main = Scoped(syms = {member:lambda⁰, member:next⁰}):
//│     body = Define:
//│       defn = FunDefn:
//│         sym = member:next⁰
//│         dSym = term:next¹
//│         params = Ls of
//│           LoweredParamList: ‹empty›
//│         body = Return of Lit of IntLit of 1
//│       rest = Assign: \
//│       lhs = next²
//│       rhs = MemberRef{disamb=term:next¹}:
//│         bms = member:next⁰
//│         disamb = term:next¹
//│       rest = Define:
//│         defn = FunDefn:
//│           sym = member:lambda⁰
//│           dSym = term:lambda¹
//│           params = Ls of
//│             LoweredParamList: ‹empty›
//│           body = Return of Lit of IntLit of 2
//│         rest = Assign: \
