let x = 1 in let y = 2
//│ Parsed:
//│ 	LetLike(Keywrd(keyword 'let'),List(LetBinding(Ident(x),Some(IntLit(1)),List())),Some(LetLike(Keywrd(keyword 'let'),List(LetBinding(Ident(y),Some(IntLit(2)),List())),None)))

let x = 1 in let y = 2 in let z = 3
//│ Parsed:
//│ 	LetLike(Keywrd(keyword 'let'),List(LetBinding(Ident(x),Some(IntLit(1)),List())),Some(LetLike(Keywrd(keyword 'let'),List(LetBinding(Ident(y),Some(IntLit(2)),List())),Some(LetLike(Keywrd(keyword 'let'),List(LetBinding(Ident(z),Some(IntLit(3)),List())),None)))))

