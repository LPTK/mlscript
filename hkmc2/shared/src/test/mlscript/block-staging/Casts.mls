// The staged-module compiler (`ReflectionInstrumenter`) has to keep a `Cast` as data rather than
// dropping it: the staged mirror (`Block.mls`) has a `Cast` node, so the coercion survives into the
// produced IR instead of being silently discarded on the way in.

:js
:staging
class Top(x: Int)
fun anything(v) = v
staged module M with
  fun mk(): Top = anything(1)
//│ > fun ctor_() = ()
//│ > fun mk() = (anything(1) as!! Top)
