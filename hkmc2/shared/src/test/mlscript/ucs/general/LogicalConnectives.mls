true or true
//│ = true

while false or false do print("ok")


fun test(x) =
  print(x)
  x

123 and test(42)
//│ = false

:sjs
true and test(42)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (true === true) {
//│   Predef.print(42);
