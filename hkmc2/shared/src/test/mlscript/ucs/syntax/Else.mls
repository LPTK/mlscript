:.
:js

// Else.mls
// ========
// Examine how the `else` keyword is parsed.


fun f(x, y, z) = if x then y

:pt
fun f(x, y, z) = if x then y else z
//│ ———————————————| Parsed tree |——————————————————————————————————————————————————————————————————————
//│ TermDef:
//│   k = Fun
//│   head = App:
//│     lhs = Ident of "f"
//│     rhs = Tup of Ls of
//│       Ident of "x"
//│       Ident of "y"
//│       Ident of "z"
//│   rhs = S of IfLike:
//│     kw = Keywrd of keyword 'if'
//│     split = Block of Ls of
//│       InfixApp:
//│         lhs = Ident of "x"
//│         kw = Keywrd of keyword 'then'
//│         rhs = Ident of "y"
//│       PrefixApp:
//│         kw = Keywrd of keyword 'else'
//│         rhs = Ident of "z"
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


fun f(x, y, z) =
  if x
    then y
    else z

fun f(x, y, z) = if x
                 then y
                 else z

fun f(x, y, z) = if x then y
  else z

fun f(x, y, z) = if
  x then y
  else z

fun f(x, y, z) =
  if x then
    y
  else
    z

fun f(x, y, z) =
  if x then y
  else z

fun f(x, y, z) =
  if x then y
    else z

fun f(x, y, z) =
  if x
  then y
  else z

fun f(x, y, z) =
  if x
    then y
    else z

:expect [10, 20]
fun f(x, y, z) =
  if
    x then y else z
[f(true, 10, 20), f(false, 10, 20)]
//│ = [10, 20]


fun f(x, y) =
  if x
    then y

let audits = new Set()
//│ audits = Set(0) {}

if audits.has(1) === true do
  print("ok")
else
  print(1)
//│ > 1


(if true then
    5
  else 1
) + 3
//│ = 8

(if true
  then
    5
  else 1
) + 3
//│ = 8

(if true
  then
    5 else 1
) + 3
//│ = 8

// Check the alternative as well as the consequent in both indented layouts.
:expect 4
(if false
  then
    5
  else 1
) + 3
//│ = 4

:expect 4
(if false
  then
    5 else 1
) + 3
//│ = 4

// Each else belongs to the conditional at its own indentation level.
fun nested(a, b) =
  if a then
    if b
      then
        10 else 20
  else 30

:expect [10, 20, 30]
[nested(true, true), nested(true, false), nested(false, true)]
//│ = [10, 20, 30]

:expect 20
if
  false then 10
else 20
//│ = 20

:expect 20
if { false then 10 } else 20
//│ = 20


data class Box[A](value: A)

:w
fun foo(x) = if x is
  Box(0) then "The box contains zero."
  Box(1) then "The box contains one."
  else "I can't tell you what's inside the box."
  else "I don't want to tell you what's inside the box."
  else "I shouldn't tell you what's inside the box."
//│ ╔══[WARNING] This catch-all clause makes the following branches unreachable.
//│ ║  l.+4: 	  else "I can't tell you what's inside the box."
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This branch is unreachable.
//│ ║  l.+5: 	  else "I don't want to tell you what's inside the box."
//│ ║        	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
//│ ╟── This branch is unreachable.
//│ ║  l.+6: 	  else "I shouldn't tell you what's inside the box."
//│ ╙──      	  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
