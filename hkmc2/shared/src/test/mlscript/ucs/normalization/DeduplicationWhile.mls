:js
:patMatConsequentSharingThreshold 1
// ^ force dedup even for small consequents


// :sjs
() =>
while true and false do print(1) else print(2)
//│ = fun

:sjs
() =>
while true and true and false do print(1) else print(2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda1;
//│ lambda1 = (undefined, function () {
//│   lbl: while (true) {
//│     Predef.print(2);
//│     continue lbl;
//│   }
//│   throw new Error("Reached 'unreachable' code (Rest of abortive labelled block)");
//│ });
//│ lambda1
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun

// :sjs
let x = 3
if x > 0 and x ===
  1 do print("A")
  2 do print("A")
  3 do print("B")
  4 do print("B")
//│ > B
//│ x = 3

