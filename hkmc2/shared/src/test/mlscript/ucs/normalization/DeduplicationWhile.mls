:sjs
x =>
while x > 0 and x ===
  1 and false and false do print("A")
  2 and false do print("B")
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda3; lambda3 = (undefined, function (x1) { return runtime.Unit }); lambda3
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun




