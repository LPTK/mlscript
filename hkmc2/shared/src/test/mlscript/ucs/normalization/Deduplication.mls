:sir
fun foo(x, y, z) =
  if x is
    0 and y is
      0 and z is
        0 then "000"
        1 then "001"
      1 then "01"
    1 then "1"
    else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁰ as fun foo¹(x, y, z) {
//│   match x
//│     0 =>
//│       match y
//│         0 =>
//│           match z
//│             0 =>
//│               return "000"
//│             1 =>
//│               return "001"
//│             else
//│               return ""
//│           end
//│         1 =>
//│           return "01"
//│         else
//│           return ""
//│       end
//│     1 =>
//│       return "1"
//│     else
//│       return ""
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

foo(0, 0, 0)
//│ = "000"

:sir
print of if
  x is 0 and
    y is 0 and
      z is 0 then "000"
    y is 1 then "01_"
    z is 1 then "0_1"
  x is 1 then "1__"
  y is 2 then "_2_"
  else "___"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, tmp7, tmp8, tmp9;
//│ set tmp = x⁰;
//│ match tmp
//│   0 =>
//│     set tmp1 = y⁰;
//│     match tmp1
//│       0 =>
//│         set tmp2 = z⁰;
//│         match tmp2
//│           0 =>
//│             set tmp3 = "000";
//│             return Predef⁰.print⁰(tmp3)
//│           else
//│             set tmp4 = z⁰;
//│             match tmp4
//│               1 =>
//│                 set tmp3 = "0_1";
//│                 return Predef⁰.print⁰(tmp3)
//│               else
//│                 set tmp3 = "___";
//│                 return Predef⁰.print⁰(tmp3)
//│             end
//│         end
//│       else
//│         set tmp5 = y⁰;
//│         match tmp5
//│           1 =>
//│             set tmp3 = "01_";
//│             return Predef⁰.print⁰(tmp3)
//│           else
//│             set tmp6 = z⁰;
//│             match tmp6
//│               1 =>
//│                 set tmp3 = "0_1";
//│                 return Predef⁰.print⁰(tmp3)
//│               else
//│                 set tmp7 = y⁰;
//│                 match tmp7
//│                   2 =>
//│                     set tmp3 = "_2_";
//│                     return Predef⁰.print⁰(tmp3)
//│                   else
//│                     set tmp3 = "___";
//│                     return Predef⁰.print⁰(tmp3)
