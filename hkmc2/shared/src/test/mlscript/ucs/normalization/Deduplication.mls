:.
:js
:patMatConsequentSharingThreshold 5

let x = 0
let y = 0
let z = 0
//│ x = 0
//│ y = 0
//│ z = 0

:sir
if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set tmp = x⁰;
//│ set scrut = ===⁰(tmp, 0);
//│ match scrut
//│   true =>
//│     return 1
//│   else
//│     return 2
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:sir
let a = if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp, tmp1;
//│ set tmp = x⁰;
//│ set scrut = ===⁰(tmp, 0);
//│ match scrut
//│   true =>
//│     set tmp1 = 1;
//│     end
//│   else
//│     set tmp1 = 2;
//│     end
//│ set a⁰ = tmp1;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ a = 1

:sir
print of if x === 0 then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp, tmp1;
//│ set tmp = x⁰;
//│ set scrut = ===⁰(tmp, 0);
//│ match scrut
//│   true =>
//│     set tmp1 = 1;
//│     return Predef⁰.print⁰(tmp1)
//│   else
