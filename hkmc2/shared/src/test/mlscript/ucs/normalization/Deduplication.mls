:sir
if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else ""
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2, tmp3, tmp4, tmp5;
//│ set tmp = x⁰;
//│ match tmp
//│   0 =>
//│     set tmp1 = y⁰;
//│     match tmp1
//│       0 =>
//│         set tmp2 = z⁰;
//│         match tmp2
//│           0 =>
//│             return "000"
//│           else
//│             set tmp3 = z⁰;
//│             match tmp3
//│               1 =>
//│                 return "001"
//│               else
//│                 return ""
//│             end
//│         end
//│       else
//│         set tmp4 = y⁰;
//│         match tmp4
//│           1 =>
//│             return "01"
//│           else
//│             return ""
//│         end
//│     end
//│   else
//│     set tmp5 = x⁰;
//│     match tmp5
//│       1 =>
//│         return "1"
//│       else
//│         return ""
//│     end
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000"

// * Making the terms artificially big to force sharing of consequents
:sir
if x is
  0 and y is
    0 and z is
      0 then "000-------------------------------------------------------------------------"
      1 then "001-------------------------------------------------------------------------"
    1 then "01-------------------------------------------------------------------------"
  1 then "1-------------------------------------------------------------------------"
  else "-------------------------------------------------------------------------"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2, tmp3, tmp4, tmp5;
//│ set tmp = x⁰;
//│ match tmp
//│   0 =>
//│     set tmp1 = y⁰;
//│     match tmp1
//│       0 =>
//│         set tmp2 = z⁰;
//│         match tmp2
//│           0 =>
//│             return "000-------------------------------------------------------------------------"
//│           else
//│             set tmp3 = z⁰;
//│             match tmp3
//│               1 =>
//│                 return "001-------------------------------------------------------------------------"
//│               else
//│                 return "-------------------------------------------------------------------------"
//│             end
//│         end
//│       else
//│         set tmp4 = y⁰;
//│         match tmp4
//│           1 =>
//│             return "01-------------------------------------------------------------------------"
//│           else
//│             return "-------------------------------------------------------------------------"
//│         end
//│     end
//│   else
//│     set tmp5 = x⁰;
//│     match tmp5
//│       1 =>
//│         return "1-------------------------------------------------------------------------"
//│       else
//│         return "-------------------------------------------------------------------------"
//│     end
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = "000-------------------------------------------------------------------------"

