:ucs normalized deduplicated
// `SplitDeduplicator` can detect more split-level duplications.
fun foo(x, y, z) = if
  x is 0 and
    y is 0 and
      z is 0 then "000"
    y is 1 then "01_"
    z is 1 then "0_1"
  x is 1 then "1__"
  y is 2 then "_2_"
  else "___"
//│ Normalized:
//│ >  ‹if|while›
//│ >    x is 0 and
//│ >      y is 0 and
//│ >        z is 0 then "000"
//│ >        z is 1 then "0_1"
//│ >        else "___"
//│ >      y is 1 then "01_"
//│ >      z is 1 then "0_1"
//│ >      y is 2 then "_2_"
//│ >      else "___"
//│ >    x is 1 then "1__"
//│ >    y is 2 then "_2_"
//│ >    else "___"

fun expensive_call(str: Str) = Math.pow(2, str.length)

:sir
fun foo(x, y, z) = if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else
    let value = "hello"
    expensive_call(value)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo² as fun foo³(x, y, z) {
//│   let value;
//│   match x
//│     0 =>
//│       match y
//│         0 =>
//│           match z
//│             0 =>
//│               return "000"
//│             1 =>
//│               return "001"
//│             else
//│               set value = "hello";
//│               return expensive_call⁰((value as! Str⁰))
//│           end
//│         1 =>
//│           return "01"
//│         else
//│           set value = "hello";
//│           return expensive_call⁰((value as! Str⁰))
//│       end
//│     1 =>
//│       return "1"
//│     else
//│       set value = "hello";
//│       return expensive_call⁰((value as! Str⁰))
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

foo(0, 0, 0)
//│ = "000"


object A
object B
object C

:sir
// Since no branch is duplicated, there is no label or `break`.
fun foo(x, y, z) =
  if x is A then "Hello"
  else "Goodbye"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁴ as fun foo⁵(x, y, z) { match x A⁰ => return "Hello" else return "Goodbye" end }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
// Before the deduplication is introduced:
// let foo;
// foo = function foo(x1, y, z) {
//   if (x1 instanceof A1) {
//     if (y instanceof B1) {
//       if (z instanceof C1) {
//         return "Hello"
//       } else { return "Goodbye" }
//     } else { return "Goodbye" }
//   } else { return "Goodbye" }
// };
fun foo(x, y, z) =
  if x is A and y is B and z is C then "Hello"
  else "Goodbye"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁶ as fun foo⁷(x, y, z) {
//│   match x
//│     A⁰ =>
//│       match y
//│         B⁰ =>
//│           match z
//│             C⁰ =>
//│               return "Hello"
//│             else
//│               return "Goodbye"
//│           end
//│         else
//│           return "Goodbye"
//│       end
//│     else
//│       return "Goodbye"
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
// The default branch which throws the match error should be also deduplicated.
fun foo(x, y, z) =
  if x is A and y is B and z is C then "Hello"
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define foo⁸ as fun foo⁹(x, y, z) {
//│   match x
//│     A⁰ =>
//│       match y
//│         B⁰ =>
//│           match z
//│             C⁰ =>
//│               return "Hello"
//│             else
//│               throw new globalThis⁰.Error⁰("match error")
//│           end
//│         else
//│           throw new globalThis⁰.Error⁰("match error")
//│       end
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect "Hello"
foo(A, B, C)
//│ = "Hello"

:re
foo(A, A, A)
//│ ═══[RUNTIME ERROR] Error: match error

:re
foo(A, B, B)
//│ ═══[RUNTIME ERROR] Error: match error

:sir
let y = if true then 1 else 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let scrut, tmp;
//│ set scrut = true;
//│ match scrut
//│   true =>
//│     set tmp = 1;
//│     end
//│   else
//│     set tmp = 2;
//│     end
//│ set y¹ = tmp;
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ y = 1

fun pred(x) = true

:ucs normalized
// Not only the final else is deduplicated, the `z is A` split is also deduplicated.
fun foo1(x, y, z) = if
  x is A and pred(x) then print of 1
  z is A then print of 2
  else print of 3
//│ Normalized:
//│ >  ‹if|while›
//│ >    let-split σ =
//│ >      z is member:A¹^term:foo1⁰ then member:Predef¹.print^term:foo1⁰(2)
//│ >      else member:Predef¹.print^term:foo1⁰(3)
//│ >    x is member:A¹^term:foo1⁰ and
//│ >      let tmp:scrut = member:pred⁰^term:foo1⁰(x¹)
//│ >      tmp:scrut is true then member:Predef¹.print^term:foo1⁰(1)
//│ >      $σ
//│ >    $σ

:ucs normalized deduped
// This shows a cascaded split let-binding.
fun foo2(x, y, z) = if
  x is A and pred(x) then print of 1
  y is A and pred(y) then print of 2
  z is A then print of 3
  else print of 4
//│ Normalized:
//│ >  ‹if|while›
//│ >    let-split σ =
//│ >      let-split σ =
//│ >        z is member:A¹^term:foo2⁰ then member:Predef¹.print^term:foo2⁰(3)
//│ >        else member:Predef¹.print^term:foo2⁰(4)
//│ >      y is member:A¹^term:foo2⁰ and
//│ >        let tmp:scrut = member:pred⁰^term:foo2⁰(y²)
//│ >        tmp:scrut is true then member:Predef¹.print^term:foo2⁰(2)
//│ >        $σ
//│ >      $σ
//│ >    x is member:A¹^term:foo2⁰ and
//│ >      let tmp:scrut = member:pred⁰^term:foo2⁰(x²)
//│ >      tmp:scrut is true then member:Predef¹.print^term:foo2⁰(1)
//│ >      $σ
//│ >    $σ
