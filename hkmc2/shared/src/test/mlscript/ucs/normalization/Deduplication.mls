object A
object B
object C

:sjs
// Since no branch is duplicated, there is no label or `break`.
fun foo(x, y, z) =
  if x is A then "Hello"
  else "Goodbye"
//│ JS (unsanitized):
//│ let foo3;
//│ foo3 = function foo(x1, y1, z1) {
//│   if (x1 instanceof A1.class) { return "Hello" } else { return "Goodbye" }
//│ };

