fun expensive_call(str) = Math.pow(2, str.length)

:sjs
fun foo(x, y, z) = if x is
  0 and y is
    0 and z is
      0 then "000"
      1 then "001"
    1 then "01"
  1 then "1"
  else
    let value = "hello"
    expensive_call(value)
