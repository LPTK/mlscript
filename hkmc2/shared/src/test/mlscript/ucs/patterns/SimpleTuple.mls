:js



if [1, 1] is
  [x, y] and x == y then "equal"
//│ = "equal"


fun sum(x, y) = x + y
sum(1, 2)
//│ = 3

:expect 3
fun sum([x, y]) = x + y
sum([1, 2])
//│ = 3

// Destructuring rejects non-tuples and incorrect lengths before the body runs.
:re
sum([1])
//│ ═══[RUNTIME ERROR] Error: match error

:re
sum([1, 2, 3])
//│ ═══[RUNTIME ERROR] Error: match error

:re
sum(42)
//│ ═══[RUNTIME ERROR] Error: match error

// Lambdas use the same parameter handling, and bindings survive in closures.
:expect 7
let addPair = ([x, y]) => x + y
addPair([3, 4])
//│ = 7
//│ addPair = fun

:re
addPair([3])
//│ ═══[RUNTIME ERROR] Error: match error

:expect 42
fun capture([x, [y, _]], offset) = () => x + y + offset
capture([10, [20, 99]], 12)()
//│ = 42

// Each tuple remains one argument, including trailing and curried parameters.
:expect [true, false, false]
fun eqTup2([a, b], [c, d]) = a == c and b == d
[eqTup2([1, 2], [1, 2]), eqTup2([1, 2], [1, 3]), eqTup2([1, 2], [3, 2])]
//│ = [true, false, false]

:expect 10
fun curried([a, b])([c, d]) = a + b + c + d
curried([1, 2])([3, 4])
//│ = 10

:expect 8
fun trailing(...middle, [x, y]) = middle.length + x + y
trailing(0, 0, 0, [2, 3])
//│ = 8

:expect [1, [2, 3], 4]
fun splitTuple([first, ...middle, last]) = [first, middle, last]
splitTuple([1, 2, 3, 4])
//│ = [1, [2, 3], 4]

// Empty tuple patterns are still required arguments.
:expect 42
fun empty([]) = 42
empty([])
//│ = 42

:re
empty([1])
//│ ═══[RUNTIME ERROR] Error: match error

:e
fun duplicated([x, x]) = x
//│ ╔══[COMPILATION ERROR] Duplicated pattern variable.
//│ ║  l.+1: 	fun duplicated([x, x]) = x
//│ ║        	                   ^
//│ ╟── The previous definition is as follows.
//│ ║  l.+1: 	fun duplicated([x, x]) = x
//│ ╙──      	                ^

// A failing nested pattern must not execute the body.
let entered = false
fun requireZero([0, [x]]) =
  set entered = true
  x
//│ entered = false

:re
requireZero([1, [42]])
//│ ═══[RUNTIME ERROR] Error: match error

:re
requireZero([0, []])
//│ ═══[RUNTIME ERROR] Error: match error

:expect false
entered
//│ = false

:expect 42
requireZero([0, [42]])
//│ = 42

fun test(thing) =
  if thing is [] then 0

:re
test("")
//│ ═══[RUNTIME ERROR] Error: match error

:re
test(12)
//│ ═══[RUNTIME ERROR] Error: match error

data class Point(x: Int, y: Int)

// Signatures resolve members of extracted elements before any call site.
:expect 7
fun pointSum([point]: [Point]) = point.x + point.y
pointSum([Point(3, 4)])
//│ = 7

:expect 7
fun pointSumWithSignature: ([Point]) -> Int
fun pointSumWithSignature([point]) = point.x + point.y
pointSumWithSignature([Point(3, 4)])
//│ = 7

// Generic element types remain available through the extracted binding.
:expect 3
fun singleton[A]([element]: [A]): A = element
singleton[Point]([Point(3, 4)]).x
//│ = 3

:expect 4
let fetchPoint = ([point]: [Point]) => () => point
fetchPoint([Point(3, 4)])().y
//│ = 4
//│ fetchPoint = fun

fun with_other_constructors(thing) =
  if thing is
    [x, y] then x * y
    Point(x, y) then x + y

:expect 7
with_other_constructors(Point(3, 4))
//│ = 7

:expect 12
with_other_constructors([3, 4])
//│ = 12

// A workaround is to move the tuple pattern to the last case.
fun with_other_constructors(thing) =
  if thing is
    Point(x, y) then x + y
    [x, y] then x * y

:expect 7
with_other_constructors(Point(3, 4))
//│ = 7

:expect 12
with_other_constructors([3, 4])
//│ = 12


fun with_else(x) =
  if x is
    [a, b, c] then
      a + b + c
    else
      0

with_else([1, 2, 3])
//│ = 6

with_else([1, 2])
//│ = 0

fun match_against_different_length(xs) =
  if xs is
    [] then 0
    [x] then x + 1
    [x, y] then x + y + 2
    [x, y, z] then x + y + z + 3

:expect 0
match_against_different_length([])
//│ = 0

:expect 18
match_against_different_length([17])
//│ = 18

:expect 22
match_against_different_length([9, 11])
//│ = 22

:expect 42
match_against_different_length([13, 13, 13])
//│ = 42

import "../../../mlscript-compile/Option.mls"

open Option

fun with_the_common_prefix(xs) =
  if xs is
    [Some(x)] then x + 1
    [None] then 0


