fun showTerm(t) =
  if t is
    Var(name) then String(name)
    Abs(lhs, rhs) then "λ" + showTerm(lhs) + ". " + showTerm(rhs)
    App(Abs(lhs0, lhs1), rhs) then
      "((" + "λ" + showTerm(lhs0) + ". " + showTerm(lhs1) + ") " + showTerm(rhs) + ")"
    App(lhs, rhs) then par(showTerm(lhs) + " " + showTerm(rhs))
