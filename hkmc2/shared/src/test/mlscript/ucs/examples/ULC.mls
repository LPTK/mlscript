fun subst(t: Term, x: Str, v: Term): Term =
  if t is
    Var(y) and x === y then v
    Abs(Var(y), t') and x !== y and
      hasFree(v, y) then
        let y' = freshVar(t')
        let t'' = subst(t', y, Var(y'))
        Abs(Var(y'), subst(t'', x, v))
      else
        Abs(Var(y), subst(t', x, v))
    App(lhs, rhs) then App(subst(lhs, x, v), subst(rhs, x, v))
    else t
