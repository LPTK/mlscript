fun hasFree(t, x) =
  if t is
    Var(x') then x === x'
    Abs(Var(x'), body) and x === x' then false
    Abs(Var(_), body) then hasFree(body, x)
    App(lhs, rhs) then hasFree(lhs, x) || hasFree(rhs, x)
    _ then false
