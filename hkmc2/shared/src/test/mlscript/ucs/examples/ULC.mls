fun (=:=) equalTerm(t1: Term, t2: Term) =
  if t1 is
    Var(x1)        and t2 is Var(x2)        then x1 === x2
    Abs(x1, t1')   and t2 is Abs(x2, t2')   then (x1 =:= x2) && (t1' =:= t2')
    App(t1', t1'') and t2 is App(t2', t2'') then (t1' =:= t2') && (t1'' =:= t2'')
    else false
