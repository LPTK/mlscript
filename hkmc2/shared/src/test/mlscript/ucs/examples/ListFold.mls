// Note that JavaScript doesn't have tail call optimization. Therefore, this
// implementation is still inefficient in practice.
fun join(sep) =
  fun aux(acc, xs) =
    if xs is
      Nil then acc
      Cons(x, xs') then aux(acc ~ sep ~ StrOps.from(x), xs')
  (xs) =>
    if xs is
      Cons(x, xs') then aux(StrOps.from(x), xs')
      Nil then ""
