fun foldLeft(f)(z) =
  fun aux(acc, xs) =
    if xs is
      Nil then acc
      Cons(x, xs') then aux(f(acc, x), xs')
  (xs) => aux(z, xs)

let sum = foldLeft((acc, x) => acc + x)(0)
//│ sum = fun

:expect 0
sum(Nil)
//│ = 0

:expect 6
sum(1 :: 2 :: 3 :: Nil)
//│ = 6

let product = foldLeft((acc, x) => acc * x)(1)
//│ product = fun

:expect 1
product(Nil)
//│ = 1

:expect 6
product(1 :: 2 :: 3 :: Nil)
//│ = 6

