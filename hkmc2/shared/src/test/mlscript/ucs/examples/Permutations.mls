fun permutations(xs) =
  if xs is
    Nil then Nil
    x :: Nil then (x :: Nil) :: Nil
    x :: xs' then permutations(xs')
      Iter.fromStack()
      Iter.folded of Nil, (acc, ys) => acc ::: (x ~>.. ys)

permutations(Nil) |> showLists
//│ > [
//│ > 
//│ > ]

permutations(1 :: Nil) |> showLists
//│ > [
//│ >   [1]
//│ > ]

permutations(1 :: 2 :: Nil) |> showLists
//│ > [
//│ >   [1, 2],
//│ >   [2, 1]
//│ > ]

