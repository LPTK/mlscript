fun (~>..) insertAllPositions(z, xs) =
  fun go(prev, lists, next) =
    if next is
      Nil then ((prev :+ z) :: lists) |> reverse
      head :: tail then
        let nu = ((prev :+ z) ::: next)
        go(prev :+ head, nu :: lists, tail)
  go(Nil, Nil, xs)
