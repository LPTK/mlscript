fun permutations'(xs) = if xs is
  Nil then Nil
  Cons(x, Nil) then (x :: Nil) :: Nil
  else xs
    Iter.fromStack()
    Iter.folded of Nil, (acc, x) => acc ::: permutations'(xs filter of (y) => x != y)
      Iter.fromStack()
      Iter.mapping((ys) => x :: ys)
      Iter.toStack()

permutations'(Nil) |> showLists
//│ > [
//│ > 
//│ > ]

permutations'(1 :: Nil) |> showLists
//│ > [
//│ >   [1]
//│ > ]

