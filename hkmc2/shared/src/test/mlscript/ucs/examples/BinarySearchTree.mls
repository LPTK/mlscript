fun (~~>) toBe(x, y) = if x === y then () else throw Error(String(x) + " is not " + String(y))
fun (<?) min(x, y) = if x < y then x else y
fun (>?) max(x, y) = if x > y then x else y
fun abs(x) = if x < 0 then -x else x
