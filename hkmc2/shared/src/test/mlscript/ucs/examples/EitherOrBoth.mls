fun eobToString[A, B](eob: EitherOrBoth[A, B]): Str =
  if eob is
    Left(left) then "Left(" ~ StrOps.from(left) ~ ")"
    Right(right) then "Right(" ~ StrOps.from(right) ~ ")"
    Both(left, right) then "Both(" ~ StrOps.from(left) ~ ", " ~ StrOps.from(right) ~ ")"
