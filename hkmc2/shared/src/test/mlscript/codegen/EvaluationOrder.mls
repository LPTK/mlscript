:.

// * Nested positions of the IR (call arguments and callees, operands, selection prefixes, etc.) only contain
// * stable paths, which always yield the same value: stateful paths are read into temporaries where they are
// * evaluated, so that optimizations can freely move the evaluation of nested paths.
// * See https://github.com/hkust-taco/mlscript/issues/571


// * Mutable fields are read before evaluating subsequent operands.

class A(mut val x)

fun update(o: A) =
  set o.x = 3
  o

:expect 7
:noInline
:soir
let o = new A(4)
o.x + update(o).x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2;
//│ set o⁰ = new A⁰(4);
//│ set tmp = o⁰.x⁰;
//│ set tmp1 = update⁰((o⁰ as! A⁰));
//│ set tmp2 = tmp1.x⁰;
//│ return +⁰(tmp, tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 7
//│ o = A(3)

// * The plain `val` fields of an instance created with `new mut` may be assigned after its construction:
// * this initializes them, and observing them before their final assignment is undefined behavior.

class B(val x)

:expect 3
let b = new mut B(4)
set b.x = 3
b.x
//│ = 3
//│ b = B(3)


// * Local variables reassigned in nested functions are read where they are evaluated.

fun first(x)(y) = x

:soir
:noInline
:expect 1
fun main() =
  let y = 1
  fun update() =
    set y = 2
  let p = first(y)
  update()
  p(0)
main()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹() {
//│   let update, y, tmp;
//│   define update as fun update¹() {
//│     set y = 2;
//│     return runtime⁰.Unit⁰
//│   };
//│   set y = 1;
//│   set tmp = y;
//│   do update¹();
//│   return first⁰(tmp)(0)
//│ };
//│ return main¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// * Stateful callees are read before evaluating the arguments.

:expect 1
:sir
let g = x => x + 1
fun change() =
  set g = x => x + 100
  0
g(change())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, g;
//│ define change⁰ as fun change¹() {
//│   let lambda;
//│   define lambda as fun lambda⁰(x) {
//│     return +⁰(x, 100)
//│   };
//│   set g⁰ = lambda⁰;
//│   return 0
//│ };
//│ @private
//│ define g as fun g¹(x) {
//│   return +⁰(x, 1)
//│ };
//│ set g⁰ = g¹;
//│ set tmp = g⁰;
//│ set tmp1 = change¹();
//│ return tmp(tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ g = fun


// * Top-level variables may be reassigned by later compilation units.

let counter = 1
fun bump() =
  set counter = counter + 1
  0
//│ counter = 1

:expect 1
:sir
counter + bump()
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1; set tmp = counter⁰; set tmp1 = bump⁰(); return +⁰(tmp, tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1

:expect 2
counter
//│ = 2


// * Spreads are evaluated as part of the call: their arguments are materialized into a fresh array right before
// * the call, which is then put back into the call after optimizations, so that no array is allocated.

fun three(a, b, c) = [a, b, c]

:sir
:sjs
:expect [1, 2, 3]
let xs = [2]
three(1, ...xs, 3)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let spreadArgs; set xs⁰ = [2]; set spreadArgs = [1, ...xs⁰, 3]; return three⁰(...spreadArgs)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let xs; xs = globalThis.Object.freeze([ 2 ]); return three(1, ...xs, 3)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2, 3]
//│ xs = [2]


// * Spreading an array that is never mutated is pure, so it is passed as is.

:sir
fun spreadRest(...xs) = three(...xs)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define spreadRest⁰ as fun spreadRest¹(...xs) { return three⁰(...xs) }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [1, 2, 3]
spreadRest(1, 2, 3)
//│ = [1, 2, 3]

// * Eager spread patterns bind fresh arrays, which are never mutated, so spreading them is pure;
// * lazy spread patterns may bind views of mutable arrays.

:sir
fun restOf(xs) = if xs is [_, ...rest] then three(...rest)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define restOf⁰ as fun restOf¹(xs) {
//│   let rest, middleElements, element0$;
//│   match xs
//│     Array(1+) =>
//│       set element0$ = runtime⁰.Tuple⁰.get⁰(xs, 0);
//│       set middleElements = runtime⁰.Tuple⁰.eagerSlice⁰(xs, 1, 0);
//│       set rest = middleElements;
//│       return three⁰(...rest)
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sir
fun lazyRestOf(xs) = if xs is [_, ..rest] then three(...rest)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define lazyRestOf⁰ as fun lazyRestOf¹(xs) {
//│   let rest, middleElements, element0$, spreadArgs;
//│   match xs
//│     Array(1+) =>
//│       set element0$ = runtime⁰.Tuple⁰.get⁰(xs, 0);
//│       set middleElements = runtime⁰.Tuple⁰.lazySlice⁰(xs, 1, 0);
//│       set rest = middleElements;
//│       set spreadArgs = [...rest];
//│       return three⁰(...spreadArgs)
//│     else
//│       throw new globalThis⁰.Error⁰("match error")
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:expect [[2, 3, 4], [2, 3, 4]]
[restOf([1, 2, 3, 4]), lazyRestOf([1, 2, 3, 4])]
//│ = [[2, 3, 4], [2, 3, 4]]

// * Spread arguments are only put back into their calls by code generation, so the IR of functions reused by
// * later compilation units still has its spread arguments materialized: inlining both `copyRest` and `gather`
// * binds the rest parameter of `gather` to a copy of `arr`, rather than to the mutable array `arr` itself.

fun gather(...xs) = xs

:soir
:noInline
fun copyRest(ys) = gather(...ys)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define copyRest⁰ as fun copyRest¹(ys) {
//│   let spreadArgs;
//│   set spreadArgs = [...ys];
//│   return gather⁰(...spreadArgs)
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:soir
:expect [1, 2]
let arr = mut [1, 2]
let copied = copyRest(arr)
set arr.0 = 5
copied
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let ys, spreadArgs;
//│ set arr⁰ = mut [1, 2];
//│ set ys = arr⁰;
//│ set spreadArgs = [...ys];
//│ set copied⁰ = spreadArgs;
//│ set arr⁰.0 = 5;
//│ return spreadArgs
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2]
//│ arr = [5, 2]
//│ copied = [1, 2]


// * Rest parameters are never mutated; when sanity checks are enabled, they are frozen.

:re
:noInline
fun pushRest(...xs) = xs.push(0)
pushRest(1)
//│ ═══[RUNTIME ERROR] TypeError: Cannot add property 1, object is not extensible
