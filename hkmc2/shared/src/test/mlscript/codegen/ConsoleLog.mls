:sjs


:silent
declare val console: {log: Function}
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ 
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


console.log("a")
console.log("b")
123
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1;
//│ tmp = globalThis.console;
//│ runtime.safeCall(tmp.log("a"));
//│ tmp1 = globalThis.console;
//│ runtime.safeCall(tmp1.log("b"));
//│ return 123
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > a
//│ > b
//│ = 123

let l = console.log
l(123)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let l, tmp2; tmp2 = globalThis.console; l = tmp2.log; return runtime.safeCall(tmp2.log(123))
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123
//│ l = fun log

42
