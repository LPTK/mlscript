:js


// * JavaScript classes have built-in non-writable `name` and `length` properties,
// * which can't be set directly by a normal assignment.

// * Notice: even when initialization is inlined, it must retain strict-mode assignment semantics.
:soir
:sjs
:re
:noModuleCheck
module M with
  set this."name" = "oops"
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define M⁰ as class M¹
//│ module M² {
//│   method init⁰ = fun init¹() {
//│     set M².this!"name" = "oops";
//│     do globalThis⁰.Object﹖.freeze⁰(M².this);
//│     return null
//│   }
//│ };
//│ set M²!"name" = "oops";
//│ do globalThis⁰.Object﹖.freeze⁰(M²);
//│ end
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let M1;
//│ (class M {
//│   static {
//│     M1 = this
//│   }
//│   static init() {
//│     M["name"] = "oops";
//│     runtime.safeCall(globalThis.Object.freeze(M));
//│     return null
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"];
//│ });
//│ M1["name"] = "oops";
//│ runtime.safeCall(globalThis.Object.freeze(M1));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] TypeError: Cannot assign to read only property 'name' of function 'class M {   static {     M1 = this   }   static init() {     runtime.checkArgs("init", 0, true, arguments.lengt...<omitted>... }'

// * So we use `Object.defineProperty` instead:
:sjs
module M with
  val name = "Student"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let M3;
//│ (class M2 {
//│   static {
//│     M3 = this
//│   }
//│   static init() {
//│     Object.defineProperty(M2, "name", { configurable: true, enumerable: true, writable: true, value: "Student" });
//│     runtime.safeCall(globalThis.Object.freeze(M2));
//│     return null
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "M"];
//│ });
//│ M3.init();
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// * Non-static definitions should be unaffected:
:sjs
class C with
  val name = "Student"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let C1;
//│ (class C {
//│   static {
//│     C1 = this
//│   }
//│   constructor() {
//│     this.name = "Student";
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "C"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


