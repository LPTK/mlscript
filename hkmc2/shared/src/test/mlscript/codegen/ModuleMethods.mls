:js


module Example with
  val a = 456
  fun f(x) = [x, a]

:ssjs
Example.f(123)
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ block$res2 = runtime.checkCall(Example1.f(123));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [123, 456]

:ssjs
let s = Example.f
//│ —————————————| JS (sanitized) |—————————————————————————————————————————————————————————————————————
//│ let s;
//│ s = Example1.f;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ s = fun f

s(123)
//│ = [123, 456]

:e
Example |>. s(123)
//│ ╔══[COMPILATION ERROR] Unexpected moduleful reference of type Example.
//│ ║  l.27: 	Example |>. s(123)
//│ ║        	^^^^^^^
//│ ╙── Module argument passed to a non-module parameter.
//│ = [123, 456]


