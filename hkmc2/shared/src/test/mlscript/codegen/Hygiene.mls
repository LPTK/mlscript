:js


// * Note how we avoid the name clash between the internal name `Test` of the class
// * and the external name `Test1` of its singleton instance.
:sjs
object Test with
  val x = 12
  fun foo() =
    print(Test)
    Test.x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Test1;
//│ (class Test {
//│   static {
//│     new this
//│   }
//│   constructor() {
//│     Test1 = this;
//│     this.x = 12;
//│     Object.defineProperty(this, "class", {
//│       value: Test
//│     });
//│     globalThis.Object.freeze(this);
//│   }
//│   foo() {
//│     Predef.print(Test1);
//│     return Test1.x
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["object", "Test"];
//│ });
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

Test
//│ = Test { x: 12, class: object Test }

print(Test)
//│ > Test { x: 12, class: object Test }

:sjs
Test.foo()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ return Test1.foo()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > Test { x: 12, class: object Test }
//│ = 12

:sjs
val Test = "oops"
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let Test2; Test2 = "oops";
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ Test = "oops"

:re
Test.foo()
//│ ═══[RUNTIME ERROR] TypeError: Test2.foo is not a function


