:sjs
fun example() =
  let x = 0
  let get_x() = x
  set x += 1 in print(x); print(get_x())
  print(x)
  print(get_x())
example()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let example2;
//│ example2 = function example() {
//│   let x2, get_x, old1, tmp7, tmp8, tmp9, tmp10, tmp11, get_x1;
//│   x2 = 0;
//│   get_x1 = function get_x() {
//│     return x2
//│   };
//│   get_x = get_x1;
//│   old1 = x2;
//│   try {
//│     {
//│       let inlinedVal;
//│       tmp7 = x2;
//│       tmp8 = tmp7 + 1;
//│       x2 = tmp8;
//│       tmp9 = x2;
//│       Predef.print(tmp9);
//│       inlinedVal = x2;
//│       Predef.print(inlinedVal);
//│     }
//│   } finally {
//│     x2 = old1;
//│   }
//│   tmp10 = x2;
//│   Predef.print(tmp10);
//│   tmp11 = runtime.safeCall(get_x());
//│   return Predef.print(tmp11)
//│ };
//│ return example2()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 1
//│ > 0
//│ > 0

:soir
fun example() =
  let x = 0
  let get_x() = x
  let y =
    set x += 1 in print(x); x
  print(x)
  print(get_x())
  y
example()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define example⁰ as fun example¹() {
//│   let x, get_x, old, tmp, tmp1, tmp2, tmp3, tmp4, tmp5, tmp6, get_x1;
//│   set x = 0;
//│   @private
//│   define get_x1 as fun get_x⁰() {
//│     return x
//│   };
//│   set get_x = get_x⁰;
//│   set old = x;
//│   try
//│     set tmp1 = x;
//│     set tmp2 = +⁰(tmp1, 1);
//│     set x = tmp2;
//│     set tmp3 = x;
//│     do Predef⁰.print⁰(tmp3);
//│     set tmp4 = x;
//│     set tmp = tmp4;
//│     end
//│   finally
//│     set x = old;
//│     end;
//│     set tmp5 = x;
//│   do Predef⁰.print⁰(tmp5);
//│   set tmp6 = get_x();
//│   do Predef⁰.print⁰(tmp6);
//│   return tmp
//│ };
//│ return example¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > 0
//│ > 0
//│ = 1

