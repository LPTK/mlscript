:js


let x = 0
//│ x = 0

:sjs
let x += 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let x1; x1 = x + 1;
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ x = 1

x
//│ = 1

:sjs
set x = 0
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ x1 = 0; runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

:sjs
set x += 1
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp; tmp = x1 + 1; x1 = tmp; runtime.Unit
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

x
//│ = 1


:sjs
set x += 1 in print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp1, tmp2;
//│ try { tmp1 = x1 + 1; x1 = tmp1; tmp2 = Predef.print(tmp1); } finally { x1 = tmp1; }
//│ tmp2
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2

x
//│ = 2


fun example() =
  let x = 0
  let get_x() = x
  let x += 1
  print(x)
  print(get_x())
example()
//│ > NaN
//│ > undefined

fun example() =
  let x = 0
  let get_x() = x
  set x += 1
  print(x)
  print(get_x())
example()
//│ > undefined
//│ > undefined

:sjs
fun example() =
  let x = 0
  let get_x() = x
  set x += 1 in print(x); print(get_x())
  print(x)
  print(get_x())
example()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let example2;
//│ example2 = function example() {
//│   try {
//│     Predef.print(undefined);
//│     Predef.print(undefined);
//│   } finally {}
//│   Predef.print(undefined);
//│   return Predef.print(undefined)
//│ };
//│ example2()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > undefined
//│ > undefined
//│ > undefined
//│ > undefined

:sjs
fun example() =
  let x = 0
  let get_x() = x
  let y =
    set x += 1 in print(x); x
  print(x)
  print(get_x())
  y
example()
