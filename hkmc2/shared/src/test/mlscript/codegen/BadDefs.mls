// TODO: move this test case to another file; these defs are good
:sir
fun main =
  let g() = f(42)
  let x = if maybe then if maybe then 0 else 1 else 2
  print("hello")
  let h(z) = f(z + 1)
  fun f(y) = h(x + y)
  g
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main⁴ as fun main⁵() {
