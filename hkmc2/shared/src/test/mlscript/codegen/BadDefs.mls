// TODO: reject with compilation error, as such code violates the IR's local-Define invariant
//  (the `val`'s Define node is placed in a Match's rest continuation)
:sir
fun main =
  let x = if maybe then 0 else 1
  let tmp = print("hello")
  val y = tmp
  y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹() {
//│   let y, x, scrut, tmp, tmp1;
//│   set scrut = Predef⁰.maybe⁰;
//│   match scrut
//│     true =>
//│       set tmp1 = 0;
//│       end
//│     else
//│       set tmp1 = 1;
//│       end
//│   set x = tmp1;
//│   set tmp = Predef⁰.print⁰("hello");
//│   define y as val y⁰ = tmp;
//│   return y⁰
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

