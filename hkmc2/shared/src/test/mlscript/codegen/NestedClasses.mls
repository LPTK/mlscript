:js


module Foo with
  data class C(x)

Foo.C(123).x
//│ = 123

(new Foo.C(123)).x
//│ = 123

let c = Foo.C
//│ c = fun C { class: class C }

c(123)
//│ = C(123)

:e
new c(123)
//│ ╔══[ERROR] Expected a statically known class; found reference without a resolvable definition.
//│ ║  l.20: 	new c(123)
//│ ║        	    ^
//│ ╙── The 'new' keyword requires a statically known class; use the 'new!' operator for dynamic instantiation.
//│ = C(123)

new! c(123)
//│ = C(123)


