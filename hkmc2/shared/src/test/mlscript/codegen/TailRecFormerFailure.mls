:js


import "../../mlscript-compile/Stack.mls"
open Stack


// Note: tail-rec optimized
:sir
fun go(x) = if x is
  Cons(_, _) then "Z"
  n then go([])
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define go⁰ as fun go¹(x) {
//│   loop loopLabel:
//│     let n;
//│     match x
//│       Cons⁰ =>
//│         let arg$Cons$0$, arg$Cons$1$;
//│         set arg$Cons$0$ = x.head⁰;
//│         set arg$Cons$1$ = x.tail⁰;
//│         return "Z"
//│       else
//│         let tmp;
//│         set n = x;
//│         set tmp = [];
//│         set x = tmp;
//│         continue loopLabel
//│     end
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Note: tail-rec optimized
:sir
fun go(x) = if x is
  Cons(_, Nil) then "Z"
  n then go([])
