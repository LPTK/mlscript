:js


import "../../mlscript-compile/Stack.mls"
open Stack


// Note: tail-rec optimized
:sir
fun go(x) = if x is
  Cons(_, _) then "Z"
  n then go([])
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define go⁰ as fun go¹(x) {
//│   let n, tmp;
//│   match x
//│     Cons⁰ =>
//│       let arg$Cons$0$, arg$Cons$1$;
//│       set arg$Cons$0$ = x.head⁰;
//│       set arg$Cons$1$ = x.tail⁰;
//│       set tmp = "Z";
//│       return tmp
//│     else
//│       let tmp1;
//│       set n = x;
//│       set tmp1 = [];
//│       set tmp = go¹(tmp1);
//│       return tmp
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// Note: tail-rec optimized
:sir
fun go(x) = if x is
  Cons(_, Nil) then "Z"
  n then go([])
