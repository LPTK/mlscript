// * This semantics for `else` branches is confusing,
// * as the semantics of `while ... else ...` is notably not aligned with Python's own `while`/`else` form

// * Some legitimate uses of `else` branches in `while`:

// * This is a valid, but silly use (could have inserted the `else` part _after_ the `while`!)
fun f = let x = 1 in
  while x is
    1 do
      print("`x` was `1`")
      set x = 0
    else
      print("stopping at the `else`")
      return x
