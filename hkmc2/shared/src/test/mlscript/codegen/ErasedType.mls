//│   set tmp = (i as!! Int31⁰);
//│   return useInt31¹(tmp)
//│ };
//│ end


// Aliases are resolved at cast sites, so passing between `Foo` and `FooAlias` - or down a chain - is free.
// The erased type itself keeps the alias symbol and resolves it lazily, but `print` canonicalizes every erased type
// before rendering, so an alias always prints as its target.
class Foo(x: Int)
type FooAlias = Foo
type MyInt = Int
type MyInt2 = MyInt
val w: MyInt2 = 2
fun narrow(f: FooAlias): Foo = f
fun widen(f: Foo): FooAlias = f
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define narrow⁰ as fun narrow¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define widen⁰ as fun widen¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define Foo⁴ as class Foo³ {
//│   private val x¹: Int⁰;
//│   constructor Foo⁵(x: Int⁰) { set Foo³.this.x¹ = x; end }
//│ };
//│ define w⁰ as val w¹: Int⁰ = 2;
//│ end


// An alias to a primitive resolves the same way - notably without raising the `Unrelated` error a primitive
// mismatch would.
fun useI32(n: Int32) = n
type MyI32 = Int32
fun useMyI32(x: MyI32) = useI32(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useI32⁰ as fun useI32¹(n: Int32): ? {
//│   return n
//│ };
//│ define useMyI32⁰ as fun useMyI32¹(x: Int32): ? { return useI32¹(x) };
//│ end


// An alias whose right-hand side does not resolve to a single type symbol - a cycle, or a union deferred to
// the (not-yet-implemented) LUB work - is kept as-is but behaves as the `Anything` top type during
// hierarchy analysis.
// TODO(Derppening): This test case should update once LUB is implemented.
type Cyclic = Cyclic
class P
class Q
type Union = P | Q
fun useCyclic(x: Cyclic): Cyclic = x
fun useUnion(x: Union): Union = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useCyclic⁰ as fun useCyclic¹(x: Anything): Anything {
//│   return x
//│ };
//│ define useUnion⁰ as fun useUnion¹(x: Anything): Anything {
//│   return x
//│ };
//│ define P⁰ as class P¹;
//│ define Q⁰ as class Q¹;
//│ end


class Base
class A extends Base
class B extends Base
fun threeOf(x: A | B | Base): Int = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define threeOf⁰ as fun threeOf¹(x: Base⁰): Int⁰ {
//│   return 0
//│ };
//│ define Base¹ as class Base⁰;
//│ define A⁰ as class A¹ extends Base⁰ {};
//│ define B⁰ as class B¹ extends Base⁰ {};
//│ end


// Casts are decided against the collapsed slot type: `A | B` erases to `Base`, so only `A | B -> A` is a
// downcast.
fun takesBase(b: Base): () = ()
fun takesUnion(u: A | B): () = ()
fun takesSubtype(a: A): () = ()
fun unionIntoBase(x: A | B) = takesBase(x)
fun memberIntoUnion(a: A) = takesUnion(a)
fun baseIntoUnion(b: Base) = takesUnion(b)
fun unionIntoSubtype(x: A | B) = takesSubtype(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takesBase⁰ as fun takesBase¹(b: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnion⁰ as fun takesUnion¹(u: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesSubtype⁰ as fun takesSubtype¹(a: A¹): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define unionIntoBase⁰ as fun unionIntoBase¹(x: Base⁰): ? {
//│   return takesBase¹(x)
//│ };
//│ define memberIntoUnion⁰ as fun memberIntoUnion¹(a: A¹): ? {
//│   return takesUnion¹(a)
//│ };
//│ define baseIntoUnion⁰ as fun baseIntoUnion¹(b: Base⁰): ? {
//│   return takesUnion¹(b)
//│ };
//│ define unionIntoSubtype⁰ as fun unionIntoSubtype¹(x: Base⁰): ? {
//│   let tmp: A¹;
//│   set tmp = (x as!! A¹);
//│   return takesSubtype¹(tmp)
//│ };
//│ end


// `sccF`'s tail call is folded into the merged dispatcher, dropping its `as Int` coercion; entering at `sccF` can exit
// through `sccG`'s arm, so the coercion is re-placed on `sccF`'s stub.
:soir
fun sccF(): Int = sccG()
fun sccG(): Object = sccF() + 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   return (sccG⁰() as!! Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Object {
//│   let tmp: Int⁰;
//│   set tmp = sccF¹();
//│   return (+⁰(tmp, 1) as!! Object)
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   let id: Int⁰, inlinedVal: Object;
//│   set id = 0;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match id
//│         0 =>
//│           set id = 1;
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as!! Object);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return (inlinedVal as!! Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Object {
//│   let id: Int⁰, inlinedVal: Object;
//│   set id = 1;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match id
//│         0 =>
//│           set id = 1;
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as!! Object);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return inlinedVal
//│ };
//│ end


// Checks whether `annotLoop(n - 1)` still produces a tail call even though it is wrapped in a `Cast` node.
:js
@tailrec
fun annotLoop(n: Int): () = annotHelper(n)
fun annotHelper(n) = if n <= 0 then () else annotLoop(n - 1)
annotHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define annotLoop⁰ as fun annotLoop¹(n: Int⁰): Unit⁰ {
//│   return (annotHelper⁰(n) as!! Unit⁰)
//│ };
//│ define annotHelper¹ as fun annotHelper⁰(n: ?): ? {
//│   let scrut: ?, tmp: ?, tmp1: Int⁰;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return runtime⁰.Unit⁰
//│     else
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = (tmp as!! Int⁰);
//│       return annotLoop¹(tmp1)
//│   end
//│ };
//│ return annotHelper⁰(100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Checks whether the let-bound tail call `r` still produces a tail call even though it is wrapped in a `Cast` node.
// A dropped return coercion is re-placed on the stub of the function that dropped it.
:soir
:js
@tailrec
fun sccLoop(n: Int): Int =
  let r = sccHelper(n)
  r
fun sccHelper(n: Int): Object = if n <= 0 then 0 else sccLoop(n - 1)
sccHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   let r: ?;
//│   set r = sccHelper⁰(n);
//│   return (r as!! Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Object {
//│   let scrut: ?, tmp: ?, tmp1: Int⁰;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return 0
//│     else
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = (tmp as!! Int⁰);
//│       return sccLoop¹(tmp1)
//│   end
//│ };
//│ return sccHelper⁰(100000)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sccLoop_sccHelper;
//│ define sccLoop_sccHelper as fun sccLoop_sccHelper⁰(id: Int⁰, param0: ?): Object {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut: ?, tmp: ?, tmp1: Int⁰;
//│         set scrut = <=⁰(param0, 0);
//│         match scrut
//│           true =>
//│             return 0
//│           else
//│             set tmp = -⁰(param0, 1);
//│             set tmp1 = (tmp as!! Int⁰);
//│             set param0 = tmp1;
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   return (sccLoop_sccHelper⁰(0, n) as!! Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Object {
//│   return sccLoop_sccHelper⁰(1, n)
//│ };
//│ return sccLoop_sccHelper⁰(1, 100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// Ensure that `Anything` is resolved to `(ErasedType.)Anything` and not `ErasedType.AnyRef(_, Anything)`
// (which is indicated by `Anything⁰`).
fun f(x: Anything): Anything = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁶ as fun f⁷(x: Anything): Anything { return x }; end


// A call is typed as the callee's result only when saturated: `curried(1)` supplies one of two declared
// parameter lists, so it is the residual function, not an `Int`.
fun curried(a: Int)(b: Int): Int = a + b
fun useFn(g: Function) = g(1)
useFn(curried(1))
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰;
//│ define curried⁰ as fun curried¹(a: Int⁰)(b: Int⁰): Int⁰ {
//│   return (+⁰(a, b) as!! Int⁰)
//│ };
//│ define useFn⁰ as fun useFn¹(g: Function⁰): ? {
//│   return g(1)
//│ };
//│ set tmp = curried¹(1);
//│ return useFn¹(tmp)


val done: Int = curried(1)(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int⁰; set tmp = curried¹(1)(2); define done⁰ as val done¹: Int⁰ = tmp; end


// Counting lists must account for normalization: a `fun` with no parameter list keeps `Nil` in its
// signature, but lowering gives it one empty list and calls it with one empty argument list. `thunk()` is
// therefore saturated, and only the further `(2)` needs narrowing to `Int`.
fun thunk: Function = (b: Int) => b + 1
val over: Int = thunk(2)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰, tmp1: ?, tmp2: Int⁰;
//│ define thunk⁰ as fun thunk¹(): Function⁰ {
//│   let lambda;
//│   @private
//│   define lambda as fun lambda⁰(b: Int⁰) {
//│     return +⁰(b, 1)
//│   };
//│   return (lambda⁰ as!! Function⁰)
//│ };
//│ set tmp = thunk¹();
//│ set tmp1 = tmp(2);
//│ set tmp2 = (tmp1 as!! Int⁰);
//│ define over⁰ as val over¹: Int⁰ = tmp2;
//│ end


// Complements the lowered IR from the block above: This block asserts that a saturated `thunk` keeps
// `Function` and cannot narrow to `Str`, where an over-applied reading would take the top type and
// raise nothing.
:ge
val bad: Str = thunk
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Function' to unrelated type 'Str'
//│ ║  l.650: 	val bad: Str = thunk
//│ ╙──       	               ^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Function⁰; set tmp = thunk¹(); define bad² as val bad³: Str⁰ = tmp; end


// The counterpart: *no* parameter list must stay distinct from *one empty* one, since only the former is
// auto-invoked, so a bare `called` is the function itself. Asserted for the same reason as above.
:ge
fun called() = 3
val notCalled: Str = called
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Function' to unrelated type 'Str'
//│ ║  l.662: 	val notCalled: Str = called
//│ ╙──       	                     ^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define called⁰ as fun called¹(): ? {
//│   return 3
//│ };
//│ define notCalled⁰ as val notCalled¹: Str⁰ = called¹;
//│ end


// Under `:checkCasts` the printer spells a checked cast `as T` and an unchecked one `as! T`. The flag is read
// once, where the coercion is introduced, so the IR is otherwise identical to the casts above. What the mark
// expands into is covered by `CheckedCasts.mls`.
:checkCasts
fun mkObj2(): Object = new Object()
val o2: Object = mkObj2()
val n2: Int = o2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Object, tmp1: Int⁰;
//│ define mkObj2⁰ as fun mkObj2¹(): Object {
//│   return new globalThis⁰.Object⁰()
//│ };
//│ set tmp = mkObj2¹();
//│ define o2⁰ as val o2¹: Object = tmp;
//│ set tmp1 = (o2¹ as! Int⁰);
//│ define n2⁰ as val n2¹: Int⁰ = tmp1;
//│ end


// An instantiation is typed as its class, so it cannot fill a primitive slot. Asserted rather than left to
// the elided casts above: were the `Instantiate` type lost, this would silently become an ordinary downcast.
:ge
fun badInst() = useInt(new Bar("x"))
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Bar' to unrelated type 'Int'
//│ ║  l.696: 	fun badInst() = useInt(new Bar("x"))
//│ ╙──       	                       ^^^^^^^^^^^^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define badInst⁰ as fun badInst¹(): ? {
//│   let tmp: Bar⁰;
//│   set tmp = new Bar⁰("x");
//│   return useInt³(tmp)
//│ };
//│ end
