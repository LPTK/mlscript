:sir

//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ import "..." as Predef; end

// Erased types come only from explicit type annotations. An unannotated local —
// even one bound to a literal — carries no erased type.
:siret
let i = 1
let f = 1.5
let s = "str"
let b = true
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ set i⁰ = 1; set f⁰ = 1.5; set s⁰ = "str"; set b⁰ = true; end


// Tuple and record bindings are unannotated too, so they stay `: ?`.
:siret
let t = [i, s]
let r = {x: i, y: s}
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x: ?, y: ?; set t⁰ = [i⁰, s⁰]; set x = i⁰; set y = s⁰; set r⁰ = { "x": x, "y": y }; end


// A class's annotated parameters give its fields a type, for both a private
// (`x: Int`) and a `val` (`y: Str`) parameter. The instantiation result itself
// is not typed from the class.
:siret
class Foo(x: Int)
let foo = new Foo(123)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Int;
//│ define Foo⁰ as class Foo² {
//│   private val x⁰: Int;
//│   constructor Foo¹(x: Int) {
//│     set Foo².this.x⁰ = x;
//│     end
//│   }
//│ };
//│ set tmp = (123 as Int);
//│ set foo⁰ = new Foo²(tmp);
//│ end

:siret
class Bar(val y: Str)
let bar = new Bar("hi")
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Str;
//│ define Bar⁰ as class Bar² {
//│   val y⁰: Str;
//│   constructor Bar¹(y: Str) {
//│     define y⁰ as val y¹: Str = y;
//│     end
//│   }
//│ };
//│ set tmp = ("hi" as Str);
//│ set bar⁰ = new Bar²(tmp);
//│ end


// An unannotated function has unknown parameter and return types, so the call
// result and the (unresolved) field selection both stay `: ?`.
:siret
fun mk(a) = new Bar(a)
let made = mk(1)
let sel = made.y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mk⁰ as fun mk¹(a: ?): ? {
//│   let tmp: Str;
//│   set tmp = (a as Str);
//│   return new Bar²(tmp)
//│ };
//│ set made⁰ = mk¹(1);
//│ set sel⁰ = made⁰.y﹖;
//│ end


// Parameter annotations are kept (`x: Int`, `y: Int`); the unannotated return
// stays `: ?` — it is never inferred from the body.
:siret
fun add(x: Int, y: Int) = x + y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define add⁰ as fun add¹(x: Int, y: Int): ? { return +⁰(x, y) }; end


// A parameter keeps its annotated type regardless of a later reassignment; there
// is no widening/join from the assigned value.
:siret
fun keep(x: Int) =
  set x = 5
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define keep⁰ as fun keep¹(x: Int): ? { set x = (5 as Int); return x }; end


// Return-type annotations are rendered at the `fun ...: T` definition site, for
// both primitive and class return types.
:siret
fun addUp(x: Int, y: Int): Int = x + y
fun makeBar(s: Str): Bar = new Bar(s)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define addUp⁰ as fun addUp¹(x: Int, y: Int): Int {
//│   return +⁰(x, y)
//│ };
//│ define makeBar⁰ as fun makeBar¹(s: Str): Bar² { return new Bar²(s) };
//│ end


// Without a return annotation, the declared return stays `: ?` regardless of the
// body's shape — a builtin comparison, an instantiation, and an identity return
// are all left unknown.
:siret
fun lt(a, b) = a < b
fun mkBar(a) = new Bar(a)
fun ident(a) = a
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define lt⁰ as fun lt¹(a: ?, b: ?): ? {
//│   return <⁰(a, b)
//│ };
//│ define mkBar⁰ as fun mkBar¹(a: ?): ? {
//│   let tmp: Str;
//│   set tmp = (a as Str);
//│   return new Bar²(tmp)
//│ };
//│ define ident⁰ as fun ident¹(a: ?): ? { return a };
//│ end


// A rest parameter has no annotation, so it stays `: ?`.
:siret
fun rest(a, ...xs) = xs
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rest⁰ as fun rest¹(a: ?, ...xs: ?): ? { return xs }; end


// Method return-type annotations are rendered like free functions; an
// unannotated method stays `: ?`.
:siret
class Calc() with
  fun twice(x: Int): Int = x + x
  fun whatever(a) = a
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Calc⁰ as class Calc² {
//│   constructor Calc¹
//│   method twice⁰ = fun twice¹(x: Int): Int {
//│     return +⁰(x, x)
//│   }
//│   method whatever⁰ = fun whatever¹(a: ?): ? { return a }
//│ };
//│ end


// A selection resolved to a member (`this.v`) still carries that member's
// annotated type, but without a return annotation the field getter's declared
// return stays `: ?`.
:siret
class Box(val v: Int) with
  fun get() = v
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   val v⁰: Int;
//│   constructor Box¹(v: Int) {
//│     define v⁰ as val v¹: Int = v;
//│     end
//│   }
//│   method get⁰ = fun get¹(): ? { return Box².this.v¹ }
//│ };
//│ end


// Closure capture (`:lift`): the generated capture class and its field are not
// typed from the captured local, so they stay `: ?`.
:siret
:lift
fun counter() =
  let n = 0
  fun bump() = set n = n + 1
  bump()
  n
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bump, Capture$scope0;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(n$0: ?) {
//│     define n$0⁰ as val n$0¹: ? = n$0;
//│     end
//│   }
//│ };
//│ define bump as fun bump⁰(scope0$cap: ?): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(scope0$cap.n$0¹, 1);
//│   set scope0$cap.n$0¹ = tmp;
//│   return runtime⁰.Unit⁰
//│ };
//│ define counter⁰ as fun counter¹(): ? {
//│   let n: ?, scope0$cap: ?;
//│   set scope0$cap = new mut Capture$scope0¹(n);
//│   set scope0$cap.n$0¹ = 0;
//│   do bump⁰(scope0$cap);
//│   return scope0$cap.n$0¹
//│ };
//│ end
