// A selection resolved to a member (`this.v`) still carries that member's annotated type.
class Box(val v: Int) with
  fun get() = v
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   val v²: Int⁰;
//│   constructor Box¹(v: Int⁰) {
//│     define v² as val v³: Int⁰ = v;
//│     end
//│   }
//│   method get⁰ = fun get¹(): ? { return Box².this.v³ }
//│ };
//│ end


// Closure capture (`:lift`): the generated capture class and its field are not
// typed from the captured local, so they stay `: ?`.
:lift
fun counter(x: Int) =
  let n = 0
  fun bump() = set n = n + x
  bump()
  n
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bump, Capture$scope0;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(n$0: ?) {
//│     define n$0⁰ as val n$0¹: ? = n$0;
//│     end
//│   }
//│ };
//│ define bump as fun bump⁰(scope0$cap: ?, x: ?): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(scope0$cap.n$0¹, x);
//│   set scope0$cap.n$0¹ = tmp;
//│   return runtime⁰.Unit⁰
//│ };
//│ define counter⁰ as fun counter¹(x: Int⁰): ? {
//│   let n: ?, scope0$cap: ?;
//│   set scope0$cap = new mut Capture$scope0¹(n);
//│   set scope0$cap.n$0¹ = 0;
//│   do bump⁰(scope0$cap, x);
//│   return scope0$cap.n$0¹
//│ };
//│ end


