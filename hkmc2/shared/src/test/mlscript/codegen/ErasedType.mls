// `Int <: Object` - So passing `Int -> Object` and v/v is allowed.
fun useObj(o: Object) = o
fun useInt(n: Int) = n
fun f(o: Object, i: Int) =
  useObj(i)
  useInt(o)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj² as fun useObj³(o: Object): ? {
//│   return o
//│ };
//│ define useInt² as fun useInt³(n: Int⁰): ? {
//│   return n
//│ };
//│ define f⁴ as fun f⁵(o: Object, i: Int⁰): ? {
//│   let tmp: Int⁰;
//│   do useObj³(i);
//│   set tmp = (o as!! Int⁰);
//│   return useInt³(tmp)
//│ };
//│ end


// `Int31 <: Int`.
fun useInt31(n: Int31) = n
fun g(i: Int, i31: Int31) =
  useInt(i31)
  useInt31(i)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useInt31⁰ as fun useInt31¹(n: Int31⁰): ? {
