
:global
:sir
:siret


// Note: Needed for `@tailrec`
open annotations
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end


// Erased types come only from explicit type annotations. An unannotated local - even one bound to a
// literal - carries no erased type.
fun main =
  let i = 1
  let f = 1.5
  let s = "str"
  let b = true
  let t = [i, s]
  let r = {x: i, y: s}
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹(): ? {
//│   let i: ?, f: ?, s: ?, b: ?, t: ?, r: ?, x: ?, y: ?;
//│   set i = 1;
//│   set f = 1.5;
//│   set s = "str";
//│   set b = true;
//│   set t = [i, s];
//│   set x = i;
//│   set y = s;
//│   set r = { "x": x, "y": y };
//│   return runtime⁰.Unit⁰
//│ };
//│ end


// Value definitions are typed if they have explicit type annotations.
// Note: `let` bindings cannot be annotated, so they are always `: ?`
val i: Int = 1
val f: Num = 1.5
val s: Str = "str"
val b: Bool = true
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define i⁰ as val i¹: Int⁰ = 1;
//│ define f⁰ as val f¹: Num⁰ = 1.5;
//│ define s⁰ as val s¹: Str⁰ = "str";
//│ define b⁰ as val b¹: Bool⁰ = true;
//│ end


// A `val` initializer is narrowed to the declared type, like a parameter or a return.
fun mkObj(): Object = new Object()
val o: Object = mkObj()
val n: Int = o
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Object⁰, tmp1: Int⁰;
//│ define mkObj⁰ as fun mkObj¹(): Object⁰ {
//│   return (new globalThis⁰.Object⁰() as Object⁰)
//│ };
//│ set tmp = mkObj¹();
//│ define o⁰ as val o¹: Object⁰ = tmp;
//│ set tmp1 = (o¹ as Int⁰);
//│ define n⁰ as val n¹: Int⁰ = tmp1;
//│ end


// `()` in annotation position denotes the unit type.
fun retUnit(): () = ()
fun takesUnit(u: ()): () = u
fun passUnit(): () = takesUnit(())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define retUnit⁰ as fun retUnit¹(): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnit⁰ as fun takesUnit¹(u: Unit⁰): Unit⁰ {
//│   return u
//│ };
//│ define passUnit⁰ as fun passUnit¹(): Unit⁰ { return takesUnit¹(runtime⁰.Unit⁰) };
//│ end


// A class's annotated parameters give its fields a type.
class Foo(x: Int)
class Bar(val y: Str)
fun main =
  let foo = new Foo(123)
  let bar = new Bar("hi")
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main² as fun main³(): ? {
//│   let foo: ?, bar: ?;
//│   set foo = new Foo⁰(123);
//│   set bar = new Bar⁰("hi");
//│   return runtime⁰.Unit⁰
//│ };
//│ define Foo¹ as class Foo⁰ {
//│   private val x⁰: Int⁰;
//│   constructor Foo²(x: Int⁰) {
//│     set Foo⁰.this.x⁰ = x;
//│     end
//│   }
//│ };
//│ define Bar¹ as class Bar⁰ {
//│   val y⁰: Str⁰;
//│   constructor Bar²(y: Str⁰) { define y⁰ as val y¹: Str⁰ = y; end }
//│ };
//│ end


// An unannotated function has unknown parameter and return types.
fun mk(a) = new Bar(a)
fun main =
  let made = mk(1)
  made.y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define mk⁰ as fun mk¹(a: ?): ? {
//│   let tmp: Str⁰;
//│   set tmp = (a as Str⁰);
//│   return new Bar⁰(tmp)
//│ };
//│ define main⁴ as fun main⁵(): ? { let made: ?; set made = mk¹(1); return made.y﹖ };
//│ end


:ge
fun test(x: Int): Int = "oops"
//│ ═══[COMPILATION ERROR] Cannot narrow a value of type 'Str' to unrelated type 'Int'
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define test⁰ as fun test¹(x: Int⁰): Int⁰ { return "oops" }; end


// Parameter and return annotations are kept (`x: Int`, `y: Int`); the unannotated return stays
// `: ?` - it is never inferred from the body.
fun add1(x: Int, y: Int) = x + y
fun add2(x: Int, y: Int): Int = x + y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define add1⁰ as fun add1¹(x: Int⁰, y: Int⁰): ? {
//│   return +⁰(x, y)
//│ };
//│ define add2⁰ as fun add2¹(x: Int⁰, y: Int⁰): Int⁰ { return (+⁰(x, y) as Int⁰) };
//│ end


// A parameter keeps its annotated type regardless of a later reassignment.
fun keep(x: Int) =
  set x = 5
  x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define keep⁰ as fun keep¹(x: Int⁰): ? { set x = 5; return x }; end


// An annotated mutable field narrows the assigned value at the field-assignment site.
class Ref(mut val v: Int) with
  fun put(x) = set v = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Ref⁰ as class Ref² {
//│   val v⁰: Int⁰;
//│   constructor Ref¹(v: Int⁰) {
//│     define v⁰ as val v¹: Int⁰ = v;
//│     end
//│   }
//│   method put⁰ = fun put¹(x: ?): ? { set Ref².this.v¹ = (x as Int⁰); return runtime⁰.Unit⁰ }
//│ };
//│ end


// Return-type annotations are rendered at the `fun ...: T` definition site.
fun addUp(x: Int, y: Int): Int = x + y
fun makeBar(s: Str): Bar = new Bar(s)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define addUp⁰ as fun addUp¹(x: Int⁰, y: Int⁰): Int⁰ {
//│   return (+⁰(x, y) as Int⁰)
//│ };
//│ define makeBar⁰ as fun makeBar¹(s: Str⁰): Bar⁰ { return (new Bar⁰(s) as Bar⁰) };
//│ end


// Without a return annotation, the declared return stays `: ?`.
fun lt(a, b) = a < b
fun mkBar(a) = new Bar(a)
fun ident(a) = a
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define lt⁰ as fun lt¹(a: ?, b: ?): ? {
//│   return <⁰(a, b)
//│ };
//│ define mkBar⁰ as fun mkBar¹(a: ?): ? {
//│   let tmp: Str⁰;
//│   set tmp = (a as Str⁰);
//│   return new Bar⁰(tmp)
//│ };
//│ define ident⁰ as fun ident¹(a: ?): ? { return a };
//│ end


// A rest parameter has no annotation, so it stays `: ?`.
fun rest(a, ...xs) = xs
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define rest⁰ as fun rest¹(a: ?, ...xs: ?): ? { return xs }; end


// Method return-type annotations are rendered like free functions.
class Calc() with
  fun twice(x: Int): Int = x + x
  fun whatever(a) = a
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Calc⁰ as class Calc² {
//│   constructor Calc¹
//│   method twice⁰ = fun twice¹(x: Int⁰): Int⁰ {
//│     return (+⁰(x, x) as Int⁰)
//│   }
//│   method whatever⁰ = fun whatever¹(a: ?): ? { return a }
//│ };
//│ end


// A selection resolved to a member (`this.v`) still carries that member's annotated type.
class Box(val v: Int) with
  fun get() = v
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define Box⁰ as class Box² {
//│   val v²: Int⁰;
//│   constructor Box¹(v: Int⁰) {
//│     define v² as val v³: Int⁰ = v;
//│     end
//│   }
//│   method get⁰ = fun get¹(): ? { return Box².this.v³ }
//│ };
//│ end


// Closure capture (`:lift`): the generated capture class and its field are not
// typed from the captured local, so they stay `: ?`.
:lift
fun counter(x: Int) =
  let n = 0
  fun bump() = set n = n + x
  bump()
  n
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let bump, Capture$scope0;
//│ define Capture$scope0 as class Capture$scope0¹ {
//│   constructor Capture$scope0⁰(n$0: ?) {
//│     define n$0⁰ as val n$0¹: ? = n$0;
//│     end
//│   }
//│ };
//│ define bump as fun bump⁰(scope0$cap: ?, x: ?): ? {
//│   let tmp: ?;
//│   set tmp = +⁰(scope0$cap.n$0¹, x);
//│   set scope0$cap.n$0¹ = tmp;
//│   return runtime⁰.Unit⁰
//│ };
//│ define counter⁰ as fun counter¹(x: Int⁰): ? {
//│   let n: ?, scope0$cap: ?;
//│   set scope0$cap = new mut Capture$scope0¹(n);
//│   set scope0$cap.n$0¹ = 0;
//│   do bump⁰(scope0$cap, x);
//│   return scope0$cap.n$0¹
//│ };
//│ end


// Passing a primitive (`Int32`) to a slot expecting `Object` is a compilation error.
:ge
fun useObj(o: Object) = o
fun f(x: Int32) = useObj(x)
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Int32' to unrelated type 'Object'
//│ ║  l.266: 	fun f(x: Int32) = useObj(x)
//│ ╙──       	                         ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj⁰ as fun useObj¹(o: Object⁰): ? {
//│   return o
//│ };
//│ define f² as fun f³(x: Int32): ? { return useObj¹(x) };
//│ end


// The reverse - passing a reference (`Object`) into a slot expecting a primitive (`Int32`) slot is
// also a compilation error.
:ge
fun useInt(n: Int32) = n
fun g(o: Object) = useInt(o)
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Object' to unrelated type 'Int32'
//│ ║  l.282: 	fun g(o: Object) = useInt(o)
//│ ╙──       	                          ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useInt⁰ as fun useInt¹(n: Int32): ? {
//│   return n
//│ };
//│ define g⁰ as fun g¹(o: Object⁰): ? { return useInt¹(o) };
//│ end


// Same-named types are told apart by qualifying each name with its owner chain.
:ge
class Shape
fun useShape(x: Shape) = x
module Encl with
  class Shape
  fun bad(x: Shape) = useShape(x)
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Encl.Shape' to unrelated type 'Shape'
//│ ║  l.300: 	  fun bad(x: Shape) = useShape(x)
//│ ╙──       	                               ^
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useShape⁰ as fun useShape¹(x: Shape⁰): ? {
//│   return x
//│ };
//│ define Shape¹ as class Shape⁰;
//│ define Encl⁰ as class Encl¹
//│ module Encl² {
//│   constructor {
//│     define Shape² as class Shape³;
//│     end
//│   }
//│   method bad⁰ = fun bad¹(x: Shape³): ? { return useShape¹(x) }
//│ };
//│ end


// `Int <: Object` - So passing `Int -> Object` and v/v is allowed.
fun useObj(o: Object) = o
fun useInt(n: Int) = n
fun f(o: Object, i: Int) = 
  useObj(i)
  useInt(o)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useObj² as fun useObj³(o: Object⁰): ? {
//│   return o
//│ };
//│ define useInt² as fun useInt³(n: Int⁰): ? {
//│   return n
//│ };
//│ define f⁴ as fun f⁵(o: Object⁰, i: Int⁰): ? {
//│   let tmp: Int⁰;
//│   do useObj³(i);
//│   set tmp = (o as Int⁰);
//│   return useInt³(tmp)
//│ };
//│ end


// `Int31 <: Int`.
fun useInt31(n: Int31) = n
fun g(i: Int, i31: Int31) =
  useInt(i31)
  useInt31(i)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useInt31⁰ as fun useInt31¹(n: Int31⁰): ? {
//│   return n
//│ };
//│ define g² as fun g³(i: Int⁰, i31: Int31⁰): ? {
//│   let tmp: Int31⁰;
//│   do useInt³(i31);
//│   set tmp = (i as Int31⁰);
//│   return useInt31¹(tmp)
//│ };
//│ end


// A type alias annotation is kept as-is in the erased type. A chain of aliases is likewise preserved.
type MyInt = Int
val v: MyInt = 1
type MyInt2 = MyInt
val w: MyInt2 = 2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define v⁴ as val v⁵: Int⁰ = 1; define w⁰ as val w¹: Int⁰ = 2; end


// Aliases are resolved at cast sites, so no casts are inserted when passing between `Foo` and `FooAlias`.
class Foo(x: Int)
type FooAlias = Foo
fun narrow(f: FooAlias): Foo = f
fun widen(f: Foo): FooAlias = f
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define narrow⁰ as fun narrow¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define widen⁰ as fun widen¹(f: Foo³): Foo³ {
//│   return f
//│ };
//│ define Foo⁴ as class Foo³ {
//│   private val x¹: Int⁰;
//│   constructor Foo⁵(x: Int⁰) { set Foo³.this.x¹ = x; end }
//│ };
//│ end


// Similarly, an alias to a primitive is resolved at cast sites, so no casts are inserted (nor errors emitted) when 
// passing an aliased primitive to a function expecting the underlying primitive type (and v/v).
fun useI32(n: Int32) = n
type MyI32 = Int32
fun useMyI32(x: MyI32) = useI32(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useI32⁰ as fun useI32¹(n: Int32): ? {
//│   return n
//│ };
//│ define useMyI32⁰ as fun useMyI32¹(x: Int32): ? { return useI32¹(x) };
//│ end


// An alias whose right-hand side does not resolve to a single type symbol - a cycle, or a union deferred to
// the (not-yet-implemented) LUB work - is kept as-is but behaves as the `Anything` top type during
// hierarchy analysis.
// TODO(Derppening): This test case should update once LUB is implemented.
type Cyclic = Cyclic
class P
class Q
type Union = P | Q
fun useCyclic(x: Cyclic): Cyclic = x
fun useUnion(x: Union): Union = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define useCyclic⁰ as fun useCyclic¹(x: Anything): Anything {
//│   return x
//│ };
//│ define useUnion⁰ as fun useUnion¹(x: Anything): Anything {
//│   return x
//│ };
//│ define P⁰ as class P¹;
//│ define Q⁰ as class Q¹;
//│ end


// A (possibly nested) union annotation collapses to the least upper bound of its members, and the slot prints that
// single type.
class Base
class A extends Base
class B extends Base
fun oneOf(x: A | B): Int = 0
fun threeOf(x: A | B | Base): Int = 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define oneOf⁰ as fun oneOf¹(x: Base⁰): Int⁰ {
//│   return 0
//│ };
//│ define threeOf⁰ as fun threeOf¹(x: Base⁰): Int⁰ {
//│   return 0
//│ };
//│ define Base¹ as class Base⁰;
//│ define A⁰ as class A¹ extends Base⁰ {};
//│ define B⁰ as class B¹ extends Base⁰ {};
//│ end


// Casts are determined against the collapsed slot type:
//
// - `A | B` -> `Base` is an identity conversion since `A | B`'s LUB is `Base`.
//   - Similarly, `Base` -> `A | B` is an identity conversion.
// - `A` -> `A | B` is an upcast since `A <: Base`.
// - `A | B` -> `A` is a *downcast* since `A | B`'s LUB is `Base` and `Base <: A` is false.
fun takesBase(b: Base): () = ()
fun takesUnion(u: A | B): () = ()
fun takesSubtype(a: A): () = ()
fun unionIntoBase(x: A | B) = takesBase(x)
fun memberIntoUnion(a: A) = takesUnion(a)
fun baseIntoUnion(b: Base) = takesUnion(b)
fun unionIntoSubtype(x: A | B) = takesSubtype(x)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takesBase⁰ as fun takesBase¹(b: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnion⁰ as fun takesUnion¹(u: Base⁰): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesSubtype⁰ as fun takesSubtype¹(a: A¹): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define unionIntoBase⁰ as fun unionIntoBase¹(x: Base⁰): ? {
//│   return takesBase¹(x)
//│ };
//│ define memberIntoUnion⁰ as fun memberIntoUnion¹(a: A¹): ? {
//│   return takesUnion¹(a)
//│ };
//│ define baseIntoUnion⁰ as fun baseIntoUnion¹(b: Base⁰): ? {
//│   return takesUnion¹(b)
//│ };
//│ define unionIntoSubtype⁰ as fun unionIntoSubtype¹(x: Base⁰): ? {
//│   let tmp: A¹;
//│   set tmp = (x as A¹);
//│   return takesSubtype¹(tmp)
//│ };
//│ end


// `sccF`'s tail call is folded into the merged dispatcher, dropping its `as Int` coercion; entering at `sccF` can exit
// through `sccG`'s arm, so the coercion is re-placed on `sccF`'s stub.
:soir
fun sccF(): Int = sccG()
fun sccG(): Object = sccF() + 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   return (sccG⁰() as Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Object⁰ {
//│   let tmp: Int⁰;
//│   set tmp = sccF¹();
//│   return (+⁰(tmp, 1) as Object⁰)
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define sccF⁰ as fun sccF¹(): Int⁰ {
//│   let id: ?, inlinedVal: ?;
//│   set id = 0;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match id
//│         0 =>
//│           set id = 1;
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as Object⁰);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return (inlinedVal as Int⁰)
//│ };
//│ define sccG¹ as fun sccG⁰(): Object⁰ {
//│   let inlinedVal: ?;
//│   block inlinedLbl:
//│     loop loopLabel:
//│       match 1
//│         0 =>
//│           continue loopLabel
//│         1 =>
//│           let tmp: Int⁰;
//│           set tmp = sccF¹();
//│           set inlinedVal = (+⁰(tmp, 1) as Object⁰);
//│           break inlinedLbl
//│         else
//│           unreachable /* dispatch tag is always a merged member id */
//│       end
//│     unreachable /* Rest of abortive labelled block */
//│   return inlinedVal
//│ };
//│ end


// Checks whether `annotLoop(n - 1)` still produces a tail call even though it is wrapped in a `Cast` node.
// Also runs the compiled JS to ensure that the tail call is preserved and does not overflow the stack.
:js
@tailrec
fun annotLoop(n: Int): () = annotHelper(n)
fun annotHelper(n) = if n <= 0 then () else annotLoop(n - 1)
annotHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define annotLoop⁰ as fun annotLoop¹(n: Int⁰): Unit⁰ {
//│   return (annotHelper⁰(n) as Unit⁰)
//│ };
//│ define annotHelper¹ as fun annotHelper⁰(n: ?): ? {
//│   let scrut: ?, tmp: ?, tmp1: Int⁰;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return runtime⁰.Unit⁰
//│     else
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = (tmp as Int⁰);
//│       return annotLoop¹(tmp1)
//│   end
//│ };
//│ return annotHelper⁰(100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Checks whether the let-bound tail call `r` still produces a tail call even though it is wrapped in a `Cast` node.
// A dropped return coercion is re-placed on the stub of the function that dropped it.
// Also runs the compiled JS to ensure that the tail call is preserved and does not overflow the stack.
:soir
:js
@tailrec
fun sccLoop(n: Int): Int =
  let r = sccHelper(n)
  r
fun sccHelper(n: Int): Object = if n <= 0 then 0 else sccLoop(n - 1)
sccHelper(100000)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   let r: ?;
//│   set r = sccHelper⁰(n);
//│   return (r as Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Object⁰ {
//│   let scrut: ?, tmp: ?, tmp1: Int⁰;
//│   set scrut = <=⁰(n, 0);
//│   match scrut
//│     true =>
//│       return 0
//│     else
//│       set tmp = -⁰(n, 1);
//│       set tmp1 = (tmp as Int⁰);
//│       return sccLoop¹(tmp1)
//│   end
//│ };
//│ return sccHelper⁰(100000)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let sccLoop_sccHelper;
//│ define sccLoop_sccHelper as fun sccLoop_sccHelper⁰(id: Int⁰, param0: ?): Object⁰ {
//│   loop loopLabel:
//│     match id
//│       0 =>
//│         set id = 1;
//│         continue loopLabel
//│       1 =>
//│         let scrut: ?, tmp: ?, tmp1: Int⁰;
//│         set scrut = <=⁰(param0, 0);
//│         match scrut
//│           true =>
//│             return 0
//│           else
//│             set tmp = -⁰(param0, 1);
//│             set tmp1 = (tmp as Int⁰);
//│             set param0 = tmp1;
//│             set id = 0;
//│             continue loopLabel
//│         end
//│       else
//│         unreachable /* dispatch tag is always a merged member id */
//│     end
//│   unreachable /* Rest of abortive labelled block */
//│ };
//│ @tailrec
//│ define sccLoop⁰ as fun sccLoop¹(n: Int⁰): Int⁰ {
//│   return (sccLoop_sccHelper⁰(0, n) as Int⁰)
//│ };
//│ define sccHelper¹ as fun sccHelper⁰(n: Int⁰): Object⁰ {
//│   return sccLoop_sccHelper⁰(1, n)
//│ };
//│ return sccLoop_sccHelper⁰(1, 100000)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


// Ensure that `Anything` is resolved to `(ErasedType.)Anything` and not `ErasedType.AnyRef(_, Anything)`
// (which is indicated by `Anything⁰`).
fun f(x: Anything): Anything = x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define f⁶ as fun f⁷(x: Anything): Anything { return x }; end


// Under `:checkCasts`, every coercion inserted by lowering is marked as checked, and prints as
// `as checked T`. The flag is read once, where the coercion is introduced; it changes nothing else about
// lowering, so the IR is otherwise identical to the unmarked casts above.
// The mark is consumed later, by `CheckedCastExpansion`; what it expands into is covered by
// `CheckedCasts.mls`.
:checkCasts
fun mkObj2(): Object = new Object()
val o2: Object = mkObj2()
val n2: Int = o2
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Object⁰, tmp1: Int⁰;
//│ define mkObj2⁰ as fun mkObj2¹(): Object⁰ {
//│   return (new globalThis⁰.Object⁰() as checked Object⁰)
//│ };
//│ set tmp = mkObj2¹();
//│ define o2⁰ as val o2¹: Object⁰ = tmp;
//│ set tmp1 = (o2¹ as checked Int⁰);
//│ define n2⁰ as val n2¹: Int⁰ = tmp1;
//│ end
