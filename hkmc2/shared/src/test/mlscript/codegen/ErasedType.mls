
:global
:sir
:siret


// Note: Needed for `@tailrec`
open annotations
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ end


// Erased types come only from explicit type annotations. An unannotated local - even one bound to a
// literal - carries no erased type.
fun main =
  let i = 1
  let f = 1.5
  let s = "str"
  let b = true
  let t = [i, s]
  let r = {x: i, y: s}
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main⁰ as fun main¹(): ? {
//│   let i: ?, f: ?, s: ?, b: ?, t: ?, r: ?, x: ?, y: ?;
//│   set i = 1;
//│   set f = 1.5;
//│   set s = "str";
//│   set b = true;
//│   set t = [i, s];
//│   set x = i;
//│   set y = s;
//│   set r = { "x": x, "y": y };
//│   return runtime⁰.Unit⁰
//│ };
//│ end


val i: Int = 1
val f: Num = 1.5
val s: Str = "str"
val b: Bool = true
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define i⁰ as val i¹: Int⁰ = 1;
//│ define f⁰ as val f¹: Num⁰ = 1.5;
//│ define s⁰ as val s¹: Str⁰ = "str";
//│ define b⁰ as val b¹: Bool⁰ = true;
//│ end


fun mkObj(): Object = new Object()
val o: Object = mkObj()
val n: Int = o
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp: Object, tmp1: Int⁰;
//│ define mkObj⁰ as fun mkObj¹(): Object {
//│   return new globalThis⁰.Object⁰()
//│ };
//│ set tmp = mkObj¹();
//│ define o⁰ as val o¹: Object = tmp;
//│ set tmp1 = (o¹ as!! Int⁰);
//│ define n⁰ as val n¹: Int⁰ = tmp1;
//│ end


// A `val` is a block member, so a reference to it is a `MemberRef` carrying its type on its `TermSymbol`.
// Reading one into a same-typed slot therefore takes no coercion. The block above cannot pin this: it
// narrows either way, so its output is identical whether or not the reference carries a type.
fun takeInt(m: Int): Int = m
val vi: Int = 1
takeInt(vi)
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define takeInt⁰ as fun takeInt¹(m: Int⁰): Int⁰ {
//│   return m
//│ };
//│ define vi⁰ as val vi¹: Int⁰ = 1;
//│ return takeInt¹(vi¹)


fun retUnit(): () = ()
fun takesUnit(u: ()): () = u
fun passUnit(): () = takesUnit(())
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define retUnit⁰ as fun retUnit¹(): Unit⁰ {
//│   return runtime⁰.Unit⁰
//│ };
//│ define takesUnit⁰ as fun takesUnit¹(u: Unit⁰): Unit⁰ {
//│   return u
//│ };
//│ define passUnit⁰ as fun passUnit¹(): Unit⁰ { return takesUnit¹(runtime⁰.Unit⁰) };
//│ end


class Foo(x: Int)
class Bar(val y: Str)
fun main =
  let foo = new Foo(123)
  let bar = new Bar("hi")
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ define main² as fun main³(): ? {
//│   let foo: ?, bar: ?;
//│   set foo = new Foo⁰(123);
//│   set bar = new Bar⁰("hi");
//│   return runtime⁰.Unit⁰
//│ };
//│ define Foo¹ as class Foo⁰ {
//│   private val x⁰: Int⁰;
//│   constructor Foo²(x: Int⁰) {
//│     set Foo⁰.this.x⁰ = x;
//│     end
//│   }
//│ };
//│ define Bar¹ as class Bar⁰ {
//│   val y⁰: Str⁰;
//│   constructor Bar²(y: Str⁰) { define y⁰ as val y¹: Str⁰ = y; end }
//│ };
//│ end


fun mk(a) = new Bar(a)
fun main =
  let made = mk(1)
  made.y
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
