//│     x4 = param04;
//│     return x4
//│   } else { throw globalThis.Object.freeze(new globalThis.Error("match error")) }
//│ });
//│ lambda
//│ = fun


data class C(a)

fun f(x) = if x is C(a) then a else 0

f(C(27))
//│ = 27


fun f(x) = if x is C then 1 else 0

f(C(27))
//│ = 1


