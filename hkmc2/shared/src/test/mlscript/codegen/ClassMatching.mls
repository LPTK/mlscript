:js


data class Some[out A](value: A)

object None


:sjs
if Some(0) is Some(x) then x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let scrut;
//│ scrut = Some1(0);
//│ if (scrut instanceof Some1.class) {
//│   return scrut.value
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0


let s = Some(0)
//│ s = Some(0)

:sjs
if s is
  Some(x) then x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (s instanceof Some1.class) {
//│   return s.value
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

if s is
  Some(x) then x
  None then 1
//│ = 0

:sir
:soir
:re
if s is
  Some(1) then 0
  None then 1
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let tmp;
//│ match s⁰
//│   Some⁰ =>
//│     let arg$Some$0$;
//│     set arg$Some$0$ = s⁰.value⁰;
//│     match arg$Some$0$
//│       1 =>
//│         set tmp = 0;
//│         return tmp
//│       else
//│         throw new globalThis⁰.Error⁰("match error")
//│     end
//│   None⁰ =>
//│     set tmp = 1;
//│     return tmp
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ match s⁰
//│   Some⁰ =>
//│     let arg$Some$0$;
//│     set arg$Some$0$ = s⁰.value⁰;
//│     match arg$Some$0$
//│       1 =>
//│         return 0
//│       else
//│         throw new globalThis⁰.Error⁰("match error")
//│     end
//│   None⁰ =>
//│     return 1
//│   else
//│     throw new globalThis⁰.Error⁰("match error")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ ═══[RUNTIME ERROR] Error: match error

:expect 0
if s is
  Some then s.value
//│ = 0


:sjs
x => if x is Some(x) then x
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let lambda;
//│ lambda = (undefined, function (x) {
//│   if (x instanceof Some1.class) {
//│     return x.value
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ });
//│ return lambda
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = fun


data class C(a)

fun f(x) = if x is C(a) then a else 0

f(C(27))
//│ = 27


fun f(x) = if x is C then 1 else 0

f(C(27))
//│ = 1


