// Do not specialize all into one switch
:sjs
fun f(x) =
  let acc = ""
  if x is 0 do
    set acc += "M"
    set x = 1
  if x is
    1 do return acc + "1"
    2 do return acc + "2"
    else do return acc + "3"
  "fail"
