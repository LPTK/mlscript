// See `SpecializedSwitch` for details on what is specialized here
// Note: It would also specialize if `return` were replaced with `break` or `continue`, but it isn't
// yet possible to explicitly write in the source language
:sjs
fun f(x) =
  let acc = ""
  if x is 0 do
    set acc += "a"
    set x = 1
  if x is 1 do
    set acc += "b"
    set x = 2
  if x is 2 do
    set acc += "c"
    return acc
  if x is 3 do
    set acc += "A"
    set x = 4
  if x is 4 do
    set acc += "B"
    set x = 5
  if x is 5 do
    set acc += "C"
    return acc
  if x is
    6 then "EndA"
    7 then "EndB"
    8 then "EndC"
    else "EndD"
