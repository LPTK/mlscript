fun printAndId(x) =
  print(x)
  x

// `let tmp = printAndId(3)` is not moved out
// because the rhs is not trivial
:sjs
if a is
  A then 1
  let tmp = printAndId(3)
  B then 2 + tmp
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ }
//│ Predef.print(3);
//│ if (a instanceof B1.class) {
//│   return 5
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ /* Rest moved to non-abortive branch(es) */
//│ /* Rest moved to non-abortive branch(es) */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms here are still merged because
// `print(x)` is duplicated and moved into match arm bodies
:sjs
if a is
  A then 1
  else
    let x = if a is
      B then 2
      C then 3
    print(x)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof A1.class) {
//│   return 1
//│ } else if (a instanceof B1.class) {
//│   return Predef.print(2)
//│ } else if (a instanceof C1.class) {
//│   return Predef.print(3)
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ /* Rest moved to non-abortive branch(es) */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// The match arms are not merged because
// `print(x); print(x + 1); print(x + 2)` is
// not moved into match arm bodies for being too big
:sjs
if a is
  B then 1
  else
    let x = if a is
      A then 2
      C then 3
    print(x)
    print(x + 1)
    print(x + 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ if (a instanceof B1.class) {
//│   return 1
//│ }
//│ {
//│   let tmp1;
//│   if (a instanceof A1.class) {
//│     tmp1 = 2;
//│   } else if (a instanceof C1.class) {
//│     tmp1 = 3;
//│   } else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   {
//│     let tmp2, tmp3;
//│     Predef.print(tmp1);
//│     tmp2 = tmp1 + 1;
//│     Predef.print(tmp2);
//│     tmp3 = tmp1 + 2;
//│     return Predef.print(tmp3);
//│   }
//│ }
//│ /* Rest moved to non-abortive branch(es) */
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 3
//│ > 4


:soir
fun f(x) =
  let acc = ""
  if x is 5 then
    return acc
  else
    if x is
      8 then print("8")
      else print("?")
    print("hi")
    acc
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     5 =>
//│       return ""
//│     else
//│       match x
//│         8 =>
//│           do Predef⁰.print⁰("8");
//│           end
//│         else
//│           do Predef⁰.print⁰("?");
//│           end
//│       do Predef⁰.print⁰("hi");
//│       return ""
//│   end /* (Unreachable:) rest of abortive match */
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(5)
//│ = ""

f(6)
//│ > ?
//│ > hi
//│ = ""

f(8)
//│ > 8
//│ > hi
//│ = ""


