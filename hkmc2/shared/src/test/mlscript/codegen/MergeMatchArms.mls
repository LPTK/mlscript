#config(commentGeneratedCode: true)


object A
object B
object C
object D
object E


let a = A
let b = B
//│ a = A
//│ b = B

:sjs
if a is
  A then 1
  B then 2
  C then 3
  D then 4
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp, tmp1, tmp2, tmp3;
//│ tmp = a;
//│ if (tmp instanceof A1.class) {
//│   return 1
//│ }
//│ tmp1 = a;
//│ if (tmp1 instanceof B1.class) {
//│   return 2
//│ }
//│ tmp2 = a;
//│ if (tmp2 instanceof C1.class) {
//│   return 3
//│ }
//│ tmp3 = a;
//│ if (tmp3 instanceof D1.class) {
//│   return 4
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// manually written `else if`s branches on the same scrut is also merged 
:sjs
if a is
  A then 1
  else
    if a is
      B then 2
      C then 3
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp4, tmp5, tmp6;
