//│   } else {
//│     tmp15 = a;
//│     if (tmp15 instanceof C1.class) {
//│       tmp13 = 3;
//│     } else {
//│       tmp16 = a;
//│       if (tmp16 instanceof D1.class) {
//│         tmp17 = a;
