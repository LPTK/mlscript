// The match arms are not merged because
// `print(x); print(x + 1); print(x + 2)` is
// not moved into match arm bodies for being too big
:sjs
if a is
  B then 1
  else
    let x = if a is
      A then 2
      C then 3
    print(x)
    print(x + 1)
    print(x + 2)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let tmp27, tmp28, tmp29, tmp30, tmp31, tmp32;
//│ tmp27 = a;
//│ if (tmp27 instanceof B1.class) {
//│   return 1
//│ }
//│ tmp28 = a;
//│ if (tmp28 instanceof A1.class) {
//│   tmp29 = 2;
//│ } else {
//│   tmp30 = a;
//│   if (tmp30 instanceof C1.class) {
//│     tmp29 = 3;
//│   } else {
//│     throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│   }
//│   /* Rest moved to non-abortive branch(es) */
//│ }
//│ Predef.print(tmp29);
//│ tmp31 = tmp29 + 1;
//│ Predef.print(tmp31);
//│ tmp32 = tmp29 + 2;
//│ return Predef.print(tmp32);
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 2
//│ > 3
//│ > 4


:soir
fun f(x) =
  let acc = ""
  if x is 5 then
    return acc
  else
    if x is
      8 then print("8")
      else print("?")
    print("hi")
    acc
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define f⁰ as fun f¹(x) {
//│   match x
//│     5 =>
//│       return ""
//│     8 =>
//│       do Predef⁰.print⁰("8");
//│       do Predef⁰.print⁰("hi");
//│       return ""
//│     else
//│       do Predef⁰.print⁰("?");
//│       do Predef⁰.print⁰("hi");
//│       return ""
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f(5)
//│ = ""

f(6)
//│ > ?
//│ > hi
//│ = ""

f(8)
//│ > 8
//│ > hi
//│ = ""


