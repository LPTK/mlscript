//│ if (tmp5 instanceof B1.class) {
//│   return 2
//│ }
//│ tmp6 = a;
//│ if (tmp6 instanceof C1.class) {
//│   return 3
//│ }
//│ throw globalThis.Object.freeze(new globalThis.Error("match error"));
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


:sjs
if a is
  A and b is
    A then 1
    B then 2
  B then 2
  C then 3
