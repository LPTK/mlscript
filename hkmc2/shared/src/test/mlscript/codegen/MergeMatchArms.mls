//│           /* Rest moved to non-abortive branch(es) */
//│         } else {
//│           tmp18 = a;
//│           if (tmp18 instanceof B1.class) {
//│             /* Rest moved to non-abortive branch(es) */
//│           } else {
//│             throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│           }
//│           /* Rest moved to non-abortive branch(es) */
//│         }
//│         /* Rest moved to non-abortive branch(es) */
//│       } else {
//│         tmp19 = a;
//│         if (tmp19 instanceof E1.class) {
//│           /* Rest moved to non-abortive branch(es) */
//│         } else {
//│           throw globalThis.Object.freeze(new globalThis.Error("match error"))
//│         }
//│         /* Rest moved to non-abortive branch(es) */
//│       }
//│       tmp13 = Predef.print("done");
//│     }
//│     /* Rest moved to non-abortive branch(es) */
//│   }
//│   /* Rest moved to non-abortive branch(es) */
