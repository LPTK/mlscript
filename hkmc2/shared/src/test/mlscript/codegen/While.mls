// * Mix of local mutable variable, while loop and lambdas
:expect 2
fun f() =
  let
    cnt = 2
    savedLambda = null
  while cnt > 0 do
    let local = cnt
    if cnt == 2 do
      // This lambda should always return 2,
      // since local is 2 and not reassigned in the while loop
      savedLambda = () => local
    set cnt -= 1
  // Calls the saved lambda
  savedLambda()
