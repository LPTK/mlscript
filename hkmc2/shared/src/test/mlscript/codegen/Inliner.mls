:js

:soir
fun f() = 0
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰; define f⁰ as fun f¹() { return 0 }; 0
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

:soir
fun f(x) = x
f(100)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f²; define f² as fun f³(x) { return x }; 100
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 100


:soir
fun f() =
  let done(x) = x
  done
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁴;
//│ define f⁴ as fun f⁵() { let done; define done as fun done⁰(x) { return x }; return done };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

// * TODO: support spread arguments like this one
:soir
:inlineThreshold 10
fun f(a, b, c) = a + b + c
print(f(1, 2, 3))
print(f(1, 2, ...[1]))
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁶, tmp, tmp1, inlinedVal, tmp2;
//│ define f⁶ as fun f⁷(a, b, c) {
//│   let tmp3;
//│   set tmp3 = +⁰(a, b);
//│   return +⁰(tmp3, c)
//│ };
//│ set tmp2 = +⁰(1, 2);
//│ set inlinedVal = +⁰(tmp2, 3);
//│ do Predef⁰.print⁰(inlinedVal);
//│ set tmp = [1];
//│ set tmp1 = f⁷(1, 2, ...tmp);
//│ Predef⁰.print⁰(tmp1)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6
//│ > 4


:soir
:inlineThreshold 10
fun f(a, ...b) =
  print(a)
  print(b)
f(1, ...[2])
f(1, ...[2], ...[3])
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁸, tmp, tmp1, tmp2;
//│ define f⁸ as fun f⁹(a, ...b) {
//│   do Predef⁰.print⁰(a);
//│   return Predef⁰.print⁰(b)
//│ };
//│ set tmp = [2];
//│ do f⁹(1, ...tmp);
//│ set tmp1 = [2];
//│ set tmp2 = [3];
//│ f⁹(1, ...tmp1, ...tmp2)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ > [2]
//│ > 1
//│ > [2, 3]


// All inlined
:soir
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, 2)
f(1, 2, 3)
f(1, 2, 3, 4)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁰, c⁰, c¹, c², inlinedVal, tmp, tmp1, tmp2;
//│ define f¹⁰ as fun f¹¹(a, b, ...c) {
//│   let tmp3;
//│   set tmp3 = +⁰(a, b);
//│   do Predef⁰.print⁰(tmp3);
//│   return Predef⁰.print⁰(c)
//│ };
//│ set c⁰ = mut [];
//│ set tmp2 = +⁰(1, 2);
//│ do Predef⁰.print⁰(tmp2);
//│ do Predef⁰.print⁰(c⁰);
//│ set c¹ = mut [3];
//│ set tmp1 = +⁰(1, 2);
//│ do Predef⁰.print⁰(tmp1);
//│ do Predef⁰.print⁰(c¹);
//│ set c² = mut [3, 4];
//│ set tmp = +⁰(1, 2);
//│ do Predef⁰.print⁰(tmp);
//│ set inlinedVal = Predef⁰.print⁰(c²);
//│ inlinedVal
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > []
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]

// only inline perfect match when spread is used
:sjs
:inlineThreshold 10
fun f(a, b, ...c) =
  print(a + b)
  print(c)
f(1, ...[2, 3])
f(1, 2, ...[3])
f(1, 2, 3, ...[4])
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f6, tmp9, tmp10, tmp11;
//│ f6 = function f(a, b, ...c3) {
//│   let tmp12;
//│   tmp12 = a + b;
//│   Predef.print(tmp12);
//│   return Predef.print(c3)
//│ };
//│ tmp9 = globalThis.Object.freeze([
//│   2,
//│   3
//│ ]);
//│ f6(1, ...tmp9);
//│ tmp10 = globalThis.Object.freeze([
//│   3
//│ ]);
//│ f6(1, 2, ...tmp10);
//│ tmp11 = globalThis.Object.freeze([ 4 ]);
//│ f6(1, 2, 3, ...tmp11)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > [3]
//│ > 3
//│ > [3]
//│ > 3
//│ > [3, 4]


// Multiple return points
:sjs
:expect true
fun f() =
  fun g(x) =
    if x is true do return true
    return false
  g(true)
f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let f7; f7 = function f() { let x; x = true; if (x === true) { return true } return false; }; f7()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = true


// Methods (not implemented currently)
// NOTE: only final (ie, non-virtual) method may be inlined, as they could be overriden

:sjs
:soir
:inlineThreshold 10
module A with
  fun f() = 1
  fun g() = A.f()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let A1;
//│ (class A {
//│   static {
//│     A1 = this
//│   }
//│   static f() {
//│     return 1
//│   } 
//│   static g() {
//│     return A1.f()
//│   }
//│   toString() { return runtime.render(this); }
//│   static [definitionMetadata] = ["class", "A"]; 
//│ });
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A⁰;
//│ define A⁰ as class A¹
//│ module A² { method f¹² = fun f¹³() { return 1 } method g⁰ = fun g¹() { return A².f¹³() } };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Inlining limits
:soir
:inlineThreshold 10
fun f() = if false do f() + 1
f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f¹⁴;
//│ define f¹⁴ as fun f¹⁵() {
//│   let scrut;
//│   set scrut = false;
//│   match scrut
//│     true =>
//│       do f¹⁵();
//│       return runtime⁰.Unit⁰
//│     else
//│       return runtime⁰.Unit⁰
//│   end
//│ };
//│ f¹⁵()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// Pathological case of inlining
:soir
fun g() =
  fun f() = f()
  f()
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let g²; define g² as fun g³() { let f; define f as fun f¹⁶() { return f¹⁶() }; return f¹⁶() }; end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


