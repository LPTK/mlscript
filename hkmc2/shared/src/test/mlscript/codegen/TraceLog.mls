abstract class E: S | N
data class S(x) with
  fun toString() = "S(" + x + "): " + toInt(succ(x))
class N() with
  fun toString() = "N: 0" 
fun succ(x) = S(x)
fun toInt(x) = if x is
  N then 0
  S(n) then 1 + toInt(n)
