// Under `:checkCasts`, each coercion inserted by lowering is expanded into a type test that throws when it
// fails. The test a target needs depends on how the class is reached at runtime, so each shape is covered
// below.
:js

:global
:checkCasts

open annotations
class Top(x: Int)
// These tests are about narrowing the result of an opaque call, so `mkTop` must stay one: typing an
// instantiation as its class put this body under the inliner's threshold, and an inlined `new Top(1)`
// would make every type test below statically decidable.
@noInline
fun mkTop(): Object = new Top(1)
// An unannotated result is `Anything`, the only source that can be narrowed *to* `Object`.
fun anything(v) = v
module M with
  class Inner(y: Int)


// A user-defined top-level class is reached through its own binding.
:sjs
fun toTop(): Top = mkTop()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let toTop;
//│ toTop = function toTop() {
//│   let castScrut;
//│   castScrut = mkTop();
//│   if (castScrut instanceof Top1.class) {
//│     return castScrut
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Top'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A class nested in a module is reached through its owner.
:sjs
fun toInner(): M.Inner = mkTop()
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let toInner;
//│ toInner = function toInner() {
//│   let castScrut;
//│   castScrut = mkTop();
//│   if (castScrut instanceof M.Inner.class) {
//│     return castScrut
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'M.Inner'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A declared class exists at runtime but is not defined by us, so it is reached through `globalThis`.
:sjs
fun toNumber(): Number = anything(1)
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let toNumber;
//│ toNumber = function toNumber() {
//│   if (1 instanceof globalThis.Number) {
//│     return 1
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Number'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// `Object` is a declared class like `Number` above, and is reached the same way.
:sjs
fun toObject(): Object = anything(1)
fun topToObject(): Object = anything(mkTop())
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let topToObject, toObject;
//│ toObject = function toObject() {
//│   if (1 instanceof globalThis.Object) {
//│     return 1
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Object'"));
//│ };
//│ topToObject = function topToObject() {
//│   let tmp;
//│   tmp = mkTop();
//│   if (tmp instanceof globalThis.Object) {
//│     return tmp
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Object'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A virtual class has no runtime representation at all; the path in its `Case.Cls` is discarded and the
// backend emits its own test.
:sjs
fun toInt(): Int = anything(mkTop())
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let toInt;
//│ toInt = function toInt() {
//│   let tmp;
//│   tmp = mkTop();
//│   if (globalThis.Number.isInteger(tmp)) {
//│     return tmp
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Int'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————


// A cast that holds is transparent.
toTop() is Top
//│ = true


// A user-defined class and an `Int` have distinct runtime representations, so this one throws.
:re
toInt()
//│ ═══[RUNTIME ERROR] Error: Cannot narrow a value to type 'Int'


// A primitive is not an instance of the host's `Number`, so this one throws too.
:re
toNumber()
//│ ═══[RUNTIME ERROR] Error: Cannot narrow a value to type 'Number'


// Both directions are pinned by *calling* them: the emitted JS alone is not enough, since a wrong test stays
// invisible until the function runs — which is how `1 instanceof globalThis.Object` once survived here,
// back when `Object` still admitted primitives.
topToObject() is Top
//│ = true


// An `Int` and an `Object` are separate in the hierarchy, so this narrowing now throws instead of passing the value
// through.
:re
toObject()
//│ ═══[RUNTIME ERROR] Error: Cannot narrow a value to type 'Object'


// The `Object` *pattern* and the `Object` type now agree: `1` neither inhabits the type nor matches the
// pattern.
1 is Object
//│ = false


// An unannotated value cannot reach an `Int32` slot, so the coercion is rejected instead of compiling to an
// untested pass-through. `useInt` is the contrast: `Int` is a reference type, so the same call narrows and
// gets a real test.
:ge
:sjs
fun useI32(n: Int32): Int32 = n
fun callI32(): Int32 = useI32(anything(1))
fun useInt(n: Int): Int = n
fun callInt(): Int = useInt(anything(1))
//│ ╔══[COMPILATION ERROR] Cannot narrow a value of type 'Unknown' to unrelated type 'Int32'
//│ ║  l.151: 	fun callI32(): Int32 = useI32(anything(1))
//│ ╙──       	                              ^^^^^^^^^^^
//│ ————————————| JS (unsanitized) |————————————————————————————————————————————————————————————————————
//│ let useInt, callInt, callI32, useI32;
//│ useI32 = function useI32(n) {
//│   return n
//│ };
//│ callI32 = function callI32() {
//│   return 1
//│ };
//│ useInt = function useInt(n) {
//│   return n
//│ };
//│ callInt = function callInt() {
//│   if (globalThis.Number.isInteger(1)) {
//│     return 1
//│   }
//│   throw globalThis.Object.freeze(new globalThis.Error("Cannot narrow a value to type 'Int'"));
//│ };
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
