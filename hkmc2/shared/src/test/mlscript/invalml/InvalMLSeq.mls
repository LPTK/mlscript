// * Simpler; should be equivalent when Region is covariant
fun mapi: [A, E] -> (Seq[out A, out E], Region[out E]) -> ((Int, A) ->{E} A) ->{E} Seq[out A, out E]
fun mapi = (s, r) => f =>
  let i = r.ref 0
  map(s) of x =>
    i := !(i) + 1
    f(!(i), x)
