fun init: [A, R] -> (Region[out R], Int, Int, A) ->{R} Array2D[A, R]
fun init(r, d1, d2, iv) =
  let res = new Array2D(mkArrayWith(mkArrayWith(iv, d2), d1))
  region r in
    let i = r.ref 0
    whileDo of () =>
      if !(i) == d1 then false
      else
        splice(res.Array2D#d, !(i), mkArrayWith(iv, d2))
        i := !(i) + 1
        true
  res
    
