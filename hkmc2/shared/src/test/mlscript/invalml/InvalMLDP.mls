:sjs
fun next: [T, S] -> Iter[T, S] ->{S} Option[T]
fun next(it) =
  let i = !(it.Iter#i)
  if i == it.Iter#end then None()
  else
    let res = Some(at of it.Iter#arr, i)
    it.Iter#i := i + it.Iter#step
    res
