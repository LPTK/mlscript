// * Example usage

fun mkList: [A] -> A -> List[out A]
fun head: [A] -> List[out A] -> A

region r in
  let sum = r.ref 0
  let s1 = mkList of !(sum)
  let s2 = mapi(s1) of (x, i) => x * i
  !(sum) + head(s2)
