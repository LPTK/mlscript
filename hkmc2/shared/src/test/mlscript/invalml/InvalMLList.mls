fun mapi: [A, E] -> List[out A] -> ((Int, A) ->{E} A) ->{E} List[out A]
fun mapi = s => f =>
  region r in
    let i = r.ref 0
    map(s) of x =>
      i := !(i) + 1
      f(!(i), x)
