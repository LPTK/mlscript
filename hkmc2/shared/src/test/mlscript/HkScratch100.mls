:js


// Cls -> Mod,
// Als -> Mod,
// Fun -> Mod,

class ClsMod with
  val whoami = "class"
module ClsMod with
  val whoami = "module"

type TypMod = Int
module TypMod with
  val whoami = "module"

:fixme
fun TrmMod = 42
module TrmMod with
  val whoami = "module"
//│ ╔══[ERROR] Not yet supported: overloading of function 'TrmMod'
//│ ║  l.18: 	fun TrmMod = 42
//│ ║        	^^^^^^^^^^^^^^^
//│ ╟── with module of the same name
//│ ║  l.19: 	module TrmMod with
//│ ║        	^^^^^^^^^^^^^^^^^^
//│ ║  l.20: 	  val whoami = "module"
//│ ╙──      	^^^^^^^^^^^^^^^^^^^^^^^

fun f: ClsMod = 42

fun f: module ClsMod = ClsMod

fun f: TypMod = 42

fun f: module TypMod = TypMod

// Should be error: Unexpected moduleful reference 'TrmMod'
:breakme
:sjs
fun f: TrmMod = 42
//│ JS (unsanitized):
//│ let f4; f4 = function f() { return 42 };

// Should compile to term (function) `TrmMod` rather than module `TrmMod`
:todo
:sjs
fun f = TrmMod
//│ JS (unsanitized):
//│ let f5; f5 = function f() { return TrmMod1 };

:sjs
fun f: module TrmMod = TrmMod
//│ JS (unsanitized):
//│ let f6; f6 = function f() { return TrmMod1 };

fun assertModule(module m: ClsMod): module ClsMod = m

assertModule(ClsMod).whoami
//│ = "module"

assertModule(TypMod).whoami
//│ = "module"

assertModule(TrmMod).whoami
//│ = "module"


fun assertNonModule(m) = m

// FIXME: should not resolve to module's `.whoami`, 
// hence should be an error
:breakme
assertNonModule(ClsMod).whoami
//│ = "module"

// FIXME: should not resolve to module's `.whoami`,
// hence should be an error
:breakme
assertNonModule(TypMod).whoami
//│ = "module"

// FIXME: should not resolve to module's `.whoami`,
