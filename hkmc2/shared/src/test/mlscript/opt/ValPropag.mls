:js


// * Currently can't propagate from `val` since it's not defined with an Assign
:soir
val x = 1
let y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰, y⁰; define x¹ as val x⁰ = 1; set y⁰ = x⁰; return x⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1

// * But can propagate to `val` from `let`
:soir
let x = 1
val y = x
y
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x², y¹; set x² = 1; define y² as val y¹ = 1; return y¹
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1
//│ x = 1
//│ y = 1


// :dopt
:soir
val x = 1
let y = x in print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x³; define x⁴ as val x³ = 1; return Predef⁰.print⁰(x³)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1

