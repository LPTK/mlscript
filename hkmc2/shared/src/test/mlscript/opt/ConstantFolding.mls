:js


:soir
let x = 2
in let y = 2
in let x += 1
in
  set y += 1
  print(x + y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ Predef⁰.print⁰(6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6


