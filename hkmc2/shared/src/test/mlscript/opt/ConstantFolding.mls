:soir
let x = 2
in let y = 2
in let x += 1
in
  set y += 1
  print(x + y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ Predef⁰.print⁰(6)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 6


// :dopt
:soir
let peek = hide(2 + 2)
let last = peek
set peek = 1
last
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let peek⁰, last⁰; set peek⁰ = Predef⁰.hide⁰(4); set last⁰ = peek⁰; set peek⁰ = 1; last⁰
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4
//│ last = 4
//│ peek = 1


