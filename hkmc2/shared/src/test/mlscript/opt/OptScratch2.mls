:js



:deadParamElim
:soir
// :dopt
private fun f(a) =
  let g = () => a
  g()
f(42)
//│ dead-param-elim > >>> dead-param-elim results >>>
//│ dead-param-elim > <<< dead-param-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰, g⁰; define f⁰ as fun f¹(a) { let g; return a }; 42
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42



let emptyItemCount = 0
let c() = (set emptyItemCount += 1)
in
  c()
  if
    emptyItemCount > 0 then
      let emptyItemCount' = emptyItemCount
      set emptyItemCount = 0
      print(emptyItemCount')
//│ > 1
//│ emptyItemCount = 0

