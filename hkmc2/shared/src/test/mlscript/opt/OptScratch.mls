:js



// :dopt
:soir
let x = 1
  in
    let y = x
    in y + 1
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ 2
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2

// :dopt
:soir
let x
print(x)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x⁰; Predef⁰.print⁰(undefined)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > undefined
//│ x = undefined


// :dopt
:soir
val x = 1
let y = x in print(y)
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let x¹; define x¹ as val x² = 1; Predef⁰.print⁰(x²)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 1
//│ x = 1



