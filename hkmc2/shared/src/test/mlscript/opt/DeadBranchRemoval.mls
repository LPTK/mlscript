:js


data class C(a)

:soir
if C(123) is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let scrut, arg$C$0$;
//│ set scrut = C⁰(123);
//│ match scrut
//│   C¹ =>
//│     set arg$C$0$ = scrut.a⁰;
//│     Predef⁰.print⁰(arg$C$0$)
//│   else
//│     Predef⁰.print⁰("?")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123

:soir
let c = C(123)
in if c is
  C(x) then print(x)
  else print("?")
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let c⁰, arg$C$0$;
//│ set c⁰ = C⁰(123);
//│ match c⁰
//│   C¹ =>
//│     set arg$C$0$ = c⁰.a⁰;
//│     Predef⁰.print⁰(arg$C$0$)
//│   else
//│     Predef⁰.print⁰("?")
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 123


