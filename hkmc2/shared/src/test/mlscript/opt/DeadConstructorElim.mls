// * Constructor flow: what a constructor does with its parameters decides whether an argument
// * may be eliminated. The `Ctor` strategy models the parameter fields, so a constructor that
// * only stores them stays transparent; any other use of a parameter field lets the argument escape.

data class A(x)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<

// reads its parameter field, like `P`, but through a `val` field rather than a private one
data class N(v) with
  print(v)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<

// stores its parameter and never reads it back in the ctor
class E(e) with
  fun get() = e
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<

// passes its parameter field to something opaque
class W(f) with
  f(A(1))
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<


:soir
:noInline
fun dcN() =
  let unused = N(A(1))
  2
dcN()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
