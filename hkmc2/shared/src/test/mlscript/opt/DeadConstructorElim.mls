// A constructor can observe its arguments even when its own result is discarded.
// Flow analysis must account for those uses before removing the nested allocation.
:flowBasedOpt mono debugDce
:soir
:noInline
:expect 42
data class Observed(x)
class Consumer(x) with
  if x is Observed then () else throw "expected Observed"
fun consume() =
  let unused = Consumer(Observed(1))
  42
consume()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define consume⁰ as fun consume¹() {
//│   let tmp;
//│   set tmp = Observed⁰(1);
//│   do Consumer⁰(tmp);
//│   return 42
//│ };
//│ @data
//│ define Observed¹ as class Observed² {
//│   val x¹;
//│   constructor Observed⁰(x) {
//│     define x¹ as val x² = x;
//│     end
//│   }
//│ };
//│ define Consumer¹ as class Consumer² {
//│   private val x³;
//│   constructor Consumer⁰(x) {
//│     set Consumer².this.x³ = x;
//│     match Consumer².this.x³
//│       Observed² =>
//│         end
//│       else
//│         throw "expected Observed"
//│     end
//│   }
//│ };
//│ return consume¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 42


// Lifting appends a capture argument that is absent from the source class parameter list.
// That argument remains live through the instance's method, even though it is not a source field.
:flowBasedOpt mono debugDce
:lift
:soir
:noInline
:expect [1, 2]
fun capture() =
  let captured = [1, 2]
  class Capturing(x) with
    fun get() = captured
  let instance = Capturing(0)
  instance.get()
capture()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let Capturing;
//│ define Capturing as class Capturing¹ {
//│   private val captured⁰;
//│   constructor Capturing⁰(x, captured) {
//│     set Capturing¹.this.captured⁰ = captured;
//│     end
//│   }
//│   method get¹ = fun get²() {
//│     return Capturing¹.this.captured⁰
//│   }
//│ };
//│ define capture⁰ as fun capture¹() {
//│   let captured, instance;
//│   set captured = [1, 2];
//│   set instance = new Capturing¹(0, captured);
//│   return instance.get﹖()
//│ };
//│ return capture¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1, 2]
// The lifted params stay linked to their fields, so the lifted class is still tracked
// and the argument of the never-read field `b` can be eliminated.
:lift
:flowBasedOpt mono debugDce
:soir
:noInline
:expect [1]
fun liftedField() =
  let captured = 0
  class A(val a, val b) with
    fun get() = captured
  A([1], [2]).a
liftedField()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Tuple(false, [2])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let A;
//│ define A as class A⁴ {
//│   private val captured¹;
//│   val a⁰;
//│   val b⁰;
//│   constructor A³(a, b, captured) {
//│     set A⁴.this.captured¹ = captured;
//│     define a⁰ as val a¹ = a;
//│     define b⁰ as val b¹ = b;
//│     end
//│   }
//│   method get³ = fun get⁴() {
//│     return A⁴.this.captured¹
//│   }
//│ };
//│ define liftedField⁰ as fun liftedField¹() {
//│   let tmp, tmp1;
//│   set tmp = [1];
//│   set tmp1 = new A⁴(tmp, undefined, 0);
//│   return tmp1.a¹
//│ };
//│ return liftedField¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [1]


// A call that does not saturate every parameter list returns a function, not an instance,
// so `A(10)` must not be modeled as a constructed `A`, or the later `[1]` argument looks dead.
:flowBasedOpt mono debugDce
:soir
:noInline
:expect [10, [1]]
class A(x) with
  constructor(y)
  fun both() = [x, y]
fun mk(k) = A(10)
fun go() = mk(0)([1]).both()
go()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
