// a ctor analyzed per construction keeps the flows of its sites apart:
// only the first site's `f` ignores its argument, so only `B()` is dead
:flowBasedOpt mono debugDce
:soir
:noInline
class B()
class C()
class A(f, x) with
  print(f(x))
fun twoSites() =
  A(x => 3, new B())
  A(x => x, new C())
  0
twoSites()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Instantiate(false, member:B³⁰‹class:B³¹›, [[]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define twoSites⁰ as fun twoSites¹() {
//│   let lambda, lambda1, tmp;
//│   define lambda as fun lambda⁶(x) {
//│     return 3
//│   };
//│   do A¹⁰(lambda⁶, undefined);
//│   define lambda1 as fun lambda⁷(x) {
//│     return x
//│   };
//│   set tmp = new C⁸();
//│   do A¹⁰(lambda⁷, tmp);
//│   return 0
//│ };
//│ define B³⁰ as class B³¹ {
//│   constructor B³²
//│ };
//│ define C⁹ as class C⁸ {
//│   constructor C¹⁰
//│ };
//│ define A¹¹ as class A¹² {
//│   private val f⁴;
//│   private val x⁹;
//│   constructor A¹⁰(f, x) {
//│     let tmp;
//│     set A¹².this.f⁴ = f;
//│     set A¹².this.x⁹ = x;
//│     set tmp = A¹².this.f⁴(A¹².this.x⁹);
//│     do Predef⁰.print⁰(tmp);
//│     end
//│   }
//│ };
//│ return twoSites¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > 3
//│ > C()
//│ = 0


// a public function of an earlier block is analyzed through its symbol, but never rewritten,
// so `[1]` passed only to `ignoreArg` is dead, while the private `ignoreArgPriv` stays opaque
:flowBasedOpt mono debugDce
fun ignoreArg(x) = 0
private fun ignoreArgPriv(x) = 0
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<

:flowBasedOpt mono debugDce
:soir
:noInline
fun earlierBlock() =
  let a = ignoreArg([1])
  let b = ignoreArgPriv([2])
  a + b
earlierBlock()
