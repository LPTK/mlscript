//│   let scrut, tmp;
//│   set tmp = [4];
//│   set scrut = B³(tmp);
//│   match scrut
//│     C¹ =>
//│       return scrut.z⁰
//│     else
//│       return 0
//│   end
//│ };
//│ define B⁴ as class B⁵ extends C¹ { constructor B³ };
//│ return inherited¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = [4]

:flowBasedOpt mono
:noInline
:expect [4]
