//│ define earlierBlock⁰ as fun earlierBlock¹() {
//│   let a, b, tmp;
//│   set a = ignoreArg⁰(undefined);
//│   set tmp = [2];
//│   set b = ignoreArgPriv⁰(tmp);
//│   return +⁰(a, b)
//│ };
//│ return earlierBlock¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0
