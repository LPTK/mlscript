// the object never escapes and the private field is never read, so both go
:soir
:noInline
fun dcE() =
  let unused = E(A(1))
  2
dcE()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A⁹‹term:A⁸›, [[1]])
//│ dead-constructor-elim > eliminable: Call(member:E⁰‹term:E¹›, [[tmp:tmp¹]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define dcE⁰ as fun dcE¹() { return 2 }; return dcE¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 2


// selecting a method escapes the object, and with it its argument
:soir
:noInline
fun dcEused() = (E(A(1))).get()
dcEused()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define dcEused⁰ as fun dcEused¹() {
//│   let tmp, tmp1;
//│   set tmp = A⁸(1);
//│   set tmp1 = E¹(tmp);
//│   return tmp1.get⁵()
//│ };
//│ return dcEused¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = A(1)


:soir
:noInline
W(a => print(a))
