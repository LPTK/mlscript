// A class may be constructed where the analysis cannot see, such as in a later block,
// so its ctor is also analyzed for unknown arguments: `g`'s call in the ctor keeps `x`.
:soir
:noInline
private fun g(x, y) = y
class B(z) with
  print(g(z, 2))
g(A(3), 4)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A⁹‹term:A⁸›, [[3]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ @private
//│ define g⁴ as fun g⁵(x, y) {
//│   return y
//│ };
//│ define B⁶ as class B⁸ {
//│   private val z¹;
//│   constructor B⁷(z) {
//│     let tmp;
//│     set B⁸.this.z¹ = z;
//│     set tmp = g⁵(B⁸.this.z¹, 2);
//│     do Predef⁰.print⁰(tmp);
//│     end
//│   }
//│ };
//│ return g⁵(undefined, 4)
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 4

B(A(1))
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ > 2
//│ = B(_)

// same for the private value read only by the ctor
:soir
private val pv = [1]
class C with
  val v = pv
