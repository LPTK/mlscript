// hands the whole object to something opaque, so its parameter fields escape with it
data class L(v) with
  print(this)
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<

:soir
:noInline
fun dcL() =
  let unused = L(A(1))
  2
dcL()
