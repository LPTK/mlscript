//│   let tmp;
//│   set tmp = A⁸(7);
//│   do B¹²(tmp, 3);
//│   return 0
//│ };
//│ define B¹³ as class B¹⁴ {
//│   private val x⁶;
//│   private val n³;
//│   constructor B¹²(x, n) {
//│     let scrut, tmp;
//│     set B¹⁴.this.x⁶ = x;
//│     set B¹⁴.this.n³ = n;
//│     set scrut = >⁰(B¹⁴.this.n³, 0);
//│     match scrut
//│       true =>
//│         set tmp = -⁰(B¹⁴.this.n³, 1);
