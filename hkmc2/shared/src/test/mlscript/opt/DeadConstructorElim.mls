// A ctor that constructs its own class is analyzed together with it,
// so the argument of the never-read `x` can be eliminated.
:soir
:noInline
class B(x, n) with
  if n > 0 do B(x, n - 1)
fun selfCtor() =
  let unused = B(A(9), 2)
  0
selfCtor()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > eliminable: Call(member:A⁹‹term:A⁸›, [[9]])
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define selfCtor⁰ as fun selfCtor¹() {
//│   do B⁹(undefined, 2);
//│   return 0
//│ };
//│ define B¹⁰ as class B¹¹ {
//│   private val x⁵;
//│   private val n²;
//│   constructor B⁹(x, n) {
//│     let scrut, tmp;
//│     set B¹¹.this.x⁵ = x;
//│     set B¹¹.this.n² = n;
//│     set scrut = >⁰(B¹¹.this.n², 0);
//│     match scrut
//│       true =>
//│         set tmp = -⁰(B¹¹.this.n², 1);
//│         do B⁹(B¹¹.this.x⁵, tmp);
//│         end
//│       else
//│         end
//│     end
//│   }
//│ };
//│ return selfCtor¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 0

// mutually-constructing classes are analyzed together, and the argument read by the last one survives
:soir
:noInline
class B(x, n) with
  if n > 0 do C(x, n - 1)
class C(x, n) with
  if n > 0 then B(x, n - 1) else print(x)
fun mutualCtors() =
  let unused = B(A(7), 3)
  0
mutualCtors()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
