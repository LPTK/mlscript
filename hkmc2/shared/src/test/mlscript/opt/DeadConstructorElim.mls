// In poly mode, a ctor instantiates the scheme of a function it calls,
// even when that function is defined after the ctor.
:flowBasedOpt debugDce poly
:soir
:noInline
fun polyCtor() =
  let unused = B(A(3))
  0
fun pr(x) = print(x)
class B(y) with
  pr(y)
polyCtor()
//│ dead-constructor-elim > >>> dead-constructor-elim results >>>
//│ dead-constructor-elim > <<< dead-constructor-elim results <<<
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ define polyCtor⁰ as fun polyCtor¹() {
//│   let tmp;
//│   set tmp = A⁸(3);
//│   do B¹⁵(tmp);
//│   return 0
//│ };
//│ define pr⁰ as fun pr¹(x) {
//│   return Predef⁰.print⁰(x)
//│ };
//│ define B¹⁶ as class B¹⁷ {
//│   private val y⁵;
//│   constructor B¹⁵(y) { set B¹⁷.this.y⁵ = y; do pr¹(B¹⁷.this.y⁵); end }
//│ };
//│ return polyCtor¹()
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ > A(3)
//│ = 0

