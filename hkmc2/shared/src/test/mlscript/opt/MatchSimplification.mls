:js


:soir
if true then 1 else 0
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ match true true => 1 else 0 end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


// :dopt
:sir
:soir
let x = true in if x then 1 else 0
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let x⁰; set x⁰ = true; match x⁰ true => 1 else 0 end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ match true true => 1 else 0 end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————
//│ = 1


