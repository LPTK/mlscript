:soir
// :dopt
() =>
  let x = 1
  while x != 0 do
    print(x)
    x = 0
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let lambda²;
//│ define lambda² as fun lambda³() {
//│   let x;
//│   set x = 1;
//│   loop lbl:
