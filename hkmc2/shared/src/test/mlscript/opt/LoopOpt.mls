:soir
fun f() =
  let x = 1
  while hide(false) do
    set x = hide(2)
    return 1
  x
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f⁰;
//│ define f⁰ as fun f¹() {
//│   let scrut;
//│   set scrut = Predef⁰.hide⁰(false);
//│   match scrut
//│     true =>
//│       do Predef⁰.hide⁰(2);
//│       return 1
//│     else
//│       return 1
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————



:sir
:soir
fun f() =
  let x = 1
  if hide(false) do
    if hide(true) then
      set x = hide(2)
    else 
      set x = hide(3)
    print(1)
    return x
  return x
//│ ———————————————| Lowered IR |———————————————————————————————————————————————————————————————————————
//│ let f²;
//│ define f² as fun f³() {
//│   let x, scrut, scrut1, tmp, tmp1, tmp2;
//│   set x = 1;
//│   set scrut = Predef⁰.hide⁰(false);
//│   match scrut
//│     true =>
//│       set scrut1 = Predef⁰.hide⁰(true);
//│       match scrut1
//│         true =>
//│           set tmp = Predef⁰.hide⁰(2);
//│           set x = tmp;
//│           set tmp1 = runtime⁰.Unit⁰;
//│           end
//│         else
//│           set tmp2 = Predef⁰.hide⁰(3);
//│           set x = tmp2;
//│           set tmp1 = runtime⁰.Unit⁰;
//│           end
//│       do Predef⁰.print⁰(1);
//│       return x
//│     else
//│       return x
//│   end
//│ };
//│ end
//│ ——————————————| Optimized IR |——————————————————————————————————————————————————————————————————————
//│ let f²;
//│ define f² as fun f³() {
//│   let x, scrut, scrut1, tmp, tmp1;
//│   set x = 1;
//│   set scrut = Predef⁰.hide⁰(false);
//│   match scrut
//│     true =>
//│       set scrut1 = Predef⁰.hide⁰(true);
//│       match scrut1
//│         true =>
//│           set tmp = Predef⁰.hide⁰(2);
//│           set x = tmp;
//│           end
//│         else
//│           set tmp1 = Predef⁰.hide⁰(3);
//│           set x = tmp1;
//│           end
//│       do Predef⁰.print⁰(1);
//│       return x
//│     else
//│       return 1
//│   end
//│ };
//│ end
//│ —————————————————| Output |—————————————————————————————————————————————————————————————————————————

f()
//│ = 1


:soir
fun foo() =
  let x = 1
  if true then return ()
  x
