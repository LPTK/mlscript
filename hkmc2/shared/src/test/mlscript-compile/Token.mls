#lang(0.3.x)

import "./Predef.mls"

open Predef


class Token

module Token {
  
  data class Impl extends Token with {
    
    constructor
      SPACE
      COMMA
      PERIOD
      NEWLINE
      ERROR
      QUOTE
      LITVAL(value)
      IDENT(name: Str, symbolic: Bool)
      SELECT(name: Str, dynamic: Bool)
      // `kind` uses the lexer's bracket names, such as "parenthesis", "curly brace", or "indentation".
      // Contents are structured tokens too, so nested separators do not end the outer token sequence.
      BRACKETS(kind: Str, contents: Array[Token])
      COMMENT(text: Str)
      SUSPENSION(dotDotDot: Bool)
      ESC_IDENT(name: Str)
    
  }
  
}


