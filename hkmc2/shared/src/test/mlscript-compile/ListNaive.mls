
import "./Predef.mls"

open Predef


// * [A, B, ...C, D, ...E, F] is represented as Splice([A, B, SpliceMarker, C, D, SpliceMarker, E, F])
object SpliceMarker
class Splice(val bits)

// * A View is what we get when we match patterns of the form [x, ..xs]
class View(val underlying, val start, val end)


// * type+module overloading is not yet supported; also we don't do type checking yet;
// * but this would be the type:
// type List[A] = Array[A] | Splice(Array[A | SpliceMarker]) | View[A]

module ListNaive with...


fun mk(...args) =
  args // Arrays are valid List values


// * Linear-time operation
// (Implemented using a Splice)
// Place SpliceMarkers before all arg values
fun concat(...args) = Splice(args.flatMap (x => [SpliceMarker, x]))

fun slice(beg, end)(und) = View(und, beg, end)

fun flatten = case
  Array as a then a
  Splice(bits) then
    if bits is
      [SpliceMarker, ys, ...rest] then
        flatten(ys).concat(flatten(Splice(rest)))
      [a, ..rest] then flatten(rest).unshift(a)
      [] then []
  View(und, s, e) then flatten(und).slice(s, e)

// * Amortized O(1) operation, assuming the list is not indexed while being built
fun ith(idx) = case
  Array as a then a.[idx]
  Splice(_) as s then ith(idx)(flatten(s))
  View(und, s, e) as v then ith(idx)(flatten(v))
