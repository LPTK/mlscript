#config(noFreeze: true)

open annotations { special, specialize }

module CharSet with
  fun alphabet() = [
    "a", "b"
  ]

module SeqHelper with
  fun push(arr, ele) =
    arr.push(ele)
    arr
  fun concat(lhs, rhs) = lhs.concat(rhs)
  fun has(arr, ele) = arr.includes(ele)
  fun len(s) = s.length
  fun eq(arr1, arr2) =
    arr1.length == arr2.length and arr1.every((v, i) => v == arr2.(i))

staged module SmallExample with
  class Some(val x)
  class None

  class Cons(val x, val xs)
  class Nil

  staged class RegExp() with
    fun derive(c)
  
  staged class Empty() extends RegExp() with
    fun derive(c) = new Empty()
    fun startsWith(c) = false
  
  staged class In(val chars) extends RegExp() with
    fun derive(c) =
      if startsWith(c) then new Empty() else new In(["t"])
    fun startsWith(c) = SeqHelper.has(chars, c)
  
  staged class Concat(val p1, val p2) extends RegExp() with
    fun derive(c) =
      let p1' = p1.derive(c)
      let p2' = p2.derive(c)
      (@special new Concat(p1', p2'))
    fun startsWith(c) = p1.startsWith(c)
  
  @specialize
  fun go(email, s, i) =
    if i > 0 then
      go(email.derive(s, i), s, i - 1)
    else
      new None
  fun matchEmail(s) =
    let p = new In(SeqHelper.concat(CharSet.alphabet(), ["-", "."]))
    let email = (@special new Concat(p, @special new Concat(p, (@special new Empty()))))
    go(email, s, s.length)








