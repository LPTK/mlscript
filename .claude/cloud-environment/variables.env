# Environment variables for a Claude Code cloud environment for mlscript: paste this file
# into the environment's "Environment variables" field, and setup.sh into "Setup script".

# JVMs (sbt, Coursier, Metals, Bloop) cannot authenticate to the session's proxy, so route
# them through the local jvm-proxy-relay installed by setup.sh (the port is RELAY_PORT there).
JAVA_TOOL_OPTIONS="-Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=18080 -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=18080"

# Startup timeout (ms) for MCP servers: give the Metals server from .mcp.json time to start.
MCP_TIMEOUT=180000
