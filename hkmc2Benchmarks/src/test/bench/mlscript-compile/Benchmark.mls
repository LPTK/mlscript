import "benchmark"
// import "../../1111111"

let bm = benchmark

module Benchmark with...

val benchmark = bm
let prefixPath = "src/test/logs/"

// TODO
// fun mkSuite() = new! mut bm.Suite()

fun setPrefixPath(path) = set prefixPath = path

fun runSuite(suite) =
  let settings = { async: false }
  suite.run(settings)

fun writeResults(suite, path) =
  let jsonStr = JSON.stringify(suite.map((res, _, _) => res), null, 2)
  fs.writeFile(prefixPath + path, jsonStr, (err) => err)
